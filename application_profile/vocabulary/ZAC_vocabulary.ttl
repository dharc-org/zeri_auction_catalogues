@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix zac:   <https://w3id.org/zac/>.

# SCHEMA DEL VOCABOLARIO
zac:VocabolarioZeri a skos:ConceptScheme ;
  dct:title "Vocabolario controllato ZAC"@it ;
  dct:title "ZAC Controlled Vocabulary"@en ;
  dct:description "Vocabolario di termini specifici del dominio dei cataloghi d'asta storici (1869–1929), usati nel profilo applicativo Lots of Zeri quando non esiste un termine equivalente nel Getty AAT."@it ;
  dct:created "2026"^^xsd:gYear ;
  dct:creator <https://orcid.org/0009-0007-5385-253X>;
  dct:license <https://creativecommons.org/licenses/by/4.0/> .

# GRUPPO 1 — TIPOLOGIE DI EVENTO ASTA

zac:asta_tematica a skos:Concept ;
  skos:prefLabel "asta tematica"@it ;
  skos:prefLabel "thematic auction"@en ;
  skos:definition "Asta o mostra che comprende oggetti appartenenti a una sola categoria tipologica (es. solo dipinti antichi, oggetti d'argenteria, ecc.)."@it ;
  skos:inScheme zac:VocabolarioZeri ;
  skos:related zac:asta_mista .

zac:asta_mista a skos:Concept ;
  skos:prefLabel "asta mista"@it ;
  skos:prefLabel "mixed auction"@en ;
  skos:definition "Asta o mostra che comprende lotti di natura eterogenea, appartenenti a categorie tipologiche diverse."@it ;
  skos:inScheme zac:VocabolarioZeri ;
  skos:related zac:asta_tematica .

# GRUPPO 2 — TIPOLOGIE DI SOTTO-EVENTO ASTA

zac:battitura a skos:Concept ;
  skos:prefLabel "battitura"@it ;
  skos:prefLabel "hammer sale"@en ;
  skos:definition "Sotto-evento dell'asta in cui avviene l'aggiudicazione del singolo lotto mediante offerte al rialzo, conclusa con il colpo di martello del banditore."@it ;
  skos:inScheme zac:VocabolarioZeri ;
  skos:broader zac:sotto_evento_asta .

zac:vendita a skos:Concept ;
  skos:prefLabel "vendita"@it ;
  skos:prefLabel "sale session"@en ;
  skos:definition "Sotto-evento dell'asta corrispondente al momento della vendita di uno o più lotti."@it ;
  skos:inScheme zac:VocabolarioZeri ;
  skos:broader zac:sotto_evento_asta .

zac:assistenza a skos:Concept ;
  skos:prefLabel "assistenza"@it ;
  skos:prefLabel "assistance"@en ;
  skos:definition "Sotto-evento dell'asta in cui uno o più esperti forniscono supporto tecnico e consulenza durante lo svolgimento della vendita."@it ;
  skos:inScheme zac:VocabolarioZeri ;
  skos:broader zac:sotto_evento_asta .

zac:sotto_evento_asta a skos:Concept ;
  skos:prefLabel "sotto-evento asta"@it ;
  skos:prefLabel "auction sub-event"@en ;
  skos:definition "Categoria generica per i sotto-eventi che compongono un evento asta."@it ;
  skos:inScheme zac:VocabolarioZeri ;
  skos:narrower zac:battitura ;
  skos:narrower zac:vendita ;
  skos:narrower zac:assistenza .

# GRUPPO 3 — TIPOLOGIE DI APPROFONDIMENTO DEL CATALOGO

zac:condizioni_vendita a skos:Concept ;
  skos:prefLabel "condizioni di vendita"@it ;
  skos:prefLabel "conditions of sale"@en ;
  skos:definition "Sezione del catalogo d'asta che riporta le regole che disciplinano la partecipazione alla vendita, le modalità di pagamento e le responsabilità delle parti."@it ;
  skos:inScheme zac:VocabolarioZeri.

zac:ex_libris a skos:Concept ;
  skos:prefLabel "ex libris"@it ;
  skos:prefLabel "ex libris"@en ;
  skos:definition "Etichetta o timbro apposto su un libro o documento per indicarne il proprietario, talvolta presente come allegato o etichetta nei cataloghi d'asta."@it ;
  skos:inScheme zac:VocabolarioZeri ;
  skos:broader zac:allegato_catalogo .

zac:modulo_ordine a skos:Concept ;
  skos:prefLabel "modulo d'ordine"@it ;
  skos:prefLabel "order form"@en ;
  skos:definition "Modulo allegato al catalogo d'asta che consente a potenziali acquirenti di presentare offerte di acquisto"@it ;
  skos:inScheme zac:VocabolarioZeri ;
  skos:broader zac:allegato_catalogo .

zac:condizione_acquisto_catalogo a skos:Concept ;
  skos:prefLabel "condizione di acquisto del catalogo"@it ;
  skos:prefLabel "catalogue purchase condition"@en ;
  skos:definition "Documento allegato al catalogo che specifica le modalità e i costi per l'acquisto del catalogo stesso."@it ;
  skos:inScheme zac:VocabolarioZeri ;
  skos:broader zac:allegato_catalogo .

zac:carte_sciolte a skos:Concept ;
  skos:prefLabel "carte sciolte"@it ;
  skos:prefLabel "loose sheets"@en ;
  skos:definition "Fogli volanti allegati al catalogo d'asta, contenenti informazioni aggiuntive, errate corrige o aggiornamenti rispetto al testo principale."@it ;
  skos:inScheme zac:VocabolarioZeri ;
  skos:broader zac:allegato_catalogo .

zac:articoli_di_giornale a skos:Concept ;
  skos:prefLabel "articoli di giornale"@it ;
  skos:prefLabel "newspaper articles"@en ;
  skos:definition "Ritagli o riproduzioni di articoli di stampa allegati al catalogo d'asta, spesso relativi alla collezione in vendita o agli oggetti più rilevanti."@it ;
  skos:inScheme zac:VocabolarioZeri ;
  skos:broader zac:allegato_catalogo .

zac:allegato_catalogo a skos:Concept ;
  skos:prefLabel "allegato del catalogo"@it ;
  skos:prefLabel "catalogue attachment"@en ;
  skos:definition "Categoria generica per i documenti allegati al catalogo d'asta, distinti dal corpo principale del documento."@it ;
  skos:inScheme zac:VocabolarioZeri ;
  skos:narrower zac:ex_libris ;
  skos:narrower zac:modulo_ordine ;
  skos:narrower zac:condizione_acquisto_catalogo ;
  skos:narrower zac:carte_sciolte ;
  skos:narrower zac:articoli_di_giornale .
