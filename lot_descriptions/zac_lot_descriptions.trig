    zac:BO0624_83846_lot_6 a la:Set ;
        rdfs:label "6 - AMEUBLEMENT DE SALON en ancienne tapisserie de la MANUFACTURE ROYALE DE BEAUVAIS, de l'epoque Louis XV, compose de neuf pieces : un canape et huit fauteuils." ;
        crm:P102_has_title zac:BO0624_83846_lot_6_title ;
        crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0624_83846!BO0624_83846_000112-p.%207.jpg/full/max/0/default.jpg> ;
        crm:P1_is_identified_by zac:BO0624_83846_lot_6_id ;
        crm:P67i_is_referred_to_by zac:BO0624_83846_lot_6_description .

    zac:BO0624_83846_lot_6_description a crm:E33_Linguistic_Object ;
        rdfs:label """- 6— AMEUBLEMENT DE SALoN en ancienne tapisserie de la MANUFACTURE ROYALE DE BEAUvAIs, de lepoque Louis XV, compose de neuf pieces : un canape et huit fauteuils.\r
\r
Le canape offre, au siege et au dossier, sur un fond de paysage encadré de guirlandes et de torsades de fleurs sur contre-fond rouge, trois groupes d'animaux a sujets tires des Fables de La Fontaine. Sur le dossier, a gauche, le Loup et la Cigogne; au milieu, le Coq et la perle; a droite, le Singe et le Chat. Sur le siege, a gauche, le Renard et les raisins; au centre, le Singe et le Dauphin ; a droite, le Renard et la Cigogne.\r
\r
Chacun des fauteuils offre une disposition analogue, mais avec un seul sujet au siege et au dossier; parmi les sujets representes se voient : le Lievre et la Tortue, le Renard et le Corbeau, l'Aigle et le Hibou,etc. Belle conservation.\r
\r
Bois anciens Louis XVI, redores, a dossiers rectangulaires et partie superieure cintree, les accotoirs en forme de balustres, avec cannelures en spirales. Ils portent 1'estampille : C. J. V. M.\r
\r
Longueur du canape, I m.95. Hauteur du canape,1m.o5. Largeur de chaque fauteuil,63cent. Hauteur dechaque fauteuil,g3cent.""" ;
        crm:P2_has_type aat:300435416 .

    zac:BO0624_83846_lot_6_id a crm:E42_Identifier ;
        rdfs:label "BO0624_83846-6" .

    zac:BO0624_83846_lot_6_title rdfs:label "AMEUBLEMENT DE SALON en ancienne tapisserie de la MANUFACTURE ROYALE DE BEAUVAIS, de l'epoque Louis XV, compose de neuf pieces : un canape et huit fauteuils." .

    zac:BO0624_83846_lot_7 a la:Set ;
        rdfs:label "7 - AMEUBLEMENT DE SALON en ancienne tapisserie d'AUBUSSON du temps de Louis XVI, compose de neuf pieces :un canape et huit fauteuils." ;
