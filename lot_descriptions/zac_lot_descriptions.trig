        crm:P102_has_title zac:BO0624_15268_lot_5_title ;
        crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0624_15268!BO0624_15268_000112-p.%205.jpg/full/max/0/default.jpg> ;
