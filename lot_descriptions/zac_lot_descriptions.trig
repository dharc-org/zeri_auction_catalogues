    zac:BO0624_15268_lot_5_description a crm:E33_Linguistic_Object ;
        rdfs:label """- 5—STATuETTE sur socle adherent moulure;bronze\r
- a cire perdue. Padoue, xve siecle.\r
\r
Narcisse nu, debout aupres du tronc d'un palmier, le corps reposant sur la jambe droite, la jambe gauche repliee en arriere, retient une draperie tombant de son épaule et enroulee autour de son bras gauche; il regarde a terre et porte le poing droit sur la hanche.\r
\r
Haut.totale:30 cent.""" ;
        crm:P2_has_type aat:300435416 .

    zac:BO0624_15268_lot_5_id a crm:E42_Identifier ;
