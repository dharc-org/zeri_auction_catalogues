zac:BO0624_15271_lot_99 a la:Set ;
    rdfs:label "99 - Moderno, in Oberitalien Ende des 15.bis Anfang des 16. Jahrh. tatig. Beweinung Christi. Der aus einem ornamentierten Sarkophag emporragende Leichnam wird von Maria und Johannes gehalten. Dahinter das Kreuz. Die Darstellung ist von einem Tafelrahmen umschlossen,in dessen Giebel ein Cherub.Auf der Ruckseite angeloteter Stander. 160x98 mm.Bronze.Kusstafel (,Pax\"). Sehr schon." ;
    crm:P102_has_title zac:BO0624_15271_lot_99_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0624_15271!BO0624_15271_000101-p.%2014.jpg/full/max/0/default.jpg> ;
