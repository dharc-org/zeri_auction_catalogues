zac:BO0624_23222_lot_311 a la:Set ;
    rdfs:label "311 - Desgl, eine goldene Scheibenfibel, in ihrer Mitte ein herausgetriebener Buckel, den eine Silberkugel in Goldfiligranfassung ziert. Von ihr aus ziehen sich vier Bander kreuzformig iber den Buckel. Die Zone um den Buckel ist mit vier groBen runden Almandinen geschmickt, zwischen denen vier dunkle Steine in dreiplatte montiert,mit Nadelhalter und zwei Osen.D.4,5. Ein massivgoldenes Armband.Uber das Band lauft eine dicke Rippe,an den Enden zwei Schlangenkopfe.Gewicht 27 g.-Zwei goldene Ohrringe. An dem S-formig gebogenen Draht dicke, glatte Kugel, dariber am Draht ein kleines,rundes Plattchen.Gewicht (zusammen) 9 g.—Eine verzierte Bronze-Spatel.- Ein zweizeiliger Kamm mit doppelseitiger Verstarkung und eisernen Nieten.- Eine Perlkette.-— Messer. Abb.Tafeln5und9. Heimersheim." ;
    crm:P102_has_title zac:BO0624_23222_lot_311_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0624_23222!BO0624_23222_000121-p.%2018.jpg/full/max/0/default.jpg> ;
    crm:P1_is_identified_by zac:BO0624_23222_lot_311_id ;
    crm:P2_has_type <http://w3id.org/zac/type/oggetti_in_ferro> ;
    crm:P67i_is_referred_to_by zac:BO0624_23222_lot_311_description .

