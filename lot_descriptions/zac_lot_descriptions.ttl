zac:BO0624_1003_lot_62 a la:Set ;
    rdfs:label "62 - BERANGER (P.-J.) CEuvres completes.Edition ornee de 1o4 vignettes en taille douce. Paris. Perrotin, 1834. Musique des chansons de P. J. Beranger. Paris. Perrotin, 1838. —Ens. 6 tomes en 5 vol. in-8, port., fac-simile et 99 figures (sur 1o4), chagrin violet,fil. gras a froid, 3 fil. dor., orn. sur les plats et les dos dor. et a froid, fil int. tr. dor. (Rioage)." ;
    crm:P102_has_title zac:BO0624_1003_lot_62_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0624_1003!BO0624_1003_000221-p.%2022.jpg/full/max/0/default.jpg> ;
    crm:P1_is_identified_by zac:BO0624_1003_lot_62_id ;
    crm:P2_has_type <http://w3id.org/zac/type/editions_reliures> ;
    crm:P67i_is_referred_to_by zac:BO0624_1003_lot_62_description .

zac:BO0624_1003_lot_62_description a crm:E33_Linguistic_Object ;
    rdfs:label """62. BERANGER (P.-J.) CEuvres completes.Edition ornee de 1o4 vignettes en taille douce. Paris. Perrotin, 1834. Musique des chansons de P. J. Beranger. Paris. Perrotin, 1838. —Ens. 6 tomes en 5 vol. in-8, port., fac-simile et 99 figures (sur 1o4), chagrin violet,fil. gras a froid, 3 fil. dor., orn. sur les plats et les dos dor. et a froid, fil int. tr. dor. (Rioage).\r
\r
Bel exemplaire dans une bonne reliure romantique de Rivage.\r
\r
La suite des vignettes est sur papier de Chine, dont 4 vignettes avant la lettre. Les cinq figures suivantes ne sont pas dans cet exemplaire; ce sont: Fretillon,La Chatte,La Bonne Vieille,L'Aveugle de Bagnolet et Le Chasseur etlalaitiere.\r
\r
Le tome de musique est en demi-reliure, ornementation semblable a celle des autres volumes.""" ;
    crm:P2_has_type aat:300435416 .

