zac:83723_lot_156-157 a la:Set ;
    rdfs:label "MEUBLES.  Deux FAUTEuIs en chene sculpte, a hauts dossiers, decores de medaillons-bustes, tetes d'amours et grotesques; accotoirs cintres, pieds-balustres relies par des traverses et ceinture ornee. France, xvi siecle." ;
    crm:P102_has_title zac:83723_lot_156-157_title ;
    crm:P1_is_identified_by zac:83723_lot_156-157_id ;
