    rdfs:label "BO0624_51192-96" .

zac:BO0624_51192_lot_96_title rdfs:label "IMPORTANT BRONZE GROUP. Greek, c. IVth. century B.C. Two wrestlers, finely and powerfully modelled. A bearded man stands upright, holding by the wrist and shoulder a younger man whom he has forced to the ground. Rich green patina." .

zac:BO0624_51192_lot_97 a la:Set ;
    rdfs:label "97 - BRONZE MIROR-CASE. Vth.century B.C. With handle. On the cover is an embossed relief, representing a winged figure, seated before an incense burner, upon which with her right hand she pours incense, from a thurible or incense-box in her left hand. She wears a long chiton, and himation over the lower limbs, and her hair is tied in a knot behind her head. On the left, a winged figure of a youth, nude, proffers a bowl." ;
    crm:P102_has_title zac:BO0624_51192_lot_97_title ;
    crm:P138i_has_representation <nan> ;
    crm:P1_is_identified_by zac:BO0624_51192_lot_97_id ;
    crm:P2_has_type <http://w3id.org/zac/type/bronzi> ;
    crm:P67i_is_referred_to_by zac:BO0624_51192_lot_97_description .

zac:BO0624_51192_lot_97_description a crm:E33_Linguistic_Object ;
    rdfs:label """- 97—BRONZE MIROR-CASE.\r
\r
Ht., 7 inches. IVth.century B.C.\r
\r
With handle. On the cover is an embossed relief, representing a winged figure, seated before an incense burner, upon which with her right hand she pours incense, from a thurible or incense-box in her left hand. She wears a long chiton, and himation over the lower limbs, and her hair is tied in a knot behind her head. On the left, a winged figure of a youth, nude, proffers a bowl.""" ;
    crm:P2_has_type aat:300435416 .

