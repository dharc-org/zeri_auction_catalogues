zac:BO0624_23222_lot_302 a la:Set ;
    rdfs:label "302 - Desgl., eine groBe, bronzene Scheibenfibel mit der Anbetung der Drei Weisen. Rechts sitzt Maria, die ihr Kind auf dem SchoBe halt, beide mit Heiligenschein. Von links nahen die drei Magier, ihre Geschenke vor sich haltend. Sie tragen lange, durchgehende Gewander und hohe Mitzen. Uber ihnen schwebt nach rechts ein Engel mit ausgebreiteten Fligeln.Das Stuick ist spatromisch-byzantinischen Ursprungs. D. 58.Eine Nadel.-Ein zweizeiliger Kamm mit verstarktem Mittelstuick mit eisernen Nieten.Eine Perlkette.-Ein Messer." ;
    crm:P102_has_title zac:BO0624_23222_lot_302_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0624_23222!BO0624_23222_000112-p.%2017.jpg/full/max/0/default.jpg> ;
    crm:P1_is_identified_by zac:BO0624_23222_lot_302_id ;
    crm:P2_has_type <http://w3id.org/zac/type/oggetti_in_ferro> ;
    crm:P67i_is_referred_to_by zac:BO0624_23222_lot_302_description .

