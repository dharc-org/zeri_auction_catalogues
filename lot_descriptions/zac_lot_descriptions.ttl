zac:65735_lot_67 a la:Set ;
    rdfs:label "JOHN CONSTABLE  (East Bergholt 1776Londres 1837). Debarquement du prince d'Orange a Scheveningen en I8I3?" ;
    crm:P102_has_title zac:65735_lot_67_title ;
    crm:P1_is_identified_by zac:65735_lot_67_id ;
