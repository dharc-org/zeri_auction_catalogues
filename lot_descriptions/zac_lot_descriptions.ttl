zac:83735_lot_80 a la:Set ;
    rdfs:label "DUPRE (JULEs). La Cabane." ;
    crm:P102_has_title zac:83735_lot_80_title ;
    crm:P1_is_identified_by zac:83735_lot_80_id ;
    crm:P67i_is_referred_to_by zac:83735_lot_80_description ;
    crm:P94i_was_created_by zac:creation_83735_lot_80 .

zac:83735_lot_80_description a crm:E33_Linguistic_Object ;
    rdfs:label """80.——La Cabane.\r
\r
La plaine immense et plate qui semble porter,a l'horizon, la voute du ciel bleu ou s'envolent de larges nuees bordees de lumiere.Vers la droite,une cabane coiffee de chaume, vers laquelle s'avance une bonne femme.En avant de la cabane,deux vaches sont en train de paitre. A gauche, assez loin,un moulin dresse dansl'atmosphere sa silhouette et ses ailes ecartees.\r
\r
Signe a droite,en bas:Jules Dupre.\r
\r
Toile. Haut.,41 cent.; larg., 6o cent.\r
## FRANCAIS (FRANCOIS-LOUIS)\r
\r
(1814-1897)""" ;
    crm:P2_has_type aat:300435416 .

