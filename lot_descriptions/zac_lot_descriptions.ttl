zac:BO0624_50794_lot_119 a la:Set ;
    rdfs:label "119 - JACQUES CARRUCCI DIT PONTORMO 1493-1558,Pontormo. Madone. La Sainte Vierge est assise en robe rouge vif, la tete entouree d'une aureole, les cheveux epars couverts d''un voile blanc, tenant un livre dans la main droite.  Sur les marches d'un escalier, I' Enfant Jesus dont le petit corps potele est soutenu par sa Mere est debout et semble converser familierement avec deux anges places a gauche de la Madone.  A droite, deux autres anges-dont l'un a le pied pose sur un sac-font leurs confidences a la Vierge Mere qui prete une oreille complaisante a leurs gentils propos.  Groupe charmant ou les visages souriants sont pleins de naturel.  Bois Haut. 115 larg.95." ;
    crm:P102_has_title zac:BO0624_50794_lot_119_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0624_50794!BO0624_50794_000681-p.%2060.jpg/full/max/0/default.jpg> ;
    crm:P1_is_identified_by zac:BO0624_50794_lot_119_id ;
    crm:P67i_is_referred_to_by zac:BO0624_50794_lot_119_description ;
    crm:P94i_was_created_by zac:creation_BO0624_50794_lot_119 .

zac:BO0624_50794_lot_119_description a crm:E33_Linguistic_Object ;
    rdfs:label """## 119. Madone.\r
