    rdfs:label "1823 - 1653.Mort de lamiral Marten Harpertsz. Tromp.Medaille AU REPOUSSE," ;
    crm:P102_has_title zac:BO0624_15351_lot_1823_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0624_15351!BO0624_15351_000181-p.%2032.jpg/full/max/0/default.jpg> ;
