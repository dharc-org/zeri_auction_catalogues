zac:BO0624_51192_lot_356_description a crm:E33_Linguistic_Object ;
    rdfs:label """356 — ANDREA GUAZZA LOTTI (Andrea G. Pratense). Florence(Prato:1435-I495.\r
\r
Alfonso II of Aragon, King of Naples. (Son of Ferdinand I. Born 1448; crowned 1494; died 1495.) ALFONSUS.FERDI.DUX.CALABRIE. Portrait bust, three-quarter face; in armour, and a cap;\r
\r
long curly hair.\r
\r
Reverse :NEAPOLIS. VICTRIX. And below :OB. ITALIAM.AC.FI/DEM. RESTITUTAM.MCCCCLXXXI.\r
\r
/OP.AND.G.PRATENS.\r
\r
Alfonso II, in a triumphal car, accompanied by a numerous suite, entering a town, preceded by captive Turks.\r
\r
Diameter,25/16inches edge. No,reverse.\r
\r
(Illustrated.)\r
\r
Diameter,2 5/16inches.\r
## 357""" ;
