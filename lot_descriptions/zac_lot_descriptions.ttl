zac:BO0614_87918_lot_36_description a crm:E33_Linguistic_Object ;
    rdfs:label """## 36 Herrenbildnis.\r
\r
## \r
\r
Brustbild eines Herrn in mittleren Jahren mit dunkelblondem Haar, Schnurrbart und kurzem spitzem Vollbart in schwarzem Rocke und weifem Muhlsteinkragen, das Gesicht dem Beschauer fast voll zugewandt.\r
\r
Abbildung siehe Tafel 4.""" ;
    crm:P2_has_type aat:300435416 .

