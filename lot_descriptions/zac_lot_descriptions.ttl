zac:83725_lot_53 a la:Set ;
    rdfs:label "LE SuEuR, Eustache. 1617-1655. ENFANTS ET LAPINS." ;
    crm:P102_has_title zac:83725_lot_53_title ;
    crm:P1_is_identified_by zac:83725_lot_53_id ;
    crm:P67i_is_referred_to_by zac:83725_lot_53_description ;
    crm:P94i_was_created_by zac:creation_83725_lot_53 .

zac:83725_lot_53_description a crm:E33_Linguistic_Object ;
    rdfs:label """53.—ENFANTS ET LAPINS.\r
\r
Peinture sur toile.\r
\r
Un enfant apporteun lapin blanc et trois autres se le disputent；le premier avec une draperie rouge flottante,les trois autres nus, un d'eux couche sur cinquieme enfant court pour prendre un autrelapin\r
\r
Le Poussin a compose un sujet analogue:Les enfants jouant avec des fruits et un papillon (Vienne, collection Liechtenstein;Angleterre, comte Gros- une draperie bleue bordee d'or;a droite,un blanc; a gauche,vaste campagne.\r
\r
venor,voir Reveil,t. I,pl.51).\r
\r
Haut.om83,larg.1m.\r
## CLAUDE GELLEE dit LE LORRAIN. 1600-1682.""" ;
    crm:P2_has_type aat:300435416 .

