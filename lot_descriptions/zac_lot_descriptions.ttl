zac:BO0624_4482_lot_74_description a crm:E33_Linguistic_Object ;
    rdfs:label """Le repos en Egypte.\r
\r
La Vierge assise sur un tertre au pied d'un arbre tient son divin Fils sur ses genoux. Saint Joseph place plus en arriere attache l'ane a un tronc d'arbre. Deux anges du haut des nues presentent des fruits a 1'Enfant, qui de ses mains cherche a les atteindre. Dans le fond la campagne et des chaumieres qui completent la perspective. Toile. 1.6o X 1.20.""" ;
    crm:P2_has_type aat:300435416 .

zac:BO0624_4482_lot_74_id a crm:E42_Identifier ;
    rdfs:label "BO0624_4482-74" .

