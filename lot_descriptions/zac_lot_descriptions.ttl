zac:BO0614_87918_lot_49 a la:Set ;
    rdfs:label "49 - Schule des Rembrandt. Der barmherzige Samariter." ;
    crm:P102_has_title zac:BO0614_87918_lot_49_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0614_87918!BO0614_87918_000091-p.%2010.jpg/full/max/0/default.jpg> ;
    crm:P1_is_identified_by zac:BO0614_87918_lot_49_id ;
