zac:BO0624_51192_lot_98_description a crm:E33_Linguistic_Object ;
    rdfs:label """- 98\r
\r
Diameter,6 1/2 inches.\r
\r
## 3-SMALL BRONZE STATUETTE. Greco-E gyptian.\r
\r
A young priest, wearing a pleated tunic, and a drapery passing over his head. The right hand rests with an easy movement on the hip.\r
\r
Ht.,3 7/8 inches.\r
\r
From the Sambon collection.(Sale in Paris, 1914.)\r
\r
- 一 \r
\r
## 99\r
## — 10O""" ;
