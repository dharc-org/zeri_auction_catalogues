zac:4482_lot_19_title rdfs:label "Ecole de Rembrandt. Tete de jeune femme. Demi-buste vu de profl. Robe ouverte en coeur garnie d'une bande de fourrure et guimpe de lin. Bois. Encadrement en bois noir, avec bronze dore et cisele." .

zac:4482_lot_1_description a crm:E33_Linguistic_Object ;
    rdfs:label """Il est assis devant une table chargee de vases, d’etoffes rares et d'autres ustensiles precieux, groupes aussi par terre. Les accessoires copies scrupuleusement presentent un grand fini de details. Bois. Cadre dore. 0.49X0.39.\r
\r
##""" ;
    crm:P2_has_type aat:300435416 .

zac:4482_lot_1_id a crm:E42_Identifier ;
    rdfs:label "BO0624_4482-1" .

zac:4482_lot_1_title rdfs:label "ECOLE ALLEMANDE. Dietrich (Chr. Guill. Ernest) - 1712-1774 (attribue a). Avare et la Mort. Il est assis devant une table chargee de vases, d’etoffes rares et d'autres ustensiles precieux, groupes aussi par terre. Les accessoires copies scrupuleusement presentent un grand fini de details. Bois. Cadre dore. 0.49X0.39." .

zac:4482_lot_2 a la:Set ;
    rdfs:label "ECOLE ALLEMANDE.  Durer Albert—1471-1528. Adam et Eve. Au paradis terrestre. Ils sont representes entoures de quelques animaux de la creation. Eve presente a Adam le fruit defendu que lui offre le serpent enroule autour de l'arbre du bien et du mal. Ce tableau a ete reproduit par la gravure executee par le maitre meme de 1497 a 1529. Bois. Beau cadre dore. 1.45X1.10.",
        "l'ange Raphael." ;
    crm:P102_has_title zac:4482_lot_2_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/76882709-1df1-4208-ba26-556bb373ceba/full/full/0/default.jpg>,
        <https://historica.unibo.it/iiif-server/e6314b7b-13c7-42c5-ae15-040478565fff/full/full/0/default.jpg> ;
    crm:P1_is_identified_by zac:4482_lot_2_id ;
    crm:P67i_is_referred_to_by zac:4482_lot_2_description .

zac:4482_lot_20 a la:Set ;
    rdfs:label "Rubens Pierre-Paul - 1577-1640. La Musique. Figure de femme aux formes opulentes, aux chairs rosees et grassouillettes et aux joues vermillonnees. Elle a les yeux leves au ciel, comme en extase. Son costume est fait de brocart rouge et de satin blanc, dont les plis etoffes presentent des tonalites eclatantes. Le bras droit est appuye a une table; dans une main elle tient un cahier de musique; dans l'autre,un luth et l'archet. Pres d'elle on voit un violon et de la musique. Toile. Cadre dore et sculpte. 1.32X1.03." ;
    crm:P102_has_title zac:4482_lot_20_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/d517a1a0-ca55-45c0-b1c7-bba8cfb90233/full/full/0/default.jpg> ;
    crm:P1_is_identified_by zac:4482_lot_20_id ;
    crm:P67i_is_referred_to_by zac:4482_lot_20_description .

