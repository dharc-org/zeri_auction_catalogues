zac:6334_lot_98_description a crm:E33_Linguistic_Object ;
    rdfs:label """98.La Vergine con Gesu bambino,attorniati da\r
- diversi Santi.\r
\r
Tela.-Cornice dorata.-Altezza 0,61X0,38.\r
\r
La Vierge assise sous un baldaquin, tenant l'Enfant Jesus sur ses genoux; autour,trois Saintes et quatre Saints; dans le haut, des anges voltigeant autour du baldaquin.\r
\r
##""" ;
    crm:P2_has_type aat:300435416 .

