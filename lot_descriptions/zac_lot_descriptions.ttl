zac:BO0624_81812_lot_77 a la:Set ;
    rdfs:label "77 - Rigaud Giacinto. Sec. XVIll. Ritratto di gentiluomo in parruccone. Tela di sommo pregio, di affascinante insuperabile bellezza: Morbide, delicate le carni,vere le stoffe: Le mani disegnate a perfezione, l'espressione dignitosa del personaggio e resa con ammirevole verita. Cornice legno scolpito e dorato. Alt.cm.130,larg. cm.102." ;
    crm:P102_has_title zac:BO0624_81812_lot_77_title ;
