zac:BO0624_50794_lot_67 a la:Set ;
    rdfs:label "67 - ECOLE FRANCAISE  XVlllme siecle. Allegorie de la Science. Portrait de jeune femme assise, presque de profil s'appuyant mol- lement sur la main gauche.  Vetue d'un elegant manteau de velours rouge laissant a decouvert les epaules et la poitrine, les cheveux bruns releves en une legere torsade de laquelle s'échappe une boucle brune qui vient retomber sur l'épaule droite.La main droite tient une baguette a lextremite de laquelle est enroule un serpent,le coude repose sur une table ou l'on voit: un livre, une tete de mort et un parchemin.  Une draperie sombre et un rameau de feuillages forment le fond du tableau. Toile Haut. 138 larg. 100." ;
    crm:P102_has_title zac:BO0624_50794_lot_67_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0624_50794!BO0624_50794_000402-p.%2037.jpg/full/max/0/default.jpg> ;
    crm:P1_is_identified_by zac:BO0624_50794_lot_67_id ;
    crm:P67i_is_referred_to_by zac:BO0624_50794_lot_67_description ;
    crm:P94i_was_created_by zac:creation_BO0624_50794_lot_67 .

