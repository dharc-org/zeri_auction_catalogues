    crm:P2_has_type <http://w3id.org/zac/type/placchette> ;
    crm:P67i_is_referred_to_by zac:BO0624_15271_lot_173_description .

zac:BO0624_15271_lot_173_description a crm:E33_Linguistic_Object ;
    rdfs:label """- 173 Anbetung der Hirten. In der Mitte sitzt Maria mit gefalteten Handen, das Kind auf dem Schosse.Sie ist von drei Hirten umgeben.Der hinter ihr stehende Josef blickt uiber sie zum Kinde. Von links und rechts treten zwei Frauen mit Gefassen auf den Kopfen hinzu. Kalb,Esel und Hund beleben die Gruppe.\r
- Unediert? Rund. 65 mm. Bronze vergoldet. Vorzuglich erh.\r
\r
Tafel XIx.\r
\r
Die fuinf vorstehenden Stucke sind wohl nurnbergische oder augsburgische Arbeiten aus der Mitte des 16. Jahrhunderts.\r
\r
##""" ;
    crm:P2_has_type aat:300435416 .

