zac:BO0624_15271_lot_92_title rdfs:label "Lautizio de Perugia (?)  tatig in Perugia u. Rom. Siegel des Kardinals Giulio de Medici (Papst Clemens V11.,Kardinal 15131523). In der Mitte einer Gruppe von Heiligen kniet Maria vor dem Kinde; rechts Petrus, links Paulus, in der Mitte Laurentius,Den Grund fullt ein Tempel, jiber dem Gottvater. Unter der Szene halten zwei Engel den Kardinalshut ibel dem Mediciwappen. Bode 668. Mol. 675. Oval. 105X69 mm. Bronze. Vorzuglich. Tafel XII." .

zac:BO0624_15271_lot_93 a la:Set ;
    rdfs:label "93 - Lautizio de Perugia (?)  tatig in Perugia u. Rom. Reiterschlaeht. Vor einer turmreichen Stadt eine in heftigem Handgemenge befindliche Reiterschlacht.Die aus einem Stadttore ausgebrochenen Belagerten werden von den von links ansturmenden Feinden bedrangt. B. 703 var. Mol. 236. 131x96 mm. Bronze. Helle Patina. Vorziglich." ;
    crm:P102_has_title zac:BO0624_15271_lot_93_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0624_15271!BO0624_15271_000101-p.%2014.jpg/full/max/0/default.jpg> ;
    crm:P1_is_identified_by zac:BO0624_15271_lot_93_id ;
    crm:P67i_is_referred_to_by zac:BO0624_15271_lot_93_description ;
    crm:P94i_was_created_by zac:creation_BO0624_15271_lot_93 .

zac:BO0624_15271_lot_93_description a crm:E33_Linguistic_Object ;
    rdfs:label """- 93 131x96 mm. Bronze. Helle Patina. Vorziglich.\r
\r
## Tafel XxIII.\r
\r
- Allegorie der Baumkultur. Ein stehender Knabe hat den l. Fuss auf einen kauernden Satyr gesetzt. Er halt mit der Rechten einen Baum, der vom Hauch des Windgottes niedergebeugt ist und an dessen Stamm ein Flugelpaar wachst. Rechts vom Knaben eine Kanne und ein Baumchen, woran ein Gefass befestigt ist.\r
- Bode 71.Mol.244. Sambon 88.48mm.Bronze.Schon.\r
\r
Tafel III.\r
\r
##""" ;
    crm:P2_has_type aat:300435416 .

zac:BO0624_15271_lot_93_id a crm:E42_Identifier ;
    rdfs:label "BO0624_15271-93" .

