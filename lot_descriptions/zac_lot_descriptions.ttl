    rdfs:label "Velddaalder,teatoile et auroissant,losange,portant deuxinscripins en majuscules, gravees a lepoque sur les bords de la piece, les coins etant ornes de fleurons graves:" ;
    crm:P102_has_title zac:15351_lot_1551_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/213b023c-a543-404d-ae39-13567eb10557/full/full/0/default.jpg> ;
