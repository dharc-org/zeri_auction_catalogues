zac:BO0614_87918_lot_20_description a crm:E33_Linguistic_Object ;
    rdfs:label """## 20 Stilleben.\r
\r
Auf einem Piedestal die Bezeichnung: Ao. 159o Dor. F.Francken.\r
\r
Auf Leinwand. Hohe 82,5 cm,Breite 67.5 cm.In Goldrahmen.\r
\r
## \r
\r
Eine Auerhenne und ein Singvogelchen liegen tot im Vordergrunde einer Landschaft am Boden. Auf Leinwand. Hohe 38 cm,Breite 44 cm.In Goldrahmen.""" ;
    crm:P2_has_type aat:300435416 .

