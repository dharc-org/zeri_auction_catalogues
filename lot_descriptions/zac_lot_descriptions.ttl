zac:BO0624_23222_lot_315 a la:Set ;
    rdfs:label "315 - Desgl., eine goldene Scheibenfibel, die Oberseite in AuBenzone und Mittelfeld geteilt.Das Mittelfeld stellt sich als ein groBer, getriebener Buckel dar,umrahmt von einem goldenen Perlband,an dem nach dem Buckel Die AuBenzone zieren vier vierteilige Almandinauflagen, abwechselnd mit zwei Almandinen und zwei grunen Steinen in viereckiger Fassung. Das Feld ist ganz mit verschlungenen Filigranmustern bedeckt. Die Unterhalbkugelig und gerippt, die Oberseite flach, in der Mitte blauer Stein in runder Fassung, darum vier kleine ebenso gefaBte Perlen,getrennt jedesmal durch kleine Goldkorner.Eine bronzene Schnalle ohne Dorn. Zwei Bronzeringe mit je vier bronzenen Plattchen mit Niete.-- Zwei Bronzeringe.Kleine Bronzefibel Minden b.Trier. Abb.Tafel 5." ;
    crm:P102_has_title zac:BO0624_23222_lot_315_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0624_23222!BO0624_23222_000122-p.%2019.jpg/full/max/0/default.jpg> ;
