    rdfs:label """3—— Petit portrait de jeune Fille.\r
\r
Cadre sculpte et dore Louis XVI.\r
\r
LOUTERBOURG (P.-J.DE)\r
\r
Scene pastorale.\r
\r
Gravure de forme ronde, avant ia lettre,par Bar- tolozzi.\r
\r
## NETSCHER\r
\r
(Ecole de)\r
\r
Petit portrait d'Homme.\r
\r
Panneau.\r
\r
## VERNET\r
\r
(D'apres CARLE)\r
\r
Cosaque irregulier portant des depeches.\r
\r
Cadre en bois sculpte Louis XVI.\r
## ECOLE FRANCAISE\r
\r
## Deux Peintures decoratives dans le\r
\r
## goit de Watteau.\r
\r
Encadrement de baguettes len bois sculpte Louis XV.\r
\r
## ECOLE FRANCAISE\r
\r
—L'Architecture. 8\r
\r
Peinture decorative. Trumeau.\r
\r
## ECOLE FRANCAISE\r
\r
- Portrait de Femme du temps de Louis""" ;
    crm:P2_has_type aat:300435416 .

