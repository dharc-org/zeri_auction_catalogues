    rdfs:label "REDIG. Un Canal en Hollande." ;
    crm:P102_has_title zac:83734_lot_58_title ;
    crm:P1_is_identified_by zac:83734_lot_58_id ;
    crm:P67i_is_referred_to_by zac:83734_lot_58_description ;
