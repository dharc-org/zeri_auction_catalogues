    rdfs:label "ECOLE FRANCAISE. Portrait de femme." ;
    crm:P102_has_title zac:83735_lot_53_title ;
    crm:P1_is_identified_by zac:83735_lot_53_id ;
    crm:P67i_is_referred_to_by zac:83735_lot_53_description .

zac:83735_lot_53_description a crm:E33_Linguistic_Object ;
    rdfs:label """53.—Portrait de femme.\r
\r
Elle est en costume de deuil, voile de crepe, corsage noir a festons de batiste blanche. Elle est vue de trois quarts a gauche,la bouche souriante,les yeux doux et humides. Son corsage est decollete.\r
\r
Panneau.Haut.,34 cent.;larg.,27 cent.\r
\r
(Collection Guierche.)\r
## ECOLE FRANCAISE""" ;
