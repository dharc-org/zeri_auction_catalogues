zac:BO0624_4482_lot_66 a la:Set ;
    rdfs:label "66 - Pippi Jules, dit Jules Romain —1492-1546. Venus Amphitrite. La deesse est debout sur une coquille. guidant deux dauphins. Une draperie fottante,d'une teinte rosee,retenue sur le bras droit lui ceint les reins laissant le torse a decouvert. Elle tient a la main un roseau,embleme des ondes. Le nu de cette figure presente une grace et une verite d'execution qui joints a un coloris charmant constituent un tableau digne d'attention.Toile. 0.98X1.45." ;
    crm:P102_has_title zac:BO0624_4482_lot_66_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0624_4482!BO0624_4482_000391-p.%2014.jpg/full/max/0/default.jpg> ;
