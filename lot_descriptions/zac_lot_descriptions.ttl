zac:BO0624_50794_lot_57 a la:Set ;
    rdfs:label "57 - BONIFAZIO VENITIEN 1500-1562, Venize. La Sainte Cene. Au centre du tableau; une table recouverte d'une nappe blanche au haut de quelques marches. Saint Pierre, a genoux, recoit la Sainte Communion des mains du Sauveur. A droite et a gauche; des apotres et des disciples. Sous la table un en fant lave les pieds du Christ. Une foule nombreuse a l'entree d'un temple place dans le haut du tableau vers la droite. Plus loin au centre: un attelage de boeufs tirant la charrue; des chevaux et des cavaliers.  Collines boisees dans le fond.  Toile Haut. 95 larg. 64." ;
    crm:P102_has_title zac:BO0624_50794_lot_57_title ;
    crm:P138i_has_representation <nan> ;
    crm:P1_is_identified_by zac:BO0624_50794_lot_57_id ;
    crm:P67i_is_referred_to_by zac:BO0624_50794_lot_57_description ;
    crm:P94i_was_created_by zac:creation_BO0624_50794_lot_57 .

