zac:BO0624_81816_lot_12_description a crm:E33_Linguistic_Object ;
    rdfs:label """12. Barbieri Francesco detto il Guercino. 1591-1666. Mezza figura di giovinetta. Magnifica, vigorosa pittura su tavola. Cor-\r
- S. Domenico. La Vergine apparisce a S. Domenico facendogli vedere la sua immagine con laureola di Santo. Un Angiolo del coro delle Virtu sostiene limmagine e aromi. S. Domenico in ginocchio esprime alla Vergine la e di buonissimo colorito. Cornice a tabernacolo in stile del XVI secolo. Alt. o,39 larg. o,28.\r
- nice scolpita e dorata. Alt. o,45 larg. 0,32. Vedi Tavola N. 1.\r
- Pittura su tela entro cornice dorata. Alt. o,5o larg. 0,35.""" ;
    crm:P2_has_type aat:300435416 .

zac:BO0624_81816_lot_12_id a crm:E42_Identifier ;
