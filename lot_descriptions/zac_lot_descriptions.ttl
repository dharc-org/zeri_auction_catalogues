    rdfs:label "AGOSTINO DA LODI Ecole lombarde: fin'du XVe siecle-commencement du XVIe.Portrait de jeune homme." ;
    crm:P102_has_title zac:65735_lot_24_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/99c89473-7e2d-4abf-8cf4-d744a55b97e4/full/full/0/default.jpg> ;
    crm:P1_is_identified_by zac:65735_lot_24_id ;
