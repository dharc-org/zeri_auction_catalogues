zac:BO0624_15271_lot_121 a la:Set ;
    rdfs:label "121 - Unbestimmte venezianische Meister. Der heil. Antonius von Padua ? Der vor einer Halle von vorne stehende Heilige im Monchsgewande tragt in der Rechten das Kreuz Christi. Mit der Linken rafft er sein Gewand,in dem er Blumen tragt.Neben ihm steht ein Putto,der mit beiden Handchen einen Kranz emporhalt. Im Grunde Kirchengebaude. B.—. Mol.. 103x72 mm.Bronze.Altvergoldetes,vorzugliches Exemplar." ;
    crm:P102_has_title zac:BO0624_15271_lot_121_title ;
