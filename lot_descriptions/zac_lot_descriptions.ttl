zac:44631_lot_30 a la:Set ;
    rdfs:label "ViTRaIL rond en couleurs,representant le Christ mis en croix. Les bourreaux sont occupes a percer les trous et a fixer le Seigneur sur la croix posee a terre. Un personnage, debout au premier plan,contemple la scene.Fond bleute,avec paysage.Bordure jauned'oravec inscriptionlatineen lettresgothiques: ost Alanas :colaphos:post risus:ostqu : Blagella.Tn cruce Suffixum corpus distenditur omne. Allemagne. xvie siecle." ;
    crm:P102_has_title zac:44631_lot_30_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/3eec6b77-5311-4c40-b986-b73769f42788/full/full/0/default.jpg> ;
    crm:P1_is_identified_by zac:44631_lot_30_id ;
    crm:P2_has_type <http://w3id.org/zac/type/vetri> ;
    crm:P67i_is_referred_to_by zac:44631_lot_30_description .

zac:44631_lot_30_description a crm:E33_Linguistic_Object ;
    rdfs:label """3o—VirRaIL rond en couleurs,representant le Christ mis en croix. Les bourreaux sont occupes a percer les trous et a fixer le Seigneur sur la croix posee a terre. Un personnage, debout au premier plan,contemple la scene.Fond bleute,avec paysage.Bordure jauned'oravec inscriptionlatineen lettresgothiques: ost Alanas :colaphos:post risus:ostqu : Blagella.Tn cruce Suffixum corpus distenditur omne. Allemagne. xvie siecle.\r
\r
Diam.,32 cent.\r
\r
Ce sujet est execute d’apres la gravure sur bois de la\r
\r
Petite Passion, d’Albert Durer, de 15og a 1511(B.39).\r
\r
Collection Burki;vente a Bale,1882,n°58.""" ;
    crm:P2_has_type aat:300435416 .

