zac:5739_lot_1 a la:Set ;
    rdfs:label "FLOWERPIECE A bouquet of fowers in a gilt chased vase standing on a grey stone slab. There are tulips, roses, pinks, gardenias, and other fowers.  On canvas:height,26 inches;width,19%4 inches. ## RACHEL RUYSCH  Born at Amsterdam 1664.Wife of the portrait painter, Jurian Pool. Died at Amsterdam 1750." ;
    crm:P102_has_title zac:5739_lot_1_title ;
    crm:P1_is_identified_by zac:5739_lot_1_id ;
    crm:P67i_is_referred_to_by zac:5739_lot_1_description ;
    crm:P94i_was_created_by zac:creation_5739_lot_1 .

zac:5739_lot_10 a la:Set ;
    rdfs:label "JACOBDUCK  Born at Utrecht about 1605.Died after 1660. LOVE AND BACKGAMMON A cavalier, seated at the right, is playing backgammon with a young woman, seated at the left; she is just making a play. Behind the table an old woman sits smoking and looking at the game.  On wood:Height,13 inches;width,11/2 inches." ;
    crm:P102_has_title zac:5739_lot_10_title ;
    crm:P1_is_identified_by zac:5739_lot_10_id ;
    crm:P67i_is_referred_to_by zac:5739_lot_10_description ;
    crm:P94i_was_created_by zac:creation_5739_lot_10 .

zac:5739_lot_10_description a crm:E33_Linguistic_Object ;
    rdfs:label """## IO-LOVE AND BACKGAMMON\r
\r
A cavalier, seated at the right, is playing backgammon with a young woman, seated at the left; she is just making a play. Behind the table an old woman sits smoking and looking at the game.\r
\r
On wood:Height,13 inches;width,11/2 inches.\r
##""" ;
    crm:P2_has_type aat:300435416 .

zac:5739_lot_10_id a crm:E42_Identifier ;
    rdfs:label "BO0624_5739-10" .

