zac:83725_lot_99 a la:Set ;
    rdfs:label "VELDE, Willem van de, le jeune. 1633-1707. MER PRES D'UN PORT." ;
    crm:P102_has_title zac:83725_lot_99_title ;
    crm:P1_is_identified_by zac:83725_lot_99_id ;
    crm:P67i_is_referred_to_by zac:83725_lot_99_description ;
    crm:P94i_was_created_by zac:creation_83725_lot_99 .

zac:83725_lot_99_description a crm:E33_Linguistic_Object ;
    rdfs:label """99.—MER PRES D'UN PORT.\r
\r
Peinture sur toile, signee a droite : W.v. V.\r
\r
Pres d'une estacade sur laquelle sont deux personnages entre deux chaloupes,une barque est en train d'appareiller avec deux pecheurs,une troisieme chaloupe amene deux passagers,plus loin un trois-mats et d'autres embarcations.\r
\r
Haut. o4o, larg.om32.\r
\r
(1) Certains font mourir Johann Beerstraaten en 1666;d'apres M.Havard,il srait mort en1687,aes un long sejour a Rome.\r
## VELDE (Willem van de) le jeune 1633-1707.""" ;
    crm:P2_has_type aat:300435416 .

zac:83725_lot_99_id a crm:E42_Identifier ;
    rdfs:label "BO0624_83725-99" .

