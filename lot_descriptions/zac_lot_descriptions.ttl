    rdfs:label "Aelbert Cuyp (geb. zu Dortrecht 1605, gest. daselbst 1620).Die Gilde." ;
    crm:P102_has_title zac:87918_lot_13_title ;
    crm:P1_is_identified_by zac:87918_lot_13_id ;
