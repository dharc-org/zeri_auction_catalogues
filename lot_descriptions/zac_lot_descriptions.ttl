zac:83725_lot_70 a la:Set ;
    rdfs:label "ALDEGRAEVER, Heinrich. 1502-1562. LA RESURRECTION DU CHRIST." ;
    crm:P102_has_title zac:83725_lot_70_title ;
    crm:P1_is_identified_by zac:83725_lot_70_id ;
    crm:P67i_is_referred_to_by zac:83725_lot_70_description ;
    crm:P94i_was_created_by zac:creation_83725_lot_70 .

zac:83725_lot_70_description a crm:E33_Linguistic_Object ;
    rdfs:label """70. —— LA RESURRECTION DU CHRIST.\r
\r
Peinture sur bois.\r
\r
Le Christ, le corps demi-vetu, tenant un etendard dans la main gauche, sort du tombeau dans des roches;a droite un soldat encore endormi,a gauche un autre qui s'eveille et du geste indique qu'il est touche de la foi; au fond, d'autres person- nages traites en caricatures.\r
\r
Haut.om65, larg. om40.\r
\r
## ELSHEIMER, Adam. 1578-1620.""" ;
    crm:P2_has_type aat:300435416 .

