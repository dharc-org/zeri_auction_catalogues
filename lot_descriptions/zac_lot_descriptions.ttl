zac:BO0624_4671_lot_28 a la:Set ;
    rdfs:label "28 - GRANDE COUVERTURE brodee en soie. Le fond en point de Hongrie, couleur orange. Au centre un medaillon representant Ceres,encadre de bouquets de feurs. Aux quatre coins et au milieu de chaque cote des grandes gerbes de feurs. La bordure ornee d'oiseaux, de feurs et des fruits, avec frange en soie rouge et jaune. A l'exception du medaillon du milieu et des oiseaux sur la bordure qui sont bis. TAPISsERIE de Bruxelles tissee de laine et soie representant une ville avec riche decoration architectonique de cariatides et fontaines, ayant de trois cotes une belle bordure a feuillages, ornements varies et petites figures.XVIme siecle." ;
    crm:P102_has_title zac:BO0624_4671_lot_28_title ;
    crm:P138i_has_representation <nan> ;
    crm:P1_is_identified_by zac:BO0624_4671_lot_28_id ;
    crm:P67i_is_referred_to_by zac:BO0624_4671_lot_28_description ;
    crm:P94i_was_created_by zac:creation_BO0624_4671_lot_28 .

