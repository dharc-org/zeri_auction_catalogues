    rdfs:label "BiLLARD, frise et pieds en acajou incruste." ;
    crm:P102_has_title zac:4670_lot_271_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/6b35b172-1eee-4dd4-a4c7-1217583617ce/full/full/0/default.jpg> ;
