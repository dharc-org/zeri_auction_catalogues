zac:BO0624_23222_lot_306 a la:Set ;
    rdfs:label "306 - Desgl., eine goldene Scheibenfibel, auf der Oberseite kreuzformige Erhohung herausgetrieben, in deren Mittel punkt ein runder, blauer Stein gefaBt ist. An diesen schlieBen sich nach den Kreuzarmen hin kleine dreieckige Fassungen mit rotlichen Steinen. Die Ende der Arme sind mit je einem dunklen Stein geschmickt. Die vier vertieften Felder sind wie der Rand mit verschlungenen Filigranmustern bedeckt. Die Unterseite besteht aus einer Bronzeplatte.D.4,7.- Zwei Vogel aus Bronze mit Kettchen verbunden.—Zwei silberne Ohrringe mit Kugeln und zwei seitlichen Radchen als Anhangsel.Ein bronzener Fingerring mit Stein. Eine Guirtelschnalle.-Ein Schlussel aus Bronze,— Ein bronzener Ring. - Ein zweizeiliger Kamm mit Strichverzierung auf der Verstarkung. — Eine Perlkette. - Zwei bronzene Riemenzungen. — Ein Messer. Ochtendung. Abb. Tafel8." ;
    crm:P102_has_title zac:BO0624_23222_lot_306_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0624_23222!BO0624_23222_000112-p.%2017.jpg/full/max/0/default.jpg> ;
    crm:P1_is_identified_by zac:BO0624_23222_lot_306_id ;
    crm:P2_has_type <http://w3id.org/zac/type/oggetti_in_ferro> ;
    crm:P67i_is_referred_to_by zac:BO0624_23222_lot_306_description .

