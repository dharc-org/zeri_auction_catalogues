zac:83738_lot_209-210 a la:Set ;
    rdfs:label "DEUx coFFREs DE MARIAGE en bois sculpte,avec incrustations" ;
    crm:P102_has_title zac:83738_lot_209-210_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/0a0fa2a8-b94d-434c-a8d2-b67214292df8/full/full/0/default.jpg> ;
