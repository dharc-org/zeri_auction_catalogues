zac:83735_lot_94 a la:Set ;
    rdfs:label "Baron. 1816-1885. L'Effroi." ;
    crm:P102_has_title zac:83735_lot_94_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/6af561a2-e318-4461-a3b5-7e0849cd30c5/full/full/0/default.jpg> ;
