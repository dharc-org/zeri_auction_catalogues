zac:BO0624_4482_lot_27_description a crm:E33_Linguistic_Object ;
    rdfs:label """27. Triptyque.\r
\r
En forme de tabernacle et a volets se fermant. Le panneau de gauche nons montre l'Annonciation; celui central:1'Adoration des bergers; celui de droite; le Repos en Egypte. Bois. 1.08 X 1.38 ouvert — o.6o ferme.""" ;
    crm:P2_has_type aat:300435416 .

zac:BO0624_4482_lot_27_id a crm:E42_Identifier ;
    rdfs:label "BO0624_4482-27" .

