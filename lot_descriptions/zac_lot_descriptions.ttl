zac:BO0624_4482_lot_28 a la:Set ;
    rdfs:label "28 - Ecole de Bruges - XV siecle.  L'Adoration. La Vierge vetue d'une robe blanche et d'un long manteau Saint Joseph. Des anges agenouillés sont en adoration devant le Sauveur; d'autres chantent ses louanges. Dans le fond on vert est agenouillee devant l'Enfant.Derriere elle on voit apercoit un sentier et les bergers qui se rendent a la Creche. Bois avec parties dorees. Cadre en noyer. 0.46 X 0.62." ;
    crm:P102_has_title zac:BO0624_4482_lot_28_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0624_4482!BO0624_4482_000352-p.%207.jpg/full/max/0/default.jpg> ;
