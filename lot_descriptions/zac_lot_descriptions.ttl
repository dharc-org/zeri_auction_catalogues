zac:BO0624_50794_lot_135_description a crm:E33_Linguistic_Object ;
    rdfs:label """## 135. Portrait de Napoleon.\r
\r
Revetu d'un justaucorps blanc, tunique bleue sombre; couvert de decorations, la main droite passee dans l'entrebaillement de la tunique.\r
\r
Ce tableau est remarquable, car c'est le seul portrait connu de Toile Haut. 76 larg. 61.\r
\r
Napoleon revetu de cet uniforme.\r
\r
##""" ;
    crm:P2_has_type aat:300435416 .

zac:BO0624_50794_lot_135_id a crm:E42_Identifier ;
    rdfs:label "BO0624_50794-135" .

zac:BO0624_50794_lot_135_title rdfs:label "MAiTRE FRANCAIS XIXme siecle. Portrait de Napoleon. Revetu d'un justaucorps blanc, tunique bleue sombre; couvert de decorations, la main droite passee dans l'entrebaillement de la tunique.  Ce tableau est remarquable, car c'est le seul portrait connu de Toile Haut. 76 larg. 61.  Napoleon revetu de cet uniforme." .

zac:BO0624_50794_lot_136 a la:Set ;
    rdfs:label "136 - G.FITEL 1809. Portrait de Dame. Elle est assise dans un fauteuil en robe de soie noire Empire; un manteau rouge est jete negligemment sur le dossier. De beaux cheveux noirs, soigneusement releves au sommet de la tete,laissent echapper quelques boucles qui retombent sur le front. La tete fine est encadree d'un col genre Marie Stuart ouvert en pointe sur le devant du corsage;un collier a double rangee de perles orne le cou de la jeune femme. La main droite, tenant une plume, s'appuie sur un carton pose sur une table.  montagneux.  Une fenetre ouverte dans le fond, decouvre un coin de paysage Toile Haut. 120 larg. 84." ;
    crm:P102_has_title zac:BO0624_50794_lot_136_title ;
    crm:P138i_has_representation <nan> ;
    crm:P1_is_identified_by zac:BO0624_50794_lot_136_id ;
    crm:P67i_is_referred_to_by zac:BO0624_50794_lot_136_description ;
    crm:P94i_was_created_by zac:creation_BO0624_50794_lot_136 .

