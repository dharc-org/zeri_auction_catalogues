zac:BO0624_4482_lot_1 a la:Set ;
    rdfs:label "1 - ECOLE ALLEMANDE. Dietrich (Chr. Guill. Ernest) - 1712-1774 (attribue a). Avare et la Mort. Il est assis devant une table chargee de vases, d’etoffes rares et d'autres ustensiles precieux, groupes aussi par terre. Les accessoires copies scrupuleusement presentent un grand fini de details. Bois. Cadre dore. 0.49X0.39." ;
    crm:P102_has_title zac:BO0624_4482_lot_1_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0624_4482!BO0624_4482_000322-p.%20%5B1%5D.jpg/full/max/0/default.jpg> ;
    crm:P1_is_identified_by zac:BO0624_4482_lot_1_id ;
    crm:P67i_is_referred_to_by zac:BO0624_4482_lot_1_description ;
    crm:P94i_was_created_by zac:creation_BO0624_4482_lot_1 .

