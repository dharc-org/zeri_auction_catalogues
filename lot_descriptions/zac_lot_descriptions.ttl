zac:BO0624_15368_lot_314_description a crm:E33_Linguistic_Object ;
    rdfs:label """- 314 Anbetung der hl. drei Konige. Im Stall sitzt nach rechts gewendet Maria mit dem Kinde, vor ihm kniet der alteste Konig, die beiden anderen treten heran.\r
\r
Wiederholung einer Komposition aus den Quadrins historiques de la Bible von Bernhard Salomon (erste Ausgabe von 1553).\r
\r
Bronze. Vergoldet. Original.\r
\r
Drei Bohrlocher. Eine Ecke fehlt.\r
\r
Braun 81.\r
\r
H.61.-B.36.\r
\r
Bange 1518.\r
\r
Tafel 28\r
\r
- Bronze.Alterer Guf.-Dm.80. Braun 83.""" ;
