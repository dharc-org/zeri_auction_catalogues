zac:6334_lot_17 a la:Set ;
    rdfs:label "BASAITI MARCO  del Friuli-1520. San Girolamo nel deserto;dipinto firmato:Busaitti." ;
    crm:P102_has_title zac:6334_lot_17_title ;
    crm:P1_is_identified_by zac:6334_lot_17_id ;
    crm:P67i_is_referred_to_by zac:6334_lot_17_description ;
    crm:P94i_was_created_by zac:creation_6334_lot_17 .

zac:6334_lot_17_description a crm:E33_Linguistic_Object ;
    rdfs:label """17.San Girolamo nel deserto;dipinto firmato:Bu-\r
- saitti.\r
\r
Tavola.-Cornice dorata.-Al ezza m.0,59X68. Tav.Ix del Catalogo.\r
\r
St Gerome dans le desert;peinture signee:Basaitti.\r
\r
Dans un paysage arbore et plein de rochers, St Jerome est assis a droite pres d'un petit lac,a moitie nu,lisaat un livre pose sur ses genoux;devant lui,un lion accroupi. Sur un caillou place derriere leSainton litlenom de l'artiste Basaitti.\r
\r
Hors des musees de Venise,on trouve rarement des tableaux de cet auteur.\r
\r
- Bergamo.\r
##""" ;
    crm:P2_has_type aat:300435416 .

zac:6334_lot_17_id a crm:E42_Identifier ;
    rdfs:label "BO0624_6334-17" .

zac:6334_lot_17_title rdfs:label "BASAITI MARCO  del Friuli-1520. San Girolamo nel deserto;dipinto firmato:Busaitti." .

zac:6334_lot_18 a la:Set ;
    rdfs:label "PENNI GIANFRANCESCO  detto il PASTORE.  Firenze-1488(?)-1528. Madonna col Bambino e San Giovanni;allato, monogramma." ;
    crm:P102_has_title zac:6334_lot_18_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/dc080525-2c23-4810-a7be-a61da4aa038d/full/full/0/default.jpg> ;
    crm:P1_is_identified_by zac:6334_lot_18_id ;
    crm:P67i_is_referred_to_by zac:6334_lot_18_description ;
    crm:P94i_was_created_by zac:creation_6334_lot_18 .

zac:6334_lot_18_description a crm:E33_Linguistic_Object ;
    rdfs:label """18. Madonna col Bambino e San Giovanni;allato, monogramma.\r
\r
Tavola.-Cornice dorata.-Altezza m.0,73X0,53\r
\r
Tav.X del Catalogo.\r
\r
- La Madone est assise dans un paysage montueux et arbore; elle tient entre ses genoux l Enfant Jesus debout qui regarde le petit St Jean,aussi debout,et vers lequel la Vierge sincline pour lembrasser. Dans le fond du paysage on voit des cavaliers et des paysans qui descendent de la montagne.Dans le champ,a droite,est un monogramme que personne n'a pu dechiffrer;il est compose d'un grand T avec un  a la droite formant P; en dessous du O, deux petites ailes.Les attributions diverses donnees a cette splendide peinture convergent toujours vers lé-\r
- cole de Raphael.-M.Silvestri.\r
\r
##""" ;
    crm:P2_has_type aat:300435416 .

