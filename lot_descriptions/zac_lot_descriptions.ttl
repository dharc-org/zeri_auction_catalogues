    rdfs:label """- 48.L'ADORATION DES BERGERs. La Vierge et Saint Joseph a droite,les berger a gauche adorent leDivin Enfant;dans le fond trois anges agenouilles chantentl' Hosanna.Fond de paysage,bel effet de lumiere et tres bon\r
coloris. Beau cadre en bois dore, decore d'oves,d'une grecque, d'olives et de raies de coeur sculptees.\r
\r
Bois,haut.M,o.22 Xo.29.\r
\r
Voir illustration,planche 5.\r
\r
## \r
\r
##""" ;
    crm:P2_has_type aat:300435416 .

