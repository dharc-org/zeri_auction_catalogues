zac:BO0624_44452_lot_298 a la:Set ;
    rdfs:label "298 - Achteckige Dose mit reichen Gravirnngen und vergoldet, darauf sichtbar eine Uhr und daneben die bewegliche Unruh, zwischen beiden oben eine fein geschnittene Elfenbeinplatte mit Einfassung. Auf der Ruckseite werden durch ein Uhrwerk verschiedene Figuren aus Silber, Angler, Holzhacker, Bergmann, Wassermihle etc. in Bewegung gesetzt, als Staffage eine Burg auf Felsen u. Baumen aus Elfenbein auf schwarzem Grund. Franzosische Arbeit. Louis XVI. Grosse 91/2:6 im Etuis." ;
    crm:P102_has_title zac:BO0624_44452_lot_298_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0624_44452!BO0624_44452_000162-p.%2025.jpg/full/max/0/default.jpg> ;
