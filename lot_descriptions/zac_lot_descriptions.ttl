zac:23222_lot_285 a la:Set ;
    rdfs:label "Desgl.,eine kleine Verroterie-Scheibenfibel auf silberner Unterlage, der Rand in Wellenlinie. Auf der Zierseite umschlieBt eine AuBenzone von radial gestelten Almandinstickchen ein silbernes Mittelfeld mit drei halbkreisformigen Verzierungen. D. 2. -Zwei silberne Ohrringe.-Eine bronzene Zierscheibe,reich durchbrochen, im Mittelfeld kreuzformig geteilt mit Voluten an den Kreuzenden, die AuBenzone mit dem gleichen Volutenornament. D.4,7.-Kleine bronzene Gurtelschnalle, auf dem Ansatz ausgeschnittenes,unterlegtes Kreuz,auBerdem drei Nieten.Eine kleine, bronzene Schnalle mit zwei Beschlagstickchen, mit kleinen Mustern punziert.—Eine bronzene Riemenzunge. — Drei bronzene Knopfe. —Drei Sandalenschnallchen. Ein Hornstilus mit verziertem Kopf.-Eine Perlkette.-Ein Messer.Ein Spinnwirtel. Karlich." ;
    crm:P102_has_title zac:23222_lot_285_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/36093473-b2df-4e7d-8061-ebad07878428/full/full/0/default.jpg> ;
    crm:P1_is_identified_by zac:23222_lot_285_id ;
    crm:P2_has_type <http://w3id.org/zac/type/oggetti_in_ferro> ;
    crm:P67i_is_referred_to_by zac:23222_lot_285_description .

