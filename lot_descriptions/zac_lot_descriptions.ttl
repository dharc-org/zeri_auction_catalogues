zac:BO0624_4482_lot_18 a la:Set ;
    rdfs:label "18 - Metzys dit 《Maréchal d’Anvers》—1450-1529. La meditation de Saint Jerome. Le Pere de l'Eglise est dans son cabinet assis devant une table chargee de livres, de manuscrits et d'autres ustensiles. L'index de la main gauche pose sur un crane place devant lui. Dans le fond, un paysage ou 1'on voit le saint Anachorete en priere devant un crucifix. Bois. Cadre dore." ;
    crm:P102_has_title zac:BO0624_4482_lot_18_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0624_4482!BO0624_4482_000341-p.%204.jpg/full/max/0/default.jpg> ;
