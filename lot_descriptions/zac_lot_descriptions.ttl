zac:83730_lot_52 a la:Set ;
    rdfs:label "PRUD'HON, P.P. L'Industrie." ;
    crm:P102_has_title zac:83730_lot_52_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/878a0582-f407-4449-aad4-ad16a9abd959/full/full/0/default.jpg> ;
    crm:P1_is_identified_by zac:83730_lot_52_id ;
    crm:P67i_is_referred_to_by zac:83730_lot_52_description ;
    crm:P94i_was_created_by zac:creation_83730_lot_52 .

zac:83730_lot_52_description a crm:E33_Linguistic_Object ;
    rdfs:label """52 —L'Industrie.\r
\r
Elle est personnifee par une femme debout, en pied et drapee,une flamme au front, la tete appuyee sur la main gauche qui tient un compas, la main droite posee sur un caducee.\r
\r
Composition pour la decoration de l'Hotel de Ville de Paris, lors du mariage de Napoleon Ier avec l'imperatrice Marie-Louise.\r
\r
Cette decoration avait ete executee en grand, peinte a l'essence, et vue le soir eclairee par derriere avec des lampes.\r
\r
Dessin au crayon noir, rehausse de blanc sur pa- pier gris.\r
\r
Cadre en bois sculpte.\r
\r
Haut.,34 cent.;larg.,23 cent,\r
\r
(Vente Marcille.)\r
\r
## SAINT-AUBIN, GABRIEL DE.""" ;
    crm:P2_has_type aat:300435416 .

zac:83730_lot_52_id a crm:E42_Identifier ;
    rdfs:label "BO0624_83730-52" .

