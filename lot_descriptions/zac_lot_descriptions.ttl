zac:15271_lot_173 a la:Set ;
    rdfs:label "Siddeutsche Plaketten,2. Halfte des 16. Jahrhunderts. Anbetung der Hirten. In der Mitte sitzt Maria mit gefalteten Handen, das Kind auf dem Schosse.Sie ist von drei Hirten umgeben.Der hinter ihr stehende Josef blickt uiber sie zum Kinde. Von links und rechts treten zwei Frauen mit Gefassen auf den Kopfen hinzu. Kalb,Esel und Hund beleben die Gruppe." ;
    crm:P102_has_title zac:15271_lot_173_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/7b1414d1-6d68-4ff4-9466-4728ea6bd673/full/full/0/default.jpg> ;
