zac:44452_lot_107 a la:Set ;
    rdfs:label "Kannchen mit Henkel und Ausguss. Der kantige Korper von allen Seiten mit reich eingeschliffenen und polirten Ornamenten und Krone. Auch der Henkel und Ausguss ist reich ornamentirt und polirt. Sehr interessantes Stuick von eleganter Form in der feinsten Ausfuhrung aus der braunen harten Masse von Bottcher angefertigt. Ausguss ein wenig restaurirt und Deckel wahrscheinlich nicht dazu gehorig. Ganze Hohe 16 cm." ;
    crm:P102_has_title zac:44452_lot_107_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/0c998c74-9b00-4f5f-b51a-99ac0d267e5e/full/full/0/default.jpg> ;
