zac:65729_lot_25 a la:Set ;
    rdfs:label "C.TROYON (suite). LE PATURAGE NORMAND" ;
    crm:P102_has_title zac:65729_lot_25_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/611fda05-dfdf-42ca-b78c-29b0181b7405/full/full/0/default.jpg> ;
    crm:P1_is_identified_by zac:65729_lot_25_id ;
