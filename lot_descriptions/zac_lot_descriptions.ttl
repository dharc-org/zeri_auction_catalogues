zac:23222_lot_302 a la:Set ;
    rdfs:label "Desgl., eine groBe, bronzene Scheibenfibel mit der Anbetung der Drei Weisen. Rechts sitzt Maria, die ihr Kind auf dem SchoBe halt, beide mit Heiligenschein. Von links nahen die drei Magier, ihre Geschenke vor sich haltend. Sie tragen lange, durchgehende Gewander und hohe Mitzen. Uber ihnen schwebt nach rechts ein Engel mit ausgebreiteten Fligeln.Das Stuick ist spatromisch-byzantinischen Ursprungs. D. 58.Eine Nadel.-Ein zweizeiliger Kamm mit verstarktem Mittelstuick mit eisernen Nieten.Eine Perlkette.-Ein Messer." ;
    crm:P102_has_title zac:23222_lot_302_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/1b4577c1-1d56-428c-b587-5737732005ab/full/full/0/default.jpg> ;
    crm:P1_is_identified_by zac:23222_lot_302_id ;
    crm:P2_has_type <http://w3id.org/zac/type/oggetti_in_ferro> ;
    crm:P67i_is_referred_to_by zac:23222_lot_302_description .

zac:23222_lot_302_description a crm:E33_Linguistic_Object ;
    rdfs:label """- 302 Desgl., eine groBe, bronzene Scheibenfibel mit der Anbetung der Drei Weisen. Rechts sitzt Maria, die ihr Kind auf dem SchoBe halt, beide mit Heiligenschein. Von links nahen die drei Magier, ihre Geschenke vor sich haltend. Sie tragen lange, durchgehende Gewander und hohe Mitzen. Uber ihnen schwebt nach rechts ein Engel mit ausgebreiteten Fligeln.Das Stuick ist spatromisch-byzantinischen Ursprungs. D. 58.Eine Nadel.-Ein zweizeiliger Kamm mit verstarktem Mittelstuick mit eisernen Nieten.Eine Perlkette.-Ein Messer.\r
\r
Minden bei Trier.\r
\r
Abb. Tafel6.""" ;
    crm:P2_has_type aat:300435416 .

