    rdfs:label "Alida Withoos (Tochter des bekannten Stillebenmalers Mathias Withoos, 17. Jahrhundert). Stilleben." ;
    crm:P102_has_title zac:87918_lot_80_title ;
    crm:P1_is_identified_by zac:87918_lot_80_id ;
