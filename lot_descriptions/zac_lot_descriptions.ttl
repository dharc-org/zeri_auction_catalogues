zac:BO0624_4399_lot_67 a la:Set ;
    rdfs:label "67 - G.L.BERNINI. L'ADORATION DE L'ENFANT JESUS.La Vierge au centre et un ange de chaque cote, sont agenouilles et adorent l'Enfant Jesus couché sur un petit banc recouvert de paille.Une gloire de tetes de seraphins entoure le nimbe de la Vierge et en haut des anges jettent des fleurs a pleines mains." ;
    crm:P102_has_title zac:BO0624_4399_lot_67_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0624_4399!BO0624_4399_000102-p.%2015.jpg/full/max/0/default.jpg> ;
    crm:P1_is_identified_by zac:BO0624_4399_lot_67_id ;
    crm:P67i_is_referred_to_by zac:BO0624_4399_lot_67_description .

zac:BO0624_4399_lot_67_description a crm:E33_Linguistic_Object ;
    rdfs:label """- 67.L'ADORATION DE L'ENFANT JESUS.La Vierge au centre et un ange de chaque cote, sont agenouilles et adorent l'Enfant Jesus couché sur un petit banc recouvert de paille.Une gloire de tetes de seraphins entoure le nimbe de la Vierge et en haut des anges jettent des fleurs a pleines mains.\r
\r
Admirable travail en haut-relief signe: 《BERNINI&gt;,et c'est sans aucun doute un de ses premiers ouvrages, car on y voit clairement qu'il subit encore l'infuence des maitres du 15oo. Terre cuite ronde. Cadre en bois noir et ornements dores.\r
\r
Diam.M.o.70.\r
\r
M.4.70X2.85.""" ;
    crm:P2_has_type aat:300435416 .

