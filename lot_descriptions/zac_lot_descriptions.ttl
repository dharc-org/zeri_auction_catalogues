    rdfs:label "GRANDE COLLECTION DE MEDAILLES SE RAPPORTANT AUX ORIENTALES.1826-1897." ;
    crm:P102_has_title zac:15351_lot_1873_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/283c0d39-fc1f-409c-a276-b934af299b9f/full/full/0/default.jpg> ;
