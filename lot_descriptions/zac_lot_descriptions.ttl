zac:5830_lot_59 a la:Set ;
    rdfs:label "?VELASQUEZ  Seville:1599-1660  Biblical scene, before the porch of a church.  On the extreme left, a figure whose head is that of the celebrated Aesop (Prado,Madrid).  The master's unrivalled greys and pinks appear admirably in the costume and cloak of the principal figure, on the left of the picture. In the background, a head is broadly indicated in truly masterly style.  Canvas.Ht.,50 inches.W.,39 1/2 inches.  From the collection of Marczell von Nemes, formerly in Buda-Pesth. (Illustrated.)" ;
    crm:P102_has_title zac:5830_lot_59_title ;
    crm:P1_is_identified_by zac:5830_lot_59_id ;
    crm:P67i_is_referred_to_by zac:5830_lot_59_description ;
    crm:P94i_was_created_by zac:creation_5830_lot_59 .

zac:5830_lot_59_description a crm:E33_Linguistic_Object ;
    rdfs:label """I3th.century\r
## ?VELASQUEZ\r
\r
Seville:1599-1660\r
\r
Biblical scene, before the porch of a church.\r
\r
On the extreme left, a figure whose head is that of the celebrated Aesop (Prado,Madrid).\r
\r
The master's unrivalled greys and pinks appear admirably in the costume and cloak of the principal figure, on the left of the picture. In the background, a head is broadly indicated in truly masterly style.\r
\r
Canvas.Ht.,50 inches.W.,39 1/2 inches.\r
\r
From the collection of Marczell von Nemes, formerly in Buda-Pesth. (Illustrated.)\r
## \r
\r
\r
## \r
## \r
##""" ;
    crm:P2_has_type aat:300435416 .

