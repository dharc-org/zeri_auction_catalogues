zac:15271_lot_89 a la:Set ;
    rdfs:label "Niccolo Spinelli (?) gen. Niccolo Fiorentino. In Florenz und Frankreich tatig, gest.1499.Christus am Kreuze zwischen Maria und Johannes.Zu den Seiten des Kruzifixes stehen l. Maria die Hande ringend und emporblickend,r.der trauernde Johannes geneigten Hauptes die Hand vor die Brust legend. Zu Fissen des Kreuzes Schadel und zwei Knochen.Auf dem kornigen Grunde vertieft:Sonne und Mond. Die Darstellung umschliesst eine tabernakelartige Umrahmung, die von Muschelund Blattmotiven angefuilltist.In der Giebellunette Gottvater segnend zwischen zwei Cherubim.Im Abschnitt:SANCTUSYSALVATORoMONDIo· Auf der Ruckseite ein mit Blattwerk geschmickter Griff. Variante zu Bode 652 und Mol. 433.108x55 mm.Bronze.Kusstafel. Hervorragend schones Exemplar dieses hochstseltenen florentinischen Meisterwerks." ;
    crm:P102_has_title zac:15271_lot_89_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/7b2c2006-0ba8-48bd-9338-4bb302caac60/full/full/0/default.jpg> ;
    crm:P1_is_identified_by zac:15271_lot_89_id ;
    crm:P67i_is_referred_to_by zac:15271_lot_89_description ;
    crm:P94i_was_created_by zac:creation_15271_lot_89 .

zac:15271_lot_89_description a crm:E33_Linguistic_Object ;
    rdfs:label """- 89 Christus am Kreuze zwischen Maria und Johannes.Zu den Seiten des Kruzifixes stehen l. Maria die Hande ringend und emporblickend,r.der trauernde Johannes geneigten Hauptes die Hand vor die Brust legend. Zu Fissen des Kreuzes Schadel und zwei Knochen.Auf dem kornigen Grunde vertieft:Sonne und Mond. Die Darstellung umschliesst eine tabernakelartige Umrahmung, die von Muschelund Blattmotiven angefuilltist.In der Giebellunette Gottvater segnend zwischen zwei Cherubim.Im Abschnitt:SANCTUSYSALVATORoMONDIo· Auf der Ruckseite ein mit Blattwerk geschmickter Griff. Variante zu Bode 652 und Mol. 433.108x55 mm.Bronze.Kusstafel. Hervorragend schones Exemplar dieses hochstseltenen florentinischen Meisterwerks.\r
\r
Tafel XI.\r
\r
## Paduanische Schule.\r
\r
##""" ;
    crm:P2_has_type aat:300435416 .

