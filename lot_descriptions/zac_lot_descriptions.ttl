    rdfs:label "61 - VERMEER DE DELFT. Portrait d’une Dame de qualite." ;
    crm:P102_has_title zac:BO0624_83724_lot_61_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0624_83724!BO0624_83724_000321-p.%2030.jpg/full/max/0/default.jpg> ;
