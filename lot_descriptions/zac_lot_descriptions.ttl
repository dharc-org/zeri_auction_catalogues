zac:BO0624_50014_lot_26 a la:Set ;
    rdfs:label "26 - Cabinet de salon italien en écaille a deux corps, le devant du corps s superieur avec un battant en portique, accoste de six colonnettes, dans la niche une statuette en cuivre dore, le battant accoste de cinq tiroirs munis de cuivre de chaque coté. En ouvrant le battant on voit une case fermee par un battant aussi en portique, dans la niche une statuette en bronze accoste de deux colonnettes en écaille et surmonté d'une colonnade en cuivre. Cette case est surmontée et accostee de 16 petits tiroirs. Le corps inferieur en bois noirci a six pieds en forme de colonnes. Haut. 1.66, larg. 1.26, prof. 0.57 M. Beau meuble, époque Louis XIII.  Voirla reproduction." ;
    crm:P102_has_title zac:BO0624_50014_lot_26_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0624_50014!BO0624_50014_000061-p.%204.jpg/full/max/0/default.jpg> ;
    crm:P1_is_identified_by zac:BO0624_50014_lot_26_id ;
    crm:P67i_is_referred_to_by zac:BO0624_50014_lot_26_description .

