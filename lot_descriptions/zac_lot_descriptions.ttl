    rdfs:label "53 - Otho Marcellis van Schrieck (geb.zu Nymwegen 1619 oder 1620, gest.zu Amsterdam 1678). Tierstick." ;
    crm:P102_has_title zac:BO0614_87918_lot_53_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0614_87918!BO0614_87918_000092-p.%2011.jpg/full/max/0/default.jpg> ;
