zac:51192_lot_151 a la:Set ;
    rdfs:label "WOODEN RELIEF. Lombardy, beginning of 16th.century. Representing the legend of Adonis. In the centre, the birth of Adonis : a hooded figure removes him from the body of his mother,Myrrha,metamorphosed into a tree;dryads look on. To the right, Venus is seated by the side of Adonis, who is richly dressed in armour, and holds an arrow. From the air, Cupid takes aim at the pair. On the left, the God Mars, in a fury of jealousy, enters sword in hand, and a dryad flees at the sight of him.  From the Rodolphe Kann collection;illustrated in the cata- logue(1907: Tome I; No.34) and described by Dr. Bode." ;
    crm:P102_has_title zac:51192_lot_151_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/4b90cb73-e848-4651-9cbc-b047bdfd8b87/full/full/0/default.jpg> ;
    crm:P1_is_identified_by zac:51192_lot_151_id ;
    crm:P67i_is_referred_to_by zac:51192_lot_151_description ;
    crm:P94i_was_created_by zac:creation_51192_lot_151 .

