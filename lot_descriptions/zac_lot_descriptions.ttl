zac:BO0624_15271_lot_113 a la:Set ;
    rdfs:label "113 - Unbestimmte Oberitaliener,  Ende des 15. und Anfang des 16. Jahrhunderts. Enthauptung des Paulus.Vor einer dichtgedrangten Gruppe,die von vier Reitern, einer Anzahl Fusssoldaten und einer Frau mit einem Kinde gebildet wird,ist der Henker im Begriffe den knieenden gefesselten Paulus zu enthaupten. Den Grund fullt ein Theaterbau und ein Triumphbogen. Predellenartig;unten Darstellung einer Kampfszene zwischen Reitern und Fusssoldaten. B.1005. Mol. 625. 112x71 mm. Bronze. Sehr schones Exemplar dieser seltenen Plakette." ;
    crm:P102_has_title zac:BO0624_15271_lot_113_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0624_15271!BO0624_15271_000111-p.%2016.jpg/full/max/0/default.jpg> ;
