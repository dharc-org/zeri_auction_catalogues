    rdfs:label "JEAN-HONORE FRAGONARD  (Grasse 1732-Paris 1806). St:Pierre libere." ;
    crm:P102_has_title zac:65735_lot_40_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/998f49a9-362b-48e9-9cc6-2c6dcd202c07/full/full/0/default.jpg> ;
