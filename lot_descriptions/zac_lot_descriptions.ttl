    rdfs:label "Hendrik Corneliszen Vroom (geb. zu Haarlem 1566, gest. daselbst 1640). Marine." ;
    crm:P102_has_title zac:87918_lot_79_title ;
    crm:P1_is_identified_by zac:87918_lot_79_id ;
