zac:23222_lot_322 a la:Set ;
    rdfs:label "Desgl.,ein goldener Ring, der Reif an den Enden in zwei gewundene Drahte ibergehend, die,in Voluten ausgehend, den in ovaler, hoher Fassung sitzenden Stein tragen. D.2,1. Gewicht.5 g.-Eine kleine, getriebene, silberne Scheibenfibel, die Oberseite kreuzformig geteilt,in den vier Feldern ein sich wiederholendes Beschlagstickchen, alle Teile versilbert und mit punzierten Kreis- und Strichreihen verziert.- Zwei silberne Ohrringe.-Ein verzierter Bronze-Stilus.-Ein Kamm,zweizeilig mit doppelter Verstarkung, mit Strichverzierung.-Eine Perlkette.-—Ein Hackmesser.——Ein Messer. Mulhofen. Abb. Tafel 5." ;
    crm:P102_has_title zac:23222_lot_322_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/8af0bb6f-efe2-468f-8018-051a9520c1c0/full/full/0/default.jpg> ;
