    crm:P67i_is_referred_to_by zac:BO0624_23222_lot_315_description .

zac:BO0624_23222_lot_315_description a crm:E33_Linguistic_Object ;
    rdfs:label "- 315 Desgl., eine goldene Scheibenfibel, die Oberseite in AuBenzone und Mittelfeld geteilt.Das Mittelfeld stellt sich als ein groBer, getriebener Buckel dar,umrahmt von einem goldenen Perlband,an dem nach dem Buckel Die AuBenzone zieren vier vierteilige Almandinauflagen, abwechselnd mit zwei Almandinen und zwei grunen Steinen in viereckiger Fassung. Das Feld ist ganz mit verschlungenen Filigranmustern bedeckt. Die Unterhalbkugelig und gerippt, die Oberseite flach, in der Mitte blauer Stein in runder Fassung, darum vier kleine ebenso gefaBte Perlen,getrennt jedesmal durch kleine Goldkorner.Eine bronzene Schnalle ohne Dorn. Zwei Bronzeringe mit je vier bronzenen Plattchen mit Niete.-- Zwei Bronzeringe.Kleine Bronzefibel Minden b.Trier. Abb.Tafel 5." ;
    crm:P2_has_type aat:300435416 .

zac:BO0624_23222_lot_315_id a crm:E42_Identifier ;
    rdfs:label "BO0624_23222-315" .

zac:BO0624_23222_lot_315_title rdfs:label "Desgl., eine goldene Scheibenfibel, die Oberseite in AuBenzone und Mittelfeld geteilt.Das Mittelfeld stellt sich als ein groBer, getriebener Buckel dar,umrahmt von einem goldenen Perlband,an dem nach dem Buckel Die AuBenzone zieren vier vierteilige Almandinauflagen, abwechselnd mit zwei Almandinen und zwei grunen Steinen in viereckiger Fassung. Das Feld ist ganz mit verschlungenen Filigranmustern bedeckt. Die Unterhalbkugelig und gerippt, die Oberseite flach, in der Mitte blauer Stein in runder Fassung, darum vier kleine ebenso gefaBte Perlen,getrennt jedesmal durch kleine Goldkorner.Eine bronzene Schnalle ohne Dorn. Zwei Bronzeringe mit je vier bronzenen Plattchen mit Niete.-- Zwei Bronzeringe.Kleine Bronzefibel Minden b.Trier. Abb.Tafel 5." .

zac:BO0624_23222_lot_316 a la:Set ;
    rdfs:label "316 - Desgl.,eine goldene Scheibenfibel auf Bronzeunterlage.In der Mitte der Scheibe sitzt auf flachem, getriebenem Buckel ein griner Halbedelstein. In dem mit Filigran bedeckten Felde um das Mittelstick vier drei eckige Fassungen mit Steinfillung,abwechselnd mit viermal je zwei hintereinanderstehenden,runden Fassungen, die inneren vier mit Almandinen, die auBeren mit Perlmuttereinlagen.Den Rand bilden zwei dicke, gewundene Drahte. D.5,1.-Ein bronzenes Armband mit Rillen verziert.—Eine quadratische, durchbrochene, bronzene Zierscheibe,punziert,ein dunnes, getriebenes Bronzeblech (sehr beschadigt） als Unterlage.L.5,4.Z Zwei Ohrringe, sehr beschadigt -Eine bronzene Schnalle.—Ein Bronzering.—Bronzene, punzierte Beschlagstickchen.-Bruchstick einer reich geschnittenen Hornscheibe.—Eine Perlkette.-Ein Messer, Minden b. Trier. Abb.Tafel5." ;
    crm:P102_has_title zac:BO0624_23222_lot_316_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0624_23222!BO0624_23222_000122-p.%2019.jpg/full/max/0/default.jpg> ;
    crm:P1_is_identified_by zac:BO0624_23222_lot_316_id ;
    crm:P2_has_type <http://w3id.org/zac/type/oggetti_in_ferro> ;
    crm:P67i_is_referred_to_by zac:BO0624_23222_lot_316_description .

