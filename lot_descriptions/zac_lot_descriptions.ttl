zac:15268_lot_10 a la:Set ;
    rdfs:label "TROIS PETITS GROUPES d'enfants en bronze patine. Padoue, commencement du xvie siecle." ;
    crm:P102_has_title zac:15268_lot_10_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/6d57ef94-f8b4-49fa-853d-a9e73b35d49f/full/full/0/default.jpg> ;
