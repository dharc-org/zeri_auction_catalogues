zac:23222_lot_323 a la:Set ;
    rdfs:label "Desgl., eine goldene Scheibenfibel, doppelwandig, innen hohl. In der Mitte der Oberseite quadratische Erhohung herausgetrieben,von getriebenen Punktreihen umrahmt. Hierauf sitzt eine ebenfalls quadratische Fassung mit weiBem Stein. Diese mittlere Erhohung ist von acht abwechelnd quadratischen und langlich runden ebenfalls herausgetriebenen Erhohungen umgeben, die in hoher Fassung, in der Form ihnen angepaBte Almandine und graue Halbedelsteine tragen. Zwischen den Erhohungen feine Filigranverzierungen. Den Rand bildet ein dicker, gewundener Draht. Unterseite Gold mit goldener Nadel und Nadelhalter. D.6. Gewicht 50 g.-Zwei silberne Ohrringe.—Ein bronzenes Armband.—Zwei bronzene Fingerringe.—Eine Karlich. Abb.Tafeln5und8." ;
    crm:P102_has_title zac:23222_lot_323_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/8af0bb6f-efe2-468f-8018-051a9520c1c0/full/full/0/default.jpg> ;
    crm:P1_is_identified_by zac:23222_lot_323_id ;
    crm:P2_has_type <http://w3id.org/zac/type/oggetti_in_ferro> ;
    crm:P67i_is_referred_to_by zac:23222_lot_323_description .

