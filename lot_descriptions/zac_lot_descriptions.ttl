zac:50794_lot_16_description a crm:E33_Linguistic_Object ;
    rdfs:label """## 16. Saint Francois de Sales.\r
\r
Vetu d'une aube recouverte d'une pelerine rouge. Une croix et une chaine ornent sa poitrine.\r
\r
Un livre ouvert est pose sur une table,la main gauche est appuyee sur les feuillets du livre; la main droite tient une plume.\r
\r
Toile Haut. 36 larg. 26.\r
\r
##""" ;
    crm:P2_has_type aat:300435416 .

zac:50794_lot_16_id a crm:E42_Identifier ;
