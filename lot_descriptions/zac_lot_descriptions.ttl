zac:23222_lot_277 a la:Set ;
    rdfs:label "Desgl, eine bronzene Scheibenfibel, in der Mitte Buckel, ganz ibersat mit kleinen, punzierten Augen\", bronzener Stilus mit geripptem Knopf.—# Zwei silberne Ohrringe. 一 Ein Bronzering, schmal, oben runde Patte, eingefaBt beiderseits von drei kleinen Buckeln, mit Spuren von Vergoldung.- Eine bronzene Gurtel schnalle, das Dornende mit Querrippen.—Eine bronzene Guirtelschnalle mit Ansatzstick, das mit drei Reihen kleiner Buckel verziert ist.- Eine Sandalenschnalle mit verziertem Ansatz.— Ein Stick Bronzeplatte mit punzierten Ringen.-Eine Perlkette mit Glas- und Tonperlen.—— Eine Schere, Eisen.Ein Messer, Eisen. Minden b.Trier." ;
    crm:P102_has_title zac:23222_lot_277_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/57fc9938-2dfb-4979-80c5-0dcc3e6352d6/full/full/0/default.jpg> ;
