zac:83757_lot_15 a la:Set ;
    rdfs:label "LAWRENCE, Sir Th. Portrait de Miss Anna Byron, fille de lord" ;
    crm:P102_has_title zac:83757_lot_15_title ;
    crm:P1_is_identified_by zac:83757_lot_15_id ;
    crm:P67i_is_referred_to_by zac:83757_lot_15_description ;
    crm:P94i_was_created_by zac:creation_83757_lot_15 .

zac:83757_lot_15_description a crm:E33_Linguistic_Object ;
    rdfs:label """## 15 一 Portrait de Miss Anna Byron, fille de lord\r
\r
## Byron.\r
\r
L'enfant est assise sur un fauteuil. Elle ecoute de ses deux yeux grands ouverts une histoire quon lui conte pour lui faire trouver moins longues les minutes de pose. Elle est coiffee d'un bonnet de dentelle qui met de la blancheur autour de sa face rose. Sa robe blanche est decolletee et ses deux mains fermees, ses bras ronds ployes disent assez l'interet qu'elle prend au recit du conteur. La figure se dessine en blanc sur un fond grenat.\r
\r
Dessin aux delicates et fines colorations.\r
\r
Toile.Haut.,53 cent.; larg.,45 cent.\r
## LEPICIE (Attribue a Nicolas-Bernard)""" ;
    crm:P2_has_type aat:300435416 .

zac:83757_lot_15_id a crm:E42_Identifier ;
    rdfs:label "BO0624_83757-15" .

zac:83757_lot_15_title rdfs:label "LAWRENCE, Sir Th. Portrait de Miss Anna Byron, fille de lord" .

zac:83757_lot_16 a la:Set ;
