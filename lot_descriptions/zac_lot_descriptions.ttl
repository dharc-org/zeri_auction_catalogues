zac:BO0624_15350_lot_101 a la:Set ;
    rdfs:label "101 - LouiS XII. LVDOVIC XII. FRANCORV. REX. MEDIOLANI. Dvx. Buste a gauche coiffe du mortier. R. vIcTor. TRIvMPHAToR. SEMPER. AvGvsTvs. Porc-épic marchant a gauche sous une couronne royale; au-dessous, trois tours (T.n.,Iv, 2.—Armand, 11,139, 6).Le trou de suspension a éte rebouche. — OR. Poids, 26 gr. 8o. Diam.," ;
    crm:P102_has_title zac:BO0624_15350_lot_101_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0624_15350!BO0624_15350_000172-p.%2029.jpg/full/max/0/default.jpg> ;
    crm:P1_is_identified_by zac:BO0624_15350_lot_101_id ;
    crm:P67i_is_referred_to_by zac:BO0624_15350_lot_101_description ;
    crm:P94i_was_created_by zac:creation_BO0624_15350_lot_101 .

zac:BO0624_15350_lot_101_description a crm:E33_Linguistic_Object ;
    rdfs:label """- 101 —LouiS XII.LVDOVIC XII. FRANCORV. REX. MEDIOLANI. Dvx. Buste a gauche coiffe du mortier. R. vIcTor. TRIvMPHAToR. SEMPER. AvGvsTvs. Porc-épic marchant a gauche sous une couronne royale; au-dessous, trois tours (T.n.,Iv, 2.—Armand, 11,139, 6).Le trou de suspension a éte rebouche. — OR. Poids, 26 gr. 8o. Diam.,\r
\r
PlancheVI.\r
\r
Cette medaille, d'un art puissant qui ne le cede en rien aux euvres des plus grands maitres italiens,est due au sculpteur Michel Colomb tailleur d'ymaiges duroy notre sire , comme il s'intitule lui-meme. Elle fut frappee a Tours, en 1499, par lorfevre Jean Chapillon, et offerte au roi a l'occasion de son entrée dans cette ville.\r
\r
Il existe au Cabinet de France un exemplaire semblable a celui que nous decrivons ici et nous croyons que ces deux medailles sont les seules connues en or (Voir Dauban;Revue Numismatique,1856,p.13o.— Mazerolle,26).""" ;
    crm:P2_has_type aat:300435416 .

