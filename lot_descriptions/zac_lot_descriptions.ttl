zac:83725_lot_68 a la:Set ;
    rdfs:label "HOLBEIN, Hans, le Jeune. 1497-1543.PORTRAIT D'HOMME." ;
    crm:P102_has_title zac:83725_lot_68_title ;
    crm:P1_is_identified_by zac:83725_lot_68_id ;
    crm:P67i_is_referred_to_by zac:83725_lot_68_description ;
    crm:P94i_was_created_by zac:creation_83725_lot_68 .

zac:83725_lot_68_description a crm:E33_Linguistic_Object ;
    rdfs:label """68.—PORTRAIT D'HOMME. Peinture sur bois.\r
\r
De trois quarts a gauche,avec une coiffure noire sur une chevelure blonde,vetu de noir avec une sorte de gilet rouge;a gauche, sur la manche,armoiries.Dans le fond du tableau,en chiffres arabes,\r
\r
AN.D.1520.ALT38.\r
\r
Pendant du suivant, euvre de jeunesse du maitre.\r
\r
Haut.om39,larg.om31.\r
\r
## HOLBEIN, Hans, le Jeune. 1497-1543.""" ;
    crm:P2_has_type aat:300435416 .

