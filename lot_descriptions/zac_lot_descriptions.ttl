zac:BO0624_50794_lot_59 a la:Set ;
    rdfs:label "59 - HENRI VAN BALEN 1632,Anvers. Madone. Dans un oratoire, assise contre une porte surmontee d'une fenetre a croisillons, la Vierge Mere, en robe bleue drapee d'un manteau rouge, la tete nimbee d'une aureole, tenant en main le sein qui allaite son Divin Enfant place sur ses genoux, recouverts de langes. Un globe surmonte d'une croix est dans les mains de l'Enfant Jesus, qui a les bras tendus vers Saint Dominique, agenouille devant lui. A terre: un livre ouvert et a gauche du tableau, une table couverte d'un tapis a franges. Cuivre Haut. 30 larg.24." ;
    crm:P102_has_title zac:BO0624_50794_lot_59_title ;
    crm:P138i_has_representation <nan> ;
    crm:P1_is_identified_by zac:BO0624_50794_lot_59_id ;
