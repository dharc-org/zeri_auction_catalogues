    rdfs:label "51 - LAWRENCE. Attribue a SIR THOMAS. Portrait d' Homme." ;
    crm:P102_has_title zac:BO0624_83724_lot_51_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0624_83724!BO0624_83724_000262-p.%2025.jpg/full/max/0/default.jpg> ;
