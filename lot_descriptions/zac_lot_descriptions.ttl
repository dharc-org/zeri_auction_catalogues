zac:65735_lot_46 a la:Set ;
    rdfs:label "HUBERT ROBERT  (Paris1733-1808). Nimes et ses monuments." ;
    crm:P102_has_title zac:65735_lot_46_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/f08d47a9-d3c3-476c-8502-28a5ad7073ab/full/full/0/default.jpg> ;
