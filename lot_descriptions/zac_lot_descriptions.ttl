zac:BO0624_4482_lot_26 a la:Set ;
    rdfs:label "26 - Weenix Jean B.—1621-1660. Chiens de chasse et gibier. Deux levriers a la robe tachetee sont representes au repos; un chien d'arret a longs poils s'allonge par terre dans un pose de lassitude.Un groupe de gibier ou domine un magnifique lievre, est artistiquement dispose,melange aux ustensiles du chasseur. Une fraiche perspective de paysage complete le tableau. Le dessin exact accuse les formes avec une precision parfaite et rend le pelage des quadrupedes et la plume des oiseaux avec une exquise verite et une rare perfection de details. Toile.Cadre dore. 1.20X1.65" ;
    crm:P102_has_title zac:BO0624_4482_lot_26_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0624_4482!BO0624_4482_000351-p.%206.jpg/full/max/0/default.jpg> ;
