zac:83743_lot_32 a la:Set ;
    rdfs:label "Weenix. Le Gibier." ;
    crm:P102_has_title zac:83743_lot_32_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/54080729-522a-4909-9529-05cf063f71a1/full/full/0/default.jpg> ;
