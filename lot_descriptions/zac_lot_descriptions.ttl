zac:BO0624_15271_lot_186 a la:Set ;
    rdfs:label "186 - Paulus van Vianen aus Utrecht  (1596 in Munchen, seit 1603,CammergoldschmidKaiser Rudolfs 1I., gest.1614). Minerva. In einer Landschaft die fast entblosste, stehende Gottin mit Helm,Speer und Schild bewehrt.Auf der Umrahmung sind oben die ruhenden Gestalten von Juno und Venus iber zwei Fullhornern dargestellt;rechts und links zwei Lowenmasken;unter diesen zwei Pfauen；unten abschliessend ein Engelskopf. 115x80 mm. In Silber gegossenes,schildformiges ziseliertes Goldschmiedemodell.Trefflich erhalten." ;
    crm:P102_has_title zac:BO0624_15271_lot_186_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0624_15271!BO0624_15271_000152-p.%2025.jpg/full/max/0/default.jpg> ;
    crm:P1_is_identified_by zac:BO0624_15271_lot_186_id ;
    crm:P67i_is_referred_to_by zac:BO0624_15271_lot_186_description ;
    crm:P94i_was_created_by zac:creation_BO0624_15271_lot_186 .

