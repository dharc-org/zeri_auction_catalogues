    rdfs:label "73 - RAVESTEIN. 1580-1657. Portrait d'un Gentilbomme. 92" ;
    crm:P102_has_title zac:BO0624_83724_lot_73_title ;
    crm:P138i_has_representation <nan> ;
    crm:P1_is_identified_by zac:BO0624_83724_lot_73_id ;
    crm:P67i_is_referred_to_by zac:BO0624_83724_lot_73_description ;
