zac:83725_lot_30 a la:Set ;
    rdfs:label "MAZZUOLl, Francesco, dit LE PARMESAN. 1503-1540.LE MARIAGE MYSTIQUE DE SAINTE CATHERINE. 1576." ;
    crm:P102_has_title zac:83725_lot_30_title ;
    crm:P1_is_identified_by zac:83725_lot_30_id ;
    crm:P67i_is_referred_to_by zac:83725_lot_30_description ;
    crm:P94i_was_created_by zac:creation_83725_lot_30 .

zac:83725_lot_30_description a crm:E33_Linguistic_Object ;
    rdfs:label """- 30.—LE MARIAGE MYSTIQUE DE SAINTE CATHERINE.\r
\r
Peinture sur toile.\r
\r
Sainte Catherine prend les mains de l'enfant Jesus qui, assis sur les genoux de sa mere, tourne la tete. Saint Joseph lui parle; devant, saint Jean-Baptiste tient la croix; dans le haut du tableau, des anges soulevent une draperie. Tres pres de la maniere du Correge;ferme et spirituelle esquisse.\r
\r
Haut. om6o, larg. o40.\r
## TIZIANO VECELLI dit LE TITTEN. 1477-1576.""" ;
    crm:P2_has_type aat:300435416 .

