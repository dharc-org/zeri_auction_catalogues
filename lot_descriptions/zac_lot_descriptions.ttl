zac:15271_lot_102 a la:Set ;
    rdfs:label "Moderno, in Oberitalien Ende des 15.bis Anfang des 16. Jahrh. tatig. Auferstehung Christi. Aus dem geoffneten Steinsarge schwingt sich Christus mit erhobener Rechten,in der Linken die Siegesfahne haltend,empor. Vierunbekleidete Krieger blicken zu Christus auf. Im Hintergrund links eine Felsgrotte. Bode748.Mol.180.84x50mm.Blei.Schon." ;
    crm:P102_has_title zac:15271_lot_102_title ;
