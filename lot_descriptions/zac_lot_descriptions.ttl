    crm:P94i_was_created_by zac:creation_BO0624_15271_lot_183 .

zac:BO0624_15271_lot_183_description a crm:E33_Linguistic_Object ;
    rdfs:label """- 183\r
- Auierstehung Christi. Christus,vom flatternden Mantel umwallt, schwebt in Wolken, die Rechte zum Segen erhoben,in der Linken die Siegesfahne haltend. Zwei Engel halten die Grabplatte unter ihm.Im Vordergrund fahren drei Kriegsknechte erschreckt zurick,wahrend einer vorne rechts noch schlaft. Braun 189. Voge 863. 93x68 mm. Bronze. Vorzuglich schones Exemplar in vergoldetem Renaissance-Holzrahmen.\r
\r
Tafel XI.\r
\r
##""" ;
