zac:BO0624_23222_lot_319 a la:Set ;
    rdfs:label "319 - Desgl.,ein Goldkreuz, doppelwandig,innen hohl. Das Kreuz hat die Form einer groben, runden Scheibe mit vier kleinen Ansatzen, auf denen kleine, runde Perlen sitzen. Die ganze Oberseite ist mit getriebenen Flecht bandmustern verziert. In der Mitte ist eine Goldminze des Konstantin Pogonat (um 660.—Sabatier, Monnaies Byzantines Taf.XXxV,14.) angebracht.H.7,B.6,5: Gewicht 27 g.（Zweifelhaft.)Zwei goldene Fibeln, breite" ;
    crm:P102_has_title zac:BO0624_23222_lot_319_title ;
    crm:P138i_has_representation <nan> ;
    crm:P1_is_identified_by zac:BO0624_23222_lot_319_id ;
