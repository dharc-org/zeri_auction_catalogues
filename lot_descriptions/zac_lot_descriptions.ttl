    rdfs:label "LORENZO LOTTO  Born at Venice in 1480; died at Loreto,1556. THE HOLY FAMILY" ;
    crm:P102_has_title zac:5750_lot_46_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/42137262-8f7a-44a6-b5c4-4784bb0a0534/full/full/0/default.jpg> ;
