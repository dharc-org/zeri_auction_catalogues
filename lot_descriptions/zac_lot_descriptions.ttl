zac:BO0614_87918_lot_16_description a crm:E33_Linguistic_Object ;
    rdfs:label """## \r
\r
Auf einer von Baumen bewachsenen Felsgruppe, welcher eine Quelle entspringt, liegen verschiedene groBere und kleinere tote Vogel und ein Eichkatzchen. Links Ausblick in die alpine Landschaft.\r
\r
Auf Leinwand.Hohe 87 cm,Breite 71 cm.In Goldrahmen.\r
\r
##""" ;
    crm:P2_has_type aat:300435416 .

