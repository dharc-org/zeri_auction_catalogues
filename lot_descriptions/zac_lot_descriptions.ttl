zac:65729_lot_6 a la:Set ;
    rdfs:label "CH. DAUBIGNY - LE BERGER ET SON TROUPEAU AU CLAIR DELUNE" ;
    crm:P102_has_title zac:65729_lot_6_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/b1b34ce3-9d34-44ce-a4ce-f8cf57e25cdb/full/full/0/default.jpg> ;
    crm:P1_is_identified_by zac:65729_lot_6_id ;
