    rdfs:label "47 - ècole hollandaise. XVII siécle. Portrait de Gentilbomme." ;
    crm:P102_has_title zac:BO0624_83724_lot_47_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0624_83724!BO0624_83724_000242-p.%2023.jpg/full/max/0/default.jpg> ;
    crm:P1_is_identified_by zac:BO0624_83724_lot_47_id ;
