zac:BO0624_4399_lot_53 a la:Set ;
    rdfs:label "53 - SIMONE MARTINI  （dit Sinon Memmi,1280-1344）. PANNEAU central de grand retable a fond dore,orne de petites colonnes torses soutenant un arc ogive avec ornements et surmonte de cuspide. Au centre Saint Antoine Eveque de la Thebaide,represente de face, assis sur un siege bas, garni d'un coussin de brocart plein or,tient a la main droite un livre qu'il appuie sur les genoux et de le gauche le tau. Deux anges avec des instruments musicaux sont agenouilles a droite et a gauche devant le Saint. Audessus deux autres anges soutiennent une draperie en brocart a feurons dores qui couvre presque entierement le fond du panneau. Dans lentablement, au centre d'un medaillon trilobe, le Pere Eternel." ;
    crm:P102_has_title zac:BO0624_4399_lot_53_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0624_4399!BO0624_4399_000092-p.%2013.jpg/full/max/0/default.jpg> ;
    crm:P1_is_identified_by zac:BO0624_4399_lot_53_id ;
