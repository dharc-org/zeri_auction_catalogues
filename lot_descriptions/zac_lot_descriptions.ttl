    rdfs:label "1794 - JETONS HISTORIQUES.- COLLECTIONS DE PIECES DES XVIeET XVIIe SIECLES, PUIS QUELQUES PIECES DU XVIHIe.-PLUS DE PIECES. Cuivre." ;
    crm:P102_has_title zac:BO0624_15351_lot_1794_title ;
