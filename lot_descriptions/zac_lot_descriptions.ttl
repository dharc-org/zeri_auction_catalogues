zac:15351_lot_1552 a la:Set ;
    rdfs:label "Velddaalder. Type au globe imperial; carre, aux angles coupees; contremarque de l'ecusson de Hollande. Au revers, cette inscription gravee a l'epoque (en 9 lignes):" ;
    crm:P102_has_title zac:15351_lot_1552_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/81ad67ab-8055-41a8-a2e8-cc7e2bb3d459/full/full/0/default.jpg> ;
