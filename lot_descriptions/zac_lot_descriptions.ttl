    crm:P67i_is_referred_to_by zac:15368_lot_377_description .

zac:15368_lot_377_description a crm:E33_Linguistic_Object ;
    rdfs:label """- 377 Gang nach Emmaus. Im Vordergrund schreitet Christus zwischen den beiden Jungern\r
\r
Genaue Kopie des Holzschnittes der Lyoner Bibel von 1533, deren Illustrationen Salomon Bernhard gezeichnet hat. Abb. der Vorzeichnung dieser Plakette Auktionskat. Boerner Leipzig 1914. Vom gleichen Meister die Plakette Noli me tangere. Auktion Frank, Otto Helbing, 14. Dez.1908 Nr. 3374.\r
\r
- nach rechts. Im Hintergrund Emmaus, im Hause links sitzt Christus mit den beiden Jungern beim Mahl.\r
\r
Bronze.Vergoldet.Original.H.180.—B.147. Braun 197. Tafel 29""" ;
    crm:P2_has_type aat:300435416 .

