zac:BO0624_44631_lot_51 a la:Set ;
    rdfs:label "51 - VITRaIL rectangulaire,en couleurs, aux armes de la Ville de Porrentruy, representant un écusson d'armoiries, de gueules au sanglier d'or passant a droite.  L'écusson est soutenu par deux anges debout, aux larges ailes deployees, et portant, au-dessus des armoiries,une longue tige fleurie.  L'encadrement en grisaille, simule un portail gothique orne de feuillages crispes dans les tympans.  Suisse Romande. xvie siecle." ;
    crm:P102_has_title zac:BO0624_44631_lot_51_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0624_44631!BO0624_44631_000211-p.%2026.jpg/full/max/0/default.jpg> ;
