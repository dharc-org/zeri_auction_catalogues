zac:BO0624_50794_lot_134 a la:Set ;
    rdfs:label "134 - PIERRE PRUD'HON 1758-1823, Cluny. Apollon Citharede. Adolescent vu de face, a mi-corps. Une draperie rosatre laissant a decouvert le haut du corps, est posee negligemment vers le bas et retenue sur l'epaule gauche par un etroit ruban. La tete ressort finement sur un cercle lumineux bleu; une couronne de lauriers orne les belles boucles blondes. Dans les mains une cithare.  Gracieux portrait empreint de grace juvenile.  Toile Haut. 68 larg. 52." ;
    crm:P102_has_title zac:BO0624_50794_lot_134_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0624_50794!BO0624_50794_000772-p.%2067.jpg/full/max/0/default.jpg> ;
