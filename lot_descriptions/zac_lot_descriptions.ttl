zac:83743_lot_27 a la:Set ;
    rdfs:label "TENIERS LE JEUNE. La Partie de piquet." ;
    crm:P102_has_title zac:83743_lot_27_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/a1aa59b4-9fcf-48ae-badf-d45acda4acc3/full/full/0/default.jpg> ;
    crm:P1_is_identified_by zac:83743_lot_27_id ;
