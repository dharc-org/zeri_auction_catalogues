zac:BO0624_4399_lot_562 a la:Set ;
    rdfs:label "562 - SyMPoSIUM.Trois personnages sont etendus,chacun sur un kline,celui du milieu éleve dans la main droite un rhyton,les autres deux tiennent dans une main le calatus et de l'autre donnent a manger, un a un coq l'autre aun serpent.Au milieu du triclinium qui est orne de guirlandes defeursle cilibantumavecdeux esclaves de chaque cote; a gauche un candelabre avec deux torches allumees.A la partie inferieure un focarius place du bois dans un rechaud et un peu plus loin une amphore placee sur un trepied.Fragment de bas-relief en marbre grec. Etrusque. IIIe siecle av. C." ;
    crm:P102_has_title zac:BO0624_4399_lot_562_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0624_4399!BO0624_4399_000382-p.%2071.jpg/full/max/0/default.jpg> ;
    crm:P1_is_identified_by zac:BO0624_4399_lot_562_id ;
    crm:P67i_is_referred_to_by zac:BO0624_4399_lot_562_description .

