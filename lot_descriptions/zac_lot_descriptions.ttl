    rdfs:label "1577. Sou, au meme type, mais rond. Non cite par Mailliet. Cuivre. Serie de pieces de 40,20, 10 et 5 sols,variant entre eux par les" ;
    crm:P102_has_title zac:15351_lot_1667_title ;
