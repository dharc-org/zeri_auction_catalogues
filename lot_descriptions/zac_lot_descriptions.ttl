zac:23222_lot_283 a la:Set ;
    rdfs:label "Desgl, eine groBe silbertauschierte Scheibenfibel auf Bronzeunterlage. In der Mitte eine, am Rande vier" ;
    crm:P102_has_title zac:23222_lot_283_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/36093473-b2df-4e7d-8061-ebad07878428/full/full/0/default.jpg> ;
