zac:51192_lot_83 a la:Set ;
    rdfs:label "BRONZE STATUETTE OF APOLLO. Etruscan, VIth century B.C. In archaic style. His arms are stretched downwards, the rated. The face is round and smiling. He is entirely nude, save for singular pointed shoes on his feet. This is unquestionably a representation of Apollo, as the pose is exactly that of the Apollo of Thera, which would appear to be the earliest existing statue of the God." ;
    crm:P102_has_title zac:51192_lot_83_title ;
    crm:P1_is_identified_by zac:51192_lot_83_id ;
    crm:P2_has_type <http://w3id.org/zac/type/bronzi> ;
    crm:P67i_is_referred_to_by zac:51192_lot_83_description .

zac:51192_lot_83_description a crm:E33_Linguistic_Object ;
    rdfs:label """In archaic style. His arms are stretched downwards, the rated. The face is round and smiling. He is entirely nude, save for singular pointed shoes on his feet. This is unquestionably a representation of Apollo, as the pose is exactly that of the Apollo of Thera, which would appear to be the earliest existing statue of the God.\r
\r
A very fine piece, in perfect preservation. Green patina.\r
\r
Ht.,5 1/2inches.\r
\r
Greek,c.500 B.C.\r
\r
(Illustrated.)""" ;
    crm:P2_has_type aat:300435416 .

