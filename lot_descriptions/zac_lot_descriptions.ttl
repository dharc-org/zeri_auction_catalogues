zac:BO0624_50014_lot_1 a la:Set ;
    rdfs:label "1 - Banc de corridor a dos artistiquement sculpte a volutes, se rencontrant au milieu, accostant un vase. Les cotés lateraux sculptes et ajoures et reunis par une traverse artistiquement sculpté a decor de feuillage. Long. 2.18, haut. 1.17 M. Epoque Louis XIV." ;
    crm:P102_has_title zac:BO0624_50014_lot_1_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0624_50014!BO0624_50014_000042-p.%20%5B1%5D.jpg/full/max/0/default.jpg> ;
