    rdfs:label "VITTORIO PISANELLO.  (XV siecle). L'ADORATION DES MAGEs. Carton pour tapisserie d'une ordonnance tres riche,representant, 1'arrivee des Mages a Bethleem,avec une nombreuse suite de personnages a cheval, de serviteurs, etc." ;
    crm:P102_has_title zac:4399_lot_587_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/d21904e5-639c-445b-9ad7-1e19a79d1d4c/full/full/0/default.jpg> ;
    crm:P1_is_identified_by zac:4399_lot_587_id ;
    crm:P67i_is_referred_to_by zac:4399_lot_587_description .

zac:4399_lot_587_description a crm:E33_Linguistic_Object ;
    rdfs:label """- 587.L'ADORATION DES MAGEs. Carton pour tapisserie d'une ordonnance tres riche,representant, 1'arrivee des Mages a Bethleem,avec une nombreuse suite de personnages a cheval, de serviteurs, etc.\r
\r
L'exactitude de la perspective,le dessin soigne des figures,la perfection dans lexecution des animaux justifient l'attribution de ce carton au fameux Pisanello.\r
\r
Dimensions,M.2.7oX1.14\r
\r
##""" ;
    crm:P2_has_type aat:300435416 .

