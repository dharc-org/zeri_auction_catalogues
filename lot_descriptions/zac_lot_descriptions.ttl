zac:BO0624_4671_lot_63 a la:Set ;
    rdfs:label "63 - PETITE PENDULE. Sur socle en bronze dore,a frise ciselee et ajouree s'elevent trois arbrissaux,et entre les branches de celui du milieu est pose le cadran,de chaque cote et sur le devant une figurine chinoise en ronde bosse, vernie en couleurs et doree representant la Richesse et la Pauvrete. Mouvement par Pia-Paris. Epoque Louis XV. Piece remarquable." ;
    crm:P102_has_title zac:BO0624_4671_lot_63_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0624_4671!BO0624_4671_000071-p.%2010.jpg/full/max/0/default.jpg> ;
