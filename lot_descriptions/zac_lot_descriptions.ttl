zac:BO0624_4399_lot_416 a la:Set ;
    rdfs:label "416 - FILIPPINO LIPPI.  (1460-1505). LA VIERGE ADORANT L'ENFANT JESUS. Panneau cintre par le haut.La Mere de Dieu agenouillee,les mains jointes,la tete couverte d'un leger voile, drapee dans un manteau bleu a galon d'or est en adoration devant l'Enfant Jesus,couche nu sur un coussin;le petit Saint Jean a cote,également en adoration.En haut, dans le lontain, paysage avec des bergers. Encadrement formant corps avec le panneau,a bordure,peint en bleu avec etoiles dorees et moulures sculptees et dorees. Au bas, sur le frise l'inscription: Ave Maria gratia plena,en lettres dorees et deux ecussons a les extremites. Composition pleine de grace et de ce charme qui a rendu celebres les tableaux de ce maitre." ;
    crm:P102_has_title zac:BO0624_4399_lot_416_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0624_4399!BO0624_4399_000302-p.%2055.jpg/full/max/0/default.jpg> ;
    crm:P1_is_identified_by zac:BO0624_4399_lot_416_id ;
    crm:P2_has_type <http://w3id.org/zac/type/dipinti> ;
    crm:P67i_is_referred_to_by zac:BO0624_4399_lot_416_description .

