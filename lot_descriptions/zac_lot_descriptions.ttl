zac:BO0624_50794_lot_84 a la:Set ;
    rdfs:label "84 - SEBASTIEN RICCI 1662-1734,Venise. Le roi Salomon.  Sur un socle de marbre orne de haut-reliefs se dresse une idole. Salomon, portant un manteau royal recouvert d'hermine avec chaine en or, agrafe en pierreries, est en adoration devant la fausse divinite. Deux femmes, dont l'une a genoux, vue de dos, tenant la main du roi,l'autre debout, semblent I'exhorter aux sacrifices. Derriere le socle,trois autres femmes.  Toile Haut. 69 larg. 82.  A gauche du tableau, plusieurs femmes portant des fleurs. Dans le haut une draperie soulevee." ;
    crm:P102_has_title zac:BO0624_50794_lot_84_title ;
    crm:P138i_has_representation <nan> ;
    crm:P1_is_identified_by zac:BO0624_50794_lot_84_id ;
