zac:44631_lot_29 a la:Set ;
    rdfs:label "VITRAIL de forme rectangulaire, en couleurs, representant un écusson aux armes de la ville de Strasbourg, pose sur un lion couche, et soutenu de chaque cote par un lion et une lionne dresses. L'écusson est timbre d'un heaume surmonte d'une couronne et d'ailes deployees.  Encadrement forme de deux pilastres ornementes, soutenant un linteau decore de palmettes.  A la partie inferieure,l'inscription:INsIGNIA cIvI-  TATIS ARGENTINENSIS,et la date 1523.  Suisse ou Allemagne. xvi siecle." ;
    crm:P102_has_title zac:44631_lot_29_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/7e6068d2-43bd-40c0-b24b-b96e8ca3be2c/full/full/0/default.jpg> ;
    crm:P1_is_identified_by zac:44631_lot_29_id ;
    crm:P2_has_type <http://w3id.org/zac/type/vetri> ;
    crm:P67i_is_referred_to_by zac:44631_lot_29_description .

zac:44631_lot_29_description a crm:E33_Linguistic_Object ;
    rdfs:label """- 29—VIrRAIL de forme rectangulaire, en couleurs, representant un écusson aux armes de la ville de Strasbourg, pose sur un lion couche, et soutenu de chaque cote par un lion et une lionne dresses.\r
\r
L'écusson est timbre d'un heaume surmonte d'une couronne et d'ailes deployees.\r
\r
Encadrement forme de deux pilastres ornementes, soutenant un linteau decore de palmettes.\r
\r
A la partie inferieure,l'inscription:INsIGNIA cIvI-\r
\r
TATIS ARGENTINENSIS,et la date 1523.\r
\r
Suisse ou Allemagne. xvi siecle.\r
\r
Haut., 6o cent.; larg., 44 cent.\r
\r
Ce vitrail est execute d'apres un dessin de Hans Baldung Grien ou de son atelier. Il provient du Pfennigturm,a\r
\r
Strasbourg, demoli en 1768.\r
\r
Collection du peintre Gimbel,a Baden-Baden.\r
\r
Catalog. der Ausstellung von Kunst und Alterthum in Elsass-Lothringen 1895,n 817, page 86.\r
## VITRAUX ALLEMANDS""" ;
    crm:P2_has_type aat:300435416 .

