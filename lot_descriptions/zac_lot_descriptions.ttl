zac:BO0624_50014_lot_2 a la:Set ;
    rdfs:label "2 - Banc de salon Louis XIV en noyer sculpte,a pieds et colonnes torses, les pieds reunis par des traverses torses. Le dossier a riche sculpture de volutes et d'arabesques ainsi que les accoudoirs. Le siege et le dos en velours rouge. Long. 1.55, haut. 1.37 M. Beau meuble." ;
    crm:P102_has_title zac:BO0624_50014_lot_2_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0624_50014!BO0624_50014_000042-p.%20%5B1%5D.jpg/full/max/0/default.jpg> ;
