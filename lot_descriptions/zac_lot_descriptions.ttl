zac:83735_lot_61 a la:Set ;
    rdfs:label "ECOLE HOLLANDAISE. Portrait d'homme." ;
    crm:P102_has_title zac:83735_lot_61_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/e1a43f82-0666-4eb1-b955-b1e903c0ed17/full/full/0/default.jpg> ;
