zac:BO0624_15368_lot_219-232 a la:Set ;
    rdfs:label "219-232 - Monogrammist H L (Hans Leitmaier? Nurnberg um 1540). Vierzehn runde Plaketten mit profiliertem Rand nach Duirers Marienleben und kleiner Passion. Die Serie ist ruckseitig vertieft nummeriert, in nachfolgender Ordnung:1.Verkindigung Mariae. 2. Geburt Christi. 3. Darstellung im Tempel. 4. Anbetung der Konige. 5. Flucht nach Agypten. 6. Der Knabe Christus im Tempel. 7. Christus erscheint seiner Mutter. 8. Kreuztragung. 9. Christus am Kreuz. 10. Grablegung. 11. Beweinung Christi. 12. Himmelfahrt Christi. 13. Sendung des hl. Geistes." ;
    crm:P102_has_title zac:BO0624_15368_lot_219-232_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0624_15368!BO0624_15368_000172-p.%2021.jpg/full/max/0/default.jpg> ;
