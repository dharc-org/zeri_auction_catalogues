zac:BO0624_23222_lot_286_description a crm:E33_Linguistic_Object ;
    rdfs:label """- 286 Desgl, eineviereckige Bronze-Fibel, in der Mitte Erhohung mit Almandinsteinchen, an den Ecken punzierte\r
Zwei Schnallen in Bronze.——Zwei bronzene Riemenzungen.—Ein Beschlagstuick mit vier Nieten.- Ein bronzenes Armband.-Ein Kamm,zweizeilig, mit Wellenlinien verziert. Zahne abgebrochen.-Eine Perlkette.-Ein Messer. Mulhofen.""" ;
    crm:P2_has_type aat:300435416 .

