zac:65735_lot_14 a la:Set ;
    rdfs:label "JACOPO DEL SELLAIO (Attribue a)  Florence:1442-1493.  Adoration des Mages." ;
    crm:P102_has_title zac:65735_lot_14_title ;
    crm:P1_is_identified_by zac:65735_lot_14_id ;
