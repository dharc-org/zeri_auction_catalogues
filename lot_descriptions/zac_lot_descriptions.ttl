zac:50794_lot_131 a la:Set ;
    rdfs:label "JUSTE SUSTERMANS 1597-1681,Anvers. Portrait d'un marechal. Revetu d'une armure sur laquelle est drape un manteau de soie bleue, coiffe d'un chapeau de feutre garni de plumes. La main gauche est posee sur la hanche. La main droite tient un baton de marechal qui est appuye sur une table recouverte d'un tapis de velours rouge. Le casque, faisant partie de l'armure est place sur la table.  Draperie verte dans le fond.  Toile Haut.110 larg. 87." ;
    crm:P102_has_title zac:50794_lot_131_title ;
    crm:P1_is_identified_by zac:50794_lot_131_id ;
    crm:P67i_is_referred_to_by zac:50794_lot_131_description ;
