    rdfs:label "— STATuETTE equestre en bronze patine. France, fin du xvi siecle." ;
    crm:P102_has_title zac:15268_lot_19_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/762ff617-183e-4133-91e8-e16bfab94dc1/full/full/0/default.jpg> ;
