zac:83724_lot_46 a la:Set ;
    rdfs:label "SANTVOORT. Portrait d’une feune Dame de qualite.  En buste, richement vetue, col de dentelles, parure de chaines et de bijoux d'or; les cheveux chatains boucles." ;
    crm:P102_has_title zac:83724_lot_46_title ;
