zac:50794_lot_27_description a crm:E33_Linguistic_Object ;
    rdfs:label """## 27. Bulles de Savon.\r
\r
Joli petit tableau representant une jeune femme decolletee, s'amusant a faire des bulles de savon.\r
\r
Vetue d'une jupe rouge et d'un corsage bleu, le cou et les bras ornes de bijoux.\r
\r
Les bras gauche est accoude sur une table ou l'on voit une assiette et un chalumeau; la main droite est gracieusement relevee,a la poursuite d'une bulle qui voltige dans lair.\r
\r
Signe sur le rebord de la table.\r
\r
\r
Toile Haut. 24 larg. 21.\r
\r
##""" ;
    crm:P2_has_type aat:300435416 .

zac:50794_lot_27_id a crm:E42_Identifier ;
    rdfs:label "BO0624_50794-27" .

zac:50794_lot_27_title rdfs:label "GEORGES ROMNEY 1734-1802, Dalton. Bulles de Savon. Joli petit tableau representant une jeune femme decolletee, s'amusant a faire des bulles de savon.  Vetue d'une jupe rouge et d'un corsage bleu, le cou et les bras ornes de bijoux.  Les bras gauche est accoude sur une table ou l'on voit une assiette et un chalumeau; la main droite est gracieusement relevee,a la poursuite d'une bulle qui voltige dans lair.  Signe sur le rebord de la table.   Toile Haut. 24 larg. 21." .

zac:50794_lot_28 a la:Set ;
    rdfs:label "JEAN HOPPNER 1579-1810,Londres. Portrait de jeune femme. 1802,Dalton. Peinte en medaillon, decolletee, vue de face, le corsage garni d'une fine dentelle.  Les cheveux vaporeux, d’un blond ardent, sont releves en bouffant au sommet de la tete; de chaque cote deux boucles retombent gracieusement sur les epaules.  De grands yeux bruns, pleins de malice, une bouche souriante ajoutent au charme de ce gracieux tableau." ;
    crm:P102_has_title zac:50794_lot_28_title ;
    crm:P1_is_identified_by zac:50794_lot_28_id ;
    crm:P67i_is_referred_to_by zac:50794_lot_28_description ;
    crm:P94i_was_created_by zac:creation_50794_lot_28 .

