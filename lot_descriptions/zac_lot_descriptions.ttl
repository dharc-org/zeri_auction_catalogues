zac:BO0624_4399_lot_141 a la:Set ;
    rdfs:label "141 - J.PALMA IL VECCHIO. PROPHETE.Demi fgure, tete a longue barbe blanche,recouverte d'un manteau rouge retombant le long de la figure;un livre ouvert entre les mains. Tres belle peinture. L'expression de la tete est d'une venerable serenite. Coloris vigoureux,touche admirable,execution tres soignee. Cadre en bois sculpte et dore." ;
    crm:P102_has_title zac:BO0624_4399_lot_141_title ;
