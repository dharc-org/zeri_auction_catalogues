    rdfs:label "STATUETTE equestre sur base, en bronze a patine brune. Padoue,fin du xv siecle." ;
    crm:P102_has_title zac:15268_lot_6_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/cd5cf505-13b6-4b70-81b8-2d55587f3320/full/full/0/default.jpg> ;
