    crm:P67i_is_referred_to_by zac:BO0624_15368_lot_219-232_description ;
    crm:P94i_was_created_by zac:creation_BO0624_15368_lot_219-232 .

zac:BO0624_15368_lot_219-232_description a crm:E33_Linguistic_Object ;
    rdfs:label """- 219-232Vierzehn runde Plaketten mit profiliertem Rand nach Duirers Marienleben und kleiner Passion. Die Serie ist ruckseitig vertieft nummeriert, in nachfolgender Ordnung:1.Verkindigung Mariae. 2. Geburt Christi. 3. Darstellung im Tempel. 4. Anbetung der Konige. 5. Flucht nach Agypten. 6. Der Knabe Christus im Tempel. 7. Christus erscheint seiner Mutter. 8. Kreuztragung. 9. Christus am Kreuz. 10. Grablegung. 11. Beweinung Christi. 12. Himmelfahrt Christi. 13. Sendung des hl. Geistes.  14.Mariae Himmelfahrt.\r
\r
Zwei bei Bange (S. 95, 5736 und 5737) beschriebene Bleiexemplare aus der vorliegenden Serie sind mit dem Monogramm HL bezeichnet.\r
\r
Silber.47.""" ;
