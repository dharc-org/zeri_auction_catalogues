zac:BO0614_87918_lot_61_description a crm:E33_Linguistic_Object ;
    rdfs:label """## 61 Ecce-homo.\r
\r
Auf Leinwand. Hohe 6o cm,Breite 73 cm.In Goldrahmen.\r
\r
##\r
\r
roten Mantel, der die Brust unbedeckt laft; auf dem etwas zur Seite geneigten Kopfe mit seinem\r
\r
Ein leichter Glorienschein umfieft das Haupt.\r
\r
Abbildung sieheTafel20.\r
\r
Auf Holz. Hohe 65 cm, Breite 48 cm. In Goldrahmen.\r
\r
Ebenso.Gleiche GroBe.Ebenso.\r
\r
##""" ;
    crm:P2_has_type aat:300435416 .

