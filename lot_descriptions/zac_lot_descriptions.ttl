zac:BO0624_23222_lot_317 a la:Set ;
    rdfs:label "317 - Desgl,eine goldene Scheibenfibel, die Oberseite wird durch schmale, getriebene,von Filigran umrahmte Buckel in einen Kreis von acht Feldern geteilt, deren jedes auf niedrigem Buckel eine viereckige Fassung mit roter, gruiner oder weiBer Fillung tragt. Das etwas herausgetriebene Mittelfeld schmickt eine runde Perle in hoher Fassung, umgeben von einem Kranz kleiner Filigranringe. Die Unterseite ebenfalls Gold mit goldener Nadel und Nadelhalter. D. 48. Gewicht 42 g.-Ein bronzener Ohrring mit konischer Verdickung Ein Spinnwirtel aus grunem Glas mit weiBem" ;
    crm:P102_has_title zac:BO0624_23222_lot_317_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0624_23222!BO0624_23222_000122-p.%2019.jpg/full/max/0/default.jpg> ;
