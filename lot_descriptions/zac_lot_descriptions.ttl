zac:23222_lot_301 a la:Set ;
    rdfs:label "Desgl., eine Verroterie-Scheibenfibel, silberne Unterlage und Fassung, das erhohte Mittelrund mit vier Almandineinlagen, darum zwei Kreise radialgestellter Almandineinlagen, der auBere mit gewelltem Rand.D.3. Eine bronzene Facherfibel mit halbrunder Kopfplatte mit sieben Ansatzen, kurzem, flachen Bugel, ovaler FuBplatte, die in einen stilisierten Tierkopf endigt. Kopf-und FuBplatte mit eingeschnittenem Flechtband muster. Stark vergoldet. L. 9,5. -— Ein Bronze-Kreuz mit Kette, das Kreuz mit punzierter Punktverzierung. Ein beschadigter, silberner Ohrring mit dicker Bronzekugel als Anhangsel. - Zwei bronzene Ohrringe. Ein Beschlagstick mit Flechtbandmuster.—Eine bronzene Gurtelschnalle mit Strichverzierung.— Drei Sandalenschnallchen.—Eine Bartzange.-Eine Perlkette, Dattenberg. Abb. Tafel6." ;
    crm:P102_has_title zac:23222_lot_301_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/1b4577c1-1d56-428c-b587-5737732005ab/full/full/0/default.jpg> ;
    crm:P1_is_identified_by zac:23222_lot_301_id ;
    crm:P2_has_type <http://w3id.org/zac/type/oggetti_in_ferro> ;
    crm:P67i_is_referred_to_by zac:23222_lot_301_description .

