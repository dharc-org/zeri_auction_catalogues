    rdfs:label "GAINSBOROUGH. Attribue a THOMAS. Portrait d'un Gentilbomme." ;
    crm:P102_has_title zac:83724_lot_49_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/f70f00d3-ae1a-43b3-a7d5-e2f6564ddad5/full/full/0/default.jpg> ;
