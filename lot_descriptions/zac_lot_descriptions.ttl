    rdfs:label "10 - TROIS PETITS GROUPES d'enfants en bronze patine. Padoue, commencement du xvie siecle." ;
    crm:P102_has_title zac:BO0624_15268_lot_10_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0624_15268!BO0624_15268_000142-p.%207.jpg/full/max/0/default.jpg> ;
