    rdfs:label "Ricard, Louise-Gustave. 1824-1873. Blonde enigme. ci, pas α d'anecdote》, pas de《 sujet 》,pas de《 recit , qui captive ou qui charme. Une tete de femme et c'est tout. Le visage d'une inconnue" ;
    crm:P102_has_title zac:83754_lot_20_title ;
    crm:P1_is_identified_by zac:83754_lot_20_id ;
