    rdfs:label "49 - GAINSBOROUGH. Attribue a THOMAS. Portrait d'un Gentilbomme." ;
    crm:P102_has_title zac:BO0624_83724_lot_49_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0624_83724!BO0624_83724_000251-p.%2024.jpg/full/max/0/default.jpg> ;
