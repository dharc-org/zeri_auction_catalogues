zac:87918_lot_71 a la:Set ;
    rdfs:label "Adriaen Hendriksz Verboom (geb.zu Amsterdam 1628, gest. daselbst nach 1667). Landschaft bei Abendstimmung." ;
    crm:P102_has_title zac:87918_lot_71_title ;
    crm:P1_is_identified_by zac:87918_lot_71_id ;
    crm:P67i_is_referred_to_by zac:87918_lot_71_description ;
    crm:P94i_was_created_by zac:creation_87918_lot_71 .

zac:87918_lot_71_description a crm:E33_Linguistic_Object ;
    rdfs:label """## 71 Landschaft bei Abendstimmung.\r
\r
Ein hochbeladener Heuwagen, von einem die Peitsche schwingenden Bauern gefihrt, zieht dem Vordergrunde zu, den schreitende Wanderer und rastende Bauersleute beleben. Links steht unter machtigen Baumgruppen eine strohbedeckte Hitte, rechts breitet sich eine Wiese aus, die von einem kleinen Geholz begrenzt wird. Mit weitem Fernblick.Von der untergehenden Sonne rotlich beleuchtetes\r
\r
Gewolkbedeckt den Himmel.\r
\r
Links bez.: A.Ver Boom.\r
\r
Abbildung siehe Tafel 23.""" ;
    crm:P2_has_type aat:300435416 .

zac:87918_lot_71_id a crm:E42_Identifier ;
    rdfs:label "BO0614_87918-71" .

