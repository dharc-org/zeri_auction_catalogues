zac:BO0624_15271_lot_135 a la:Set ;
    rdfs:label "135 - Unbestimmte Meister. Der Judaskuss. In drei Gruppen geteilte Darstellung.In der Mitte Christus,den Judas umarmt und auf die Wange kisst.Er wird von einem von hinten gesehenen Jinger angehalten.Von links her dringen vier romische Soldaten auf Christus ein,um ihn zu verhaften. Rechts unter einem Baume Paulus mit dem Schwerte ausholend,um dem am Boden liegenden Knechte des Hohenpriesters das Ohr abzuschlagen. 210X111 mm. Bronze.Unediert? Hochreliefierter feiner" ;
    crm:P102_has_title zac:BO0624_15271_lot_135_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0624_15271!BO0624_15271_000122-p.%2019.jpg/full/max/0/default.jpg> ;
