zac:44631_lot_46 a la:Set ;
    rdfs:label "VITRAIL rectangulaire en couleurs,representant le portrait et les armes du Comte Rodolphe de Soulz. atgrof .Jm.Klckom.L.#.Budut.  Travail suisse ou allemand. xvi siecle Haut., 43 cent.; larg., 32 cent." ;
    crm:P102_has_title zac:44631_lot_46_title ;
    crm:P1_is_identified_by zac:44631_lot_46_id ;
