zac:83725_lot_54 a la:Set ;
    rdfs:label "CLAUDE GELLEE dit LE LORRAIN. 1600-1682. PAYSAGE." ;
    crm:P102_has_title zac:83725_lot_54_title ;
    crm:P1_is_identified_by zac:83725_lot_54_id ;
    crm:P67i_is_referred_to_by zac:83725_lot_54_description ;
    crm:P94i_was_created_by zac:creation_83725_lot_54 .

zac:83725_lot_54_description a crm:E33_Linguistic_Object ;
    rdfs:label """54.——PAYSAGE.\r
\r
Peinture sur toile.\r
\r
Pres d'un temple d'ordre ionique, Mercure s'approche d'Argus; derriere lui, la vache lo et d'autres animaux. Grands arbres,beaux lointains, ciel clair. Le dessin de cetableau faitpartie du Liber veritatis (planche 150).\r
\r
Haut.om64,larg.om73.\r
\r
## CLAuDE GELLEE dit LE LORRAIN 1600-1682.""" ;
    crm:P2_has_type aat:300435416 .

