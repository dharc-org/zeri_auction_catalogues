zac:83725_lot_55 a la:Set ;
    rdfs:label "CLAUDE GELLEE dit LE LORRAIN. 1690-1743. PAYSAGE." ;
    crm:P102_has_title zac:83725_lot_55_title ;
    crm:P1_is_identified_by zac:83725_lot_55_id ;
    crm:P67i_is_referred_to_by zac:83725_lot_55_description ;
    crm:P94i_was_created_by zac:creation_83725_lot_55 .

zac:83725_lot_55_description a crm:E33_Linguistic_Object ;
    rdfs:label """55.——PAYSAGE.\r
\r
Peinture sur toile.\r
\r
Ruines de temples et autres fabriques;beaux arbres et lointain;au premier plan,statues,homme a cheval venant d'un abreuvoir situe a droite et une chevre. Les animaux ne sont pas acheves. Maniere large,bel ensemble.\r
\r
Haut.om61,larg.om8o.\r
\r
## LANCRET, Nicolas. 1690-1743.""" ;
    crm:P2_has_type aat:300435416 .

