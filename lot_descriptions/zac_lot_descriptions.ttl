zac:83725_lot_28_description a crm:E33_Linguistic_Object ;
    rdfs:label """28.——LE CHRIST.\r
\r
Peinture sur toile.\r
\r
Le Christ a mi-corps, plus grand que nature et impressionnant;la main droite elevee semble benir. Ce tableau a souffert.\r
\r
Haut.om97, larg.o72.\r
\r
## ANT.ALLEGRI dit LE CORREGE 1494-1534.""" ;
    crm:P2_has_type aat:300435416 .

