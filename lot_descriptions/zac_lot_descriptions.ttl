zac:83720_lot_596 a la:Set ;
    rdfs:label "Ecole Francaise. XVIII siecle. Le Reve." ;
    crm:P102_has_title zac:83720_lot_596_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/cd0a90a2-869e-4cfe-8057-1397abfbbaf7/full/full/0/default.jpg> ;
