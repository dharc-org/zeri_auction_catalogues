zac:BO0624_81812_lot_4 a la:Set ;
    rdfs:label "4 - Lorenzetti Ambrogio.1323-1348. San Giovanni e un altro Santo.Tavola a fondo oro di freschezza introvabile.Capolavoro di pittura senese! Cornice a tabernacolo in legno scolpito e dorato.Alt. cm.90, larg. cm.80. Richiamo lattenzione dei collezionisti e dei critici sopra questo importante dipinto,per lungo tempo attribuito a Beato Angelico del quale ha tutta la vivace,smagliante bellezza delle tinte,la drappeggiatura  delle stoffe.Dalla critica recente e stato attribuito al Lorenzetti." ;
    crm:P102_has_title zac:BO0624_81812_lot_4_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0624_81812!BO0624_81812_000022-p.%201.jpg/full/max/0/default.jpg> ;
