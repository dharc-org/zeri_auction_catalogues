zac:23222_lot_316 a la:Set ;
    rdfs:label "Desgl.,eine goldene Scheibenfibel auf Bronzeunterlage.In der Mitte der Scheibe sitzt auf flachem, getriebenem Buckel ein griner Halbedelstein. In dem mit Filigran bedeckten Felde um das Mittelstick vier drei eckige Fassungen mit Steinfillung,abwechselnd mit viermal je zwei hintereinanderstehenden,runden Fassungen, die inneren vier mit Almandinen, die auBeren mit Perlmuttereinlagen.Den Rand bilden zwei dicke, gewundene Drahte. D.5,1.-Ein bronzenes Armband mit Rillen verziert.—Eine quadratische, durchbrochene, bronzene Zierscheibe,punziert,ein dunnes, getriebenes Bronzeblech (sehr beschadigt） als Unterlage.L.5,4.Z Zwei Ohrringe, sehr beschadigt -Eine bronzene Schnalle.—Ein Bronzering.—Bronzene, punzierte Beschlagstickchen.-Bruchstick einer reich geschnittenen Hornscheibe.—Eine Perlkette.-Ein Messer, Minden b. Trier. Abb.Tafel5." ;
    crm:P102_has_title zac:23222_lot_316_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/de64dc67-1b66-4643-8662-b7c76adf33de/full/full/0/default.jpg> ;
    crm:P1_is_identified_by zac:23222_lot_316_id ;
    crm:P2_has_type <http://w3id.org/zac/type/oggetti_in_ferro> ;
    crm:P67i_is_referred_to_by zac:23222_lot_316_description .

