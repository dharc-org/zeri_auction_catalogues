zac:BO0624_4482_lot_78 a la:Set ;
    rdfs:label "78 - Titien ——1477-1576 (copie ancienne d'apres le). Le martyre de Saint Pierre le Dominicain. Le saint est a terre;il cherche a se defendre des coups que lui porte son bourreau. Dominique, le frere de la victime, s'enfuit la tete ensanglantee. Des anges du haut des nues presentent la palme au martyr. Toile. Cadre dore et sculpte. (L'original de ce tableau, un des meilleurs du Titien, a été malheureusement detruit par un incendie a Venise. Il fut execute par le maitre a 1age de 48 ans en 1528 pour 1'eglise de Saint Jean et Saint Paul). 1.58X0.95." ;
    crm:P102_has_title zac:BO0624_4482_lot_78_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0624_4482!BO0624_4482_000402-p.%2017.jpg/full/max/0/default.jpg> ;
    crm:P1_is_identified_by zac:BO0624_4482_lot_78_id ;
    crm:P67i_is_referred_to_by zac:BO0624_4482_lot_78_description ;
    crm:P94i_was_created_by zac:creation_BO0624_4482_lot_78 .

