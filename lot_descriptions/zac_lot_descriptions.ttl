zac:23222_lot_308 a la:Set ;
    rdfs:label "Desgl., ein schweres, goldenes Armband, 28 cm breit, aus zwei 28 cm breiten Platten bestehend. Jede weist in der Mitte finf Almandine auf, die umgeben sind von einem reichen Muster in Filigran und Granulierung. Zu beiden Seiten dieses Musters je eine hohe Fassung mit Perlmuttereinlage, von Filigran umrahmt. D.5,6, Gewicht 77 gEine kleine,beschadigte Scheibenfibel in Silber auf Bronzeunterlage. In der Mitte ein Buckel mit blauem Stein, darum vier Almandine, in der AuBenzone drei groBe Almandine mit dreimal hoher Fassung tragt er, von Filigran umgrenzt, einen blauen Stein. Gewicht 4 g. Ein verzierter,bronzener Schnallenansatz.--Ein Fragment aus Bronze.Ein Kamm, zweizeilig,mit Strichverzierung und Nieten auf der Verstarkung.——Eine Perlkette.—Eine Schere.——Ein Messer. Abb.Tafel5. Minden bei Trier." ;
    crm:P102_has_title zac:23222_lot_308_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/6293bda3-28ab-4e13-898c-eac5d65c7415/full/full/0/default.jpg> ;
    crm:P1_is_identified_by zac:23222_lot_308_id ;
    crm:P2_has_type <http://w3id.org/zac/type/oggetti_in_ferro> ;
    crm:P67i_is_referred_to_by zac:23222_lot_308_description .

