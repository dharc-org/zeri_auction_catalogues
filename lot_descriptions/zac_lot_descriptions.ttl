    rdfs:label "1552 - Velddaalder. Type au globe imperial; carre, aux angles coupees; contremarque de l'ecusson de Hollande. Au revers, cette inscription gravee a l'epoque (en 9 lignes):" ;
    crm:P102_has_title zac:BO0624_15351_lot_1552_title ;
