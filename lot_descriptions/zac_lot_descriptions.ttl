    rdfs:label "56 - PIERRE JEAN-BAPTISTE. 1715-1789. La Peinture, composition decorative." ;
    crm:P102_has_title zac:BO0624_83724_lot_56_title ;
    crm:P138i_has_representation <nan> ;
    crm:P1_is_identified_by zac:BO0624_83724_lot_56_id ;
    crm:P67i_is_referred_to_by zac:BO0624_83724_lot_56_description ;
