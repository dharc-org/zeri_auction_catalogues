zac:BO0624_15368_lot_16_title rdfs:label "Bertoido di Giovanni, geb. um 1420, gest. 1491, tatig in Florenz. - 16 Vulcan schmiedet die Waffen des Aeneas. Rechts sitzt der nackte Vulcan am Ambof. In der Mitte eine Victoria mit Schild, nach dem ein Jungling links greift. Unten links zwei Pferde. Profilierter schmaler Rand.  Bronze.Alter Guf.—Dm.62.  Bange 315.-Bode,Bertoldo S.42.  Tafel 2" .

zac:BO0624_15368_lot_17 a la:Set ;
    rdfs:label "17 - - 24 Vulcan schmiedet die Waffen des Aeneas. Rechts sitzt der nackte Vulcan am Ambof. In der Mitte eine Victoria mit Schild, nach dem ein Jungling links greift. Unten links zwei Pferde. Profilierter schmaler Rand.",
        "17 - Niccolo di Forzore Spinelli? gen. Niccolo Fiorentino 1430-1514, täatig in Florenz.  - Christus am Kreuz zwischen Maria und Johannes. Die Figuren konturiert. Tabernakelartige Umrahmung. Im Giebel Halbfigur Christi mit zwei Engelskopfchen. - Bronze. Spuren von Versilberung und Vergoldung. Original. H.114.-B.71.  Vgl.Bange 328.--Ein ahnl.Exemplar im Mus.Arch. Venedig tragt die Bezeichnung Nicolo. M. Flor Fecit." ;
    crm:P102_has_title zac:BO0624_15368_lot_17_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0624_15368!BO0624_15368_000091-p.%204.jpg/full/max/0/default.jpg>,
        <nan> ;
    crm:P1_is_identified_by zac:BO0624_15368_lot_17_id ;
    crm:P67i_is_referred_to_by zac:BO0624_15368_lot_17_description ;
    crm:P94i_was_created_by zac:creation_BO0624_15368_lot_17 .

