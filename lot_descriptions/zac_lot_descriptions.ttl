zac:83735_lot_68 a la:Set ;
    rdfs:label "Brascassat. 1805-1867. Vache au paturage." ;
    crm:P102_has_title zac:83735_lot_68_title ;
    crm:P1_is_identified_by zac:83735_lot_68_id ;
