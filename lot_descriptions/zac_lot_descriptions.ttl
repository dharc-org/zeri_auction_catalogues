zac:4482_lot_66 a la:Set ;
    rdfs:label "Pippi Jules, dit Jules Romain —1492-1546. Venus Amphitrite. La deesse est debout sur une coquille. guidant deux dauphins. Une draperie fottante,d'une teinte rosee,retenue sur le bras droit lui ceint les reins laissant le torse a decouvert. Elle tient a la main un roseau,embleme des ondes. Le nu de cette figure presente une grace et une verite d'execution qui joints a un coloris charmant constituent un tableau digne d'attention.Toile. 0.98X1.45." ;
    crm:P102_has_title zac:4482_lot_66_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/e6314b7b-13c7-42c5-ae15-040478565fff/full/full/0/default.jpg> ;
