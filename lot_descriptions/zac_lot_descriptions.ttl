zac:51192_lot_150 a la:Set ;
    rdfs:label "ATTRIBUTED TO VERROCCHIO. Florence: 1435-1488.A very beautiful head of St. John the Baptist, in wood. This work, with the wonderfully expressive face framed in long severe curls,is almost certainly the work of the master to whom it is attributed.  Purchased at the sale of the collection of M.Ravaisson-Mollien (a former director of the Musée du Louore) on the cover of the catalogue of which it is illustrated.  Ht.,12 inches.  (Illustrated.)" ;
    crm:P102_has_title zac:51192_lot_150_title ;
    crm:P1_is_identified_by zac:51192_lot_150_id ;
