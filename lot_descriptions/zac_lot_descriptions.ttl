zac:83754_lot_14 a la:Set ;
    rdfs:label "Decamps, Ale-Gabriel. Paysage d'Orient." ;
    crm:P102_has_title zac:83754_lot_14_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/4c12a376-a3e3-4e34-93e3-acb7f72f8216/full/full/0/default.jpg> ;
    crm:P1_is_identified_by zac:83754_lot_14_id ;
    crm:P67i_is_referred_to_by zac:83754_lot_14_description .

zac:83754_lot_14_description a crm:E33_Linguistic_Object ;
    rdfs:label """## 14 — Paysage d'Orient.\r
\r
Un cours d'eau encaisse entre deux rives. Sur l'une, au premier plan, deux personnages, l'un vetu de bleu, l'autre de rouge. De l'autre bord, au fond, un bouquet d'arbres se detache sur un lointain de montagnes estompees dans le bleu.\r
\r
Signe a droite, en bas, du monogramme : D. C.\r
\r
Toile. Haut. o,07 1/2.Larg.0,14""" ;
    crm:P2_has_type aat:300435416 .

