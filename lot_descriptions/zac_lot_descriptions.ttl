zac:83735_lot_102 a la:Set ;
    rdfs:label "GAVARNI, HIPPOLYTE-GUILLAUME-SULPICE CHEVALIER. 1804-1866. Pierrot." ;
    crm:P102_has_title zac:83735_lot_102_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/9f174403-ad24-44de-acf2-39691580a5c1/full/full/0/default.jpg> ;
