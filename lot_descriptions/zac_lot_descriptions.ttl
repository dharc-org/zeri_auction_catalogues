zac:BO0624_81812_lot_12 a la:Set ;
    rdfs:label "12 - Marco di Giovanni Federico. Sec. XV.(Dipingeva intorno al 1463). La Vergine col Bambino sopra un trono ornato dei quattro Evangelisti. Tempera di accuratissima esecuzione, ricche e belle le stoffe, dolce l'espressione del viso angelico della Vergine; grazioso, ben modellato il Bambino. Firmato 《 MARCUS PINXIT 》. Tabernacolo originale, scolpito policromo e dorato.Quadro importante da Galleria." ;
    crm:P102_has_title zac:BO0624_81812_lot_12_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0624_81812!BO0624_81812_000031-p.%202.jpg/full/max/0/default.jpg> ;
