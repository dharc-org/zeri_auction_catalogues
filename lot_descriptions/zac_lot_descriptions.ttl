    rdfs:label "RIGAUD. Portrait dhomme." ;
    crm:P102_has_title zac:83845_lot_188_title ;
    crm:P1_is_identified_by zac:83845_lot_188_id ;
    crm:P67i_is_referred_to_by zac:83845_lot_188_description ;
