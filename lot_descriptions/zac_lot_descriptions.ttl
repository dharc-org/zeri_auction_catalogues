zac:BO0624_4399_lot_192 a la:Set ;
    rdfs:label "192 - MEDAILLE ayant sur un face: Hercule et le lion de Nemee. Hercule,nu, de profl a gauche luttant avec le lion.Derriere lui un carquois est pendu a un arbre: a terre la massue du heros. Sur l'autre:  Jupiter et Leda.  Leda debout vetue d'une draperie fottante et d'une ceinture de fleurs,embrasse et caresse le cygne debout pres d'elle.A terre Castor et Pollux,l'un a droite,l'autre a gauche de Leda.  Bronze -XVI siecle." ;
    crm:P102_has_title zac:BO0624_4399_lot_192_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0624_4399!BO0624_4399_000171-p.%2028.jpg/full/max/0/default.jpg> ;
