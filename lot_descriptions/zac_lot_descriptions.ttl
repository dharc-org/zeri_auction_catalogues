zac:BO0624_50794_lot_143 a la:Set ;
    rdfs:label "143 - EDMOND HEDOUIN 1820, France. Soir d'ete.  Une jeune femme est assise sur un tertre au bord de l'eau; a peine couverte d'une gaze blanche, les yeux fixes au sol,le genou droit emprisonne de ses deux mains jointes, les pieds croises.  Des papillons blancs voltigent autour de la gracieuse silhouette.  A cote de la jeune femme, a droite un panier rempli de fleurs.  Des cimes d'arbres se detachent nettement sur un ciel couvert de legers. nuages.  Haut.40 larg.32." ;
    crm:P102_has_title zac:BO0624_50794_lot_143_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0624_50794!BO0624_50794_000841-p.%2072.jpg/full/max/0/default.jpg> ;
