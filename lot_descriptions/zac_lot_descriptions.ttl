zac:BO0624_4482_lot_71 a la:Set ;
    rdfs:label "71 - Sabbatini,dit《Andrea da Salerno &gt;—XVsiecle(ecole napolitaine). La Vierge et l'Enfant.  La Vierge assise, la tete portant la couronne tient 1'Enétat,primitif et ne porte les traces d'aucune restauration. Riche encadrement a medaillon circulaire en bois, decore fant sur ses genoux. Le fond est forme par une riche etoffe a dessin de palmettes. Cette peinture se trouve dans son de sculptures et de tetes d'angelots a relief. Epoque Renaissance. Bois. Diam. M. 0.93." ;
    crm:P102_has_title zac:BO0624_4482_lot_71_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0624_4482!BO0624_4482_000392-p.%2015.jpg/full/max/0/default.jpg> ;
