zac:4482_lot_81 a la:Set ;
    rdfs:label "Ecole de Sienne du XV siecle. Triptyque. Volets cuspides. Au centre: Saint Pierre assis sur le trone et portant la tiare; d'une main il benit, de 1l'autre il tient les clefs de l'Eglise. Sur le volet de gauche: Saint Antoine abbe tenant un livre et le tau ou bequille abbatiale. Sur celui de droit: Sainte Marie Madeleine qui tient dans les mains une boite a aromes. Au bas on lit l'inscription: SANTVS.ANTONIVS.ABBAS.SANTVS.PETRVS.APPOSTOLVS. SANTA MARIA MADDALENA. Au dessus:QVESTA. TAVOLA.FECE.FARE.PIETRO.DI GIOVANI.RIO. puis le sigle CLAO 1438. Bois. 1.35X1.43" ;
    crm:P102_has_title zac:4482_lot_81_title ;
    crm:P1_is_identified_by zac:4482_lot_81_id ;
    crm:P67i_is_referred_to_by zac:4482_lot_81_description .

zac:4482_lot_81_description a crm:E33_Linguistic_Object ;
    rdfs:label """2\r
