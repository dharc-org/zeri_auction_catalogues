zac:4671_lot_63 a la:Set ;
    rdfs:label "PETITE PENDULE. Sur socle en bronze dore,a frise ciselee et ajouree s'elevent trois arbrissaux,et entre les branches de celui du milieu est pose le cadran,de chaque cote et sur le devant une figurine chinoise en ronde bosse, vernie en couleurs et doree representant la Richesse et la Pauvrete. Mouvement par Pia-Paris. Epoque Louis XV. Piece remarquable." ;
    crm:P102_has_title zac:4671_lot_63_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/1d2f59dd-9720-4cf3-b5d3-ec382d893f67/full/full/0/default.jpg> ;
