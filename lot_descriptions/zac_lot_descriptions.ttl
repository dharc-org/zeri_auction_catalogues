zac:23222_lot_314 a la:Set ;
    rdfs:label "Desgl., eine kleine goldene Scheibenfibel mit sechs Bronzenieten auf der. bronzenen Unterlage befestigt. Zwischen den Nieten drei runde, blaue Steine abwechselnd mit drei Almandinen in dreieckiger Fassung. In der Mitte ein hellgriner Halbedelstein.Das ganze Feld mit kleinen Filigranringen bedeckt.D. 4.- Zwei kleine, goldene Anhangsel.-Zwei silberne Ohrringe, das eine Ende des Drahtes mit einer konischen Perle verziert. Eine Bronzenadel.Eine Bronzegurtelschnalle. Eine Hornnadel.-Ein Handkihler aus Kristall—Eine Perlkette.-Eine Schere.-—Ein Messer. Sinzig. Abb. Tafel 7." ;
    crm:P102_has_title zac:23222_lot_314_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/de64dc67-1b66-4643-8662-b7c76adf33de/full/full/0/default.jpg> ;
