zac:BO0624_4482_lot_36 a la:Set ;
    rdfs:label "36 - Ecole hollandaise. Caravane traversant un ravin. Dans un paysage abrupt une troupe serree en colonne gravit un monticule. Un ane fechit sous le poids de son bat, d'ou s'echappent divers ustensiles de menuisier. Un chasseur portant du gibier et suivi de son chien, ferme la marche. Quelques monuments en ruines et une ville que l'on apercoit dans le lointain completent le paysage. Bois. Cadre dore." ;
    crm:P102_has_title zac:BO0624_4482_lot_36_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0624_4482!BO0624_4482_000361-p.%208.jpg/full/max/0/default.jpg> ;
