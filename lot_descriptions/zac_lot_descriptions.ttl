zac:65735_lot_88 a la:Set ;
    rdfs:label "JEAN IER PENIcAUD. Tri pt y q uie. Le volet du milieu represente l Adoration des trois Rois Mages. On voit l'etable oi la Vierge presente a ladoration d'un Mage l Enfant qui est sur ses genoux.Les deux autres Mages debout saluespar saint Joseph.Par louverture de letable on apergoitune suitenombreuse etl'encolurededeuxchevaux." ;
    crm:P102_has_title zac:65735_lot_88_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/8b1392f8-7a7e-4937-9ef9-5078702f38ab/full/full/0/default.jpg> ;
