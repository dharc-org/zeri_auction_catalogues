    rdfs:label """- 136.PoRTRAIT du celebre physicien Louis Gal. vani,dbout,a demifgure,tournepresqu deface;la main gauche sur un livre ouvert pose sur une petite table. De la droite il prise dans une tabatiere placee pres du\r
- livre.Toile ovale.Cadre dore.\r
\r
Diametre max. 1.10.\r
\r
》\r
\r
min.o.84.\r
\r
## \r
\r
##""" ;
    crm:P2_has_type aat:300435416 .

