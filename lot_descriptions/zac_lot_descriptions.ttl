zac:1003_lot_98 a la:Set ;
    rdfs:label "GUINOT (Eugene). L'Ete a Badc, par M. Eugene Guinot, illustre par MM. Tony Johannot, Eug.Lami,Francais et Jacquemot. Paris, Furne et Cie,Ernest Bourdin, s.d.(1847),gr. in-8, mar. citron,enc. de fil. a froid sur le dos et les plats, double de mar. vert clair, doubl. bord. de 4 fil. maigres croises. formant losange et comp. d'angles, avec orn. de rinceaux sur le fond pointille en or et milieux mos., a l'int., gardes de moire verte, tete dor., tr. ebarb., couv. cons. (Debes)." ;
    crm:P102_has_title zac:1003_lot_98_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/0f16f19c-52d8-44df-acc2-a015247ccff9/full/full/0/default.jpg> ;
