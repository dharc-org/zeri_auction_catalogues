    rdfs:label "PIETRO LORENZETTI  SIENESE:1306—1348. TRIPTYCH:MADONNA,CHILD AND SAINTS N COLLABORATION WITH MARIOTTO ALBERTINELLI" ;
    crm:P102_has_title zac:5750_lot_48_title ;
    crm:P1_is_identified_by zac:5750_lot_48_id ;
