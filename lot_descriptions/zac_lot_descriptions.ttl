zac:81823_lot_290 a la:Set ;
    rdfs:label "STUPENDo SARcoFAGO perfettamente conservato, in marmo greco. Sul frontone due Vittorie reggono la targa per l'iscrizione (che era dipinta). Ai lati due amorini con ghirlande. Sotto la targhette due cornucopie ed un cesto con frutta.In terra due aliri cesti e due foglie di palma.Ai lati del sarcofago, due grifi. Sul coperchio sei putti che reggono le ghirlande. Ai lati del coperchio due teste barbate. Epoca di Traiano." ;
    crm:P102_has_title zac:81823_lot_290_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/9ad32486-bfe2-424c-a2cb-ff34926b154c/full/full/0/default.jpg> ;
