    rdfs:label "JEAN-ANTOINE WATTEAU  (Valenciennes 1684-Nogent-sur-Marne 1721). Portrait d'une femme-peintre." ;
    crm:P102_has_title zac:65735_lot_47_title ;
    crm:P1_is_identified_by zac:65735_lot_47_id ;
