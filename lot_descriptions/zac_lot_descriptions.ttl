zac:83735_lot_54 a la:Set ;
    rdfs:label "ECOLE FRANCAISE. Portrait de femme." ;
    crm:P102_has_title zac:83735_lot_54_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/7d27791e-7eb0-4e97-bb6b-6e75fc5b5bf5/full/full/0/default.jpg> ;
