    rdfs:label "ECOLE FRANCAISE. Portrait de Louis XIV." ;
    crm:P102_has_title zac:83734_lot_78_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/bfdd2029-da89-4a53-a7e8-d78d78489588/full/full/0/default.jpg> ;
