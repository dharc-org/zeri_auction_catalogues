zac:4399_lot_352 a la:Set ;
    rdfs:label "GROs ANNEAU papal en bronze dore, orne surles cotes des emblemes desEvangelistes et de la Papaute en relief;dans la partie inferieure du cercle est gravee linscription:PIUS|PAPA|SECUN DUS. Dans le chaton un rectangle en serpentin." ;
    crm:P102_has_title zac:4399_lot_352_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/3f585654-2091-42fa-a55a-a36a7432cbc3/full/full/0/default.jpg> ;
