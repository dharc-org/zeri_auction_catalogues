    rdfs:label "71 - Adriaen Hendriksz Verboom (geb.zu Amsterdam 1628, gest. daselbst nach 1667). Landschaft bei Abendstimmung." ;
    crm:P102_has_title zac:BO0614_87918_lot_71_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0614_87918!BO0614_87918_000111-p.%2014.jpg/full/max/0/default.jpg> ;
