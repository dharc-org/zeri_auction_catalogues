zac:51192_lot_96_id a crm:E42_Identifier ;
    rdfs:label "BO0624_51192-96" .

zac:51192_lot_96_title rdfs:label "IMPORTANT BRONZE GROUP. Greek, c. IVth. century B.C. Two wrestlers, finely and powerfully modelled. A bearded man stands upright, holding by the wrist and shoulder a younger man whom he has forced to the ground. Rich green patina." .

zac:51192_lot_97 a la:Set ;
    rdfs:label "BRONZE MIROR-CASE. Vth.century B.C. With handle. On the cover is an embossed relief, representing a winged figure, seated before an incense burner, upon which with her right hand she pours incense, from a thurible or incense-box in her left hand. She wears a long chiton, and himation over the lower limbs, and her hair is tied in a knot behind her head. On the left, a winged figure of a youth, nude, proffers a bowl." ;
    crm:P102_has_title zac:51192_lot_97_title ;
    crm:P1_is_identified_by zac:51192_lot_97_id ;
    crm:P2_has_type <http://w3id.org/zac/type/bronzi> ;
    crm:P67i_is_referred_to_by zac:51192_lot_97_description .

zac:51192_lot_97_description a crm:E33_Linguistic_Object ;
    rdfs:label """- 97—BRONZE MIROR-CASE.\r
\r
Ht., 7 inches. IVth.century B.C.\r
\r
With handle. On the cover is an embossed relief, representing a winged figure, seated before an incense burner, upon which with her right hand she pours incense, from a thurible or incense-box in her left hand. She wears a long chiton, and himation over the lower limbs, and her hair is tied in a knot behind her head. On the left, a winged figure of a youth, nude, proffers a bowl.""" ;
    crm:P2_has_type aat:300435416 .

zac:51192_lot_97_id a crm:E42_Identifier ;
    rdfs:label "BO0624_51192-97" .

zac:51192_lot_97_title rdfs:label "BRONZE MIROR-CASE. Vth.century B.C. With handle. On the cover is an embossed relief, representing a winged figure, seated before an incense burner, upon which with her right hand she pours incense, from a thurible or incense-box in her left hand. She wears a long chiton, and himation over the lower limbs, and her hair is tied in a knot behind her head. On the left, a winged figure of a youth, nude, proffers a bowl." .

zac:51192_lot_98 a la:Set ;
    rdfs:label "SMALL BRONZE STATUETTE. Greco-E gyptian.  A young priest, wearing a pleated tunic, and a drapery passing over his head. The right hand rests with an easy movement on the hip.  Ht.,3 7/8 inches." ;
    crm:P102_has_title zac:51192_lot_98_title ;
    crm:P1_is_identified_by zac:51192_lot_98_id ;
    crm:P2_has_type <http://w3id.org/zac/type/bronzi> ;
    crm:P67i_is_referred_to_by zac:51192_lot_98_description .

zac:51192_lot_98_description a crm:E33_Linguistic_Object ;
    rdfs:label """- 98\r
\r
Diameter,6 1/2 inches.\r
\r
## 3-SMALL BRONZE STATUETTE. Greco-E gyptian.\r
\r
A young priest, wearing a pleated tunic, and a drapery passing over his head. The right hand rests with an easy movement on the hip.\r
\r
Ht.,3 7/8 inches.\r
\r
From the Sambon collection.(Sale in Paris, 1914.)\r
\r
- 一 \r
\r
## 99\r
## — 10O""" ;
    crm:P2_has_type aat:300435416 .

