zac:BO0624_51192_lot_10 a la:Set ;
    rdfs:label "10 - ARCHAIC GREEK KRATER.  VIth.century B.C.  Decoration in black and purple on red, representing on each side a pair of naked runners, with two umpires.  Ht.,5 inches;Diameter,7inches.  (Illustrated.)" ;
    crm:P102_has_title zac:BO0624_51192_lot_10_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0624_51192!BO0624_51192_000152-p.%20[7].jpg/full/max/0/default.jpg> ;
