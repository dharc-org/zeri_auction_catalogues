zac:5750_lot_11 a la:Set ;
    rdfs:label "SIMONE DA BOLOGNA  Bologna,XIV Century. THE CRUCIFIXION. Vigorous rendering of this subject. Our Lord is seen crucified between the two thieves, with the symbolic pelican above; mounted, and other figures are seen on either side, with St. John supporting the distressed Mother. Very interesting frame, having cruciform pinnacles with representation of Christ and two saints.  Panel:Height,24 inches; width,131/ inches." ;
    crm:P102_has_title zac:5750_lot_11_title ;
    crm:P1_is_identified_by zac:5750_lot_11_id ;
