zac:15351_lot_1794 a la:Set ;
    rdfs:label "JETONS HISTORIQUES.- COLLECTIONS DE PIECES DES XVIeET XVIIe SIECLES, PUIS QUELQUES PIECES DU XVIHIe.-PLUS DE PIECES. Cuivre." ;
    crm:P102_has_title zac:15351_lot_1794_title ;
    crm:P1_is_identified_by zac:15351_lot_1794_id ;
    crm:P67i_is_referred_to_by zac:15351_lot_1794_description .

zac:15351_lot_1794_description a crm:E33_Linguistic_Object ;
    rdfs:label """- 1794 JETONS HISTORIQUES.- COLLECTIONS DE PIECES DES XVIeET XVIIe SIECLES, PUIS QUELQUES PIECES DU XVIHIe.-PLUS DE - 300 PIECES. Cuivre.\r
\r
Collection interessante,contenant surtout des pieces de Pepoque de la GUERRE DES PAYS-BAS AVECLESPAGNE,AU XVIE SIECLE,pieces frappees aAnvers,a Utrecht,a Middelbourg, etc.\r
\r
Ces jetons sont surtout recherches pour la representation naive des grands faits militaires et politiques de lepoque. Dans notre collection ces pieces sont en general tres belles; les belles pieces de cette epoque commencent a se faire rares.-Quelques doubles.""" ;
    crm:P2_has_type aat:300435416 .

