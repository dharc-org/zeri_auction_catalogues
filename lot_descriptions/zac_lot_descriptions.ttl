    rdfs:label "Decamps, Ale-Gabriel. Paysan italien." ;
    crm:P102_has_title zac:83754_lot_10_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/ad5fa7f2-317e-4adf-b43e-a18335d923f8/full/full/0/default.jpg> ;
