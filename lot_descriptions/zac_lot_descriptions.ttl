zac:BO0624_81812_lot_28_description a crm:E33_Linguistic_Object ;
    rdfs:label "28. Rosa Salvatore. Sec. XVII. Paesi con figure. Due dipinti su tela, disegnati con vigore, dipinti con sicurezza.Bellissimi. Cornici legno scolpito e dorato.Alt.cm.20, larg. cm.26. 30. Castiglione (Giovanni Benedetto da) detto il Greghetto.Sec.XVII. Scena pastorale. Dipinto chiaro e piacevole, spigliato e corretto nel disegno, di fresco colorito e graziosa composizione. Tela. Cornice legno dorato.Alt.cm.58,larg.cm.73. 29. Rosa Salvatore. Sec. XVII. Paesaggio con marina e figure. Tela, vigorosa. Buon colorito. Cornice legno dorato. Alt. cm. 50, larg. cm. 37." ;
    crm:P2_has_type aat:300435416 .

zac:BO0624_81812_lot_28_id a crm:E42_Identifier ;
    rdfs:label "BO0624_81812-28" .

zac:BO0624_81812_lot_28_title rdfs:label "Rosa Salvatore. Sec. XVII. Paesi con figure. Due dipinti su tela, disegnati con vigore, dipinti con sicurezza.Bellissimi. Cornici legno scolpito e dorato.Alt.cm.20, larg. cm.26. Castiglione (Giovanni Benedetto da) detto il Greghetto.Sec.XVII. Scena pastorale. Dipinto chiaro e piacevole, spigliato e corretto nel disegno, di fresco colorito e graziosa composizione. Tela. Cornice legno dorato.Alt.cm.58,larg.cm.73. Rosa Salvatore. Sec. XVII. Paesaggio con marina e figure. Tela, vigorosa. Buon colorito. Cornice legno dorato. Alt. cm. 50, larg. cm. 37." .

