zac:1003_lot_131 a la:Set ;
    rdfs:label "NORVINS. Histoire de Napoleon. Vignettes par Raffet. Paris, Furne, 1839, in-8, front. gr. sur acier, 8o pl. h. texte et vign. dans le texte gr. sur bois, dos et coins mar. violet, non rogne, couv." ;
    crm:P102_has_title zac:1003_lot_131_title ;
    crm:P1_is_identified_by zac:1003_lot_131_id ;
