zac:BO0624_4482_lot_13_description a crm:E33_Linguistic_Object ;
    rdfs:label """13. Portrait de jeune femme.\r
\r
Assise dans un fauteuil; le bras gauche pose sur l'accotoir, la main droite sur une table. Les cheveux coupes courts sont boucles et d'un blond roux. Elle porte une magnifique robe en brocart blanc et or; au cou une collerette tuyautee; en sautoir, une grosse chaine d'orfevrerie. Le fond est forme par 1.23X0.85. une draperie rouge. Toile. Cadre dore.\r
## Van Dyck Antoine —159g-1641(copie ancienne d’apres).""" ;
    crm:P2_has_type aat:300435416 .

zac:BO0624_4482_lot_13_id a crm:E42_Identifier ;
