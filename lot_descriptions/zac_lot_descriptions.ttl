zac:65729_lot_11 a la:Set ;
    rdfs:label "EUGENE DELACROIX. TIGRE JOUANT AVEC UNE TORTUE l est vu de profl, allant vers la droite. l a pose les griffes sur une tortue. Paysage boise, montagneux au lointain sous un ciel bleu." ;
    crm:P102_has_title zac:65729_lot_11_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/506e9a61-43ff-4a4d-be76-bfed7c063046/full/full/0/default.jpg> ;
    crm:P1_is_identified_by zac:65729_lot_11_id ;
    crm:P67i_is_referred_to_by zac:65729_lot_11_description ;
    crm:P94i_was_created_by zac:creation_65729_lot_11 .

zac:65729_lot_11_description a crm:E33_Linguistic_Object ;
    rdfs:label """Il est vu de profl, allant vers la droite. l a pose les griffes sur une tortue. Paysage boise, montagneux au lointain sous un ciel bleu.\r
\r
Oeuvre magistrale du maitre.\r
\r
Signe Delacroix,1862.\r
\r
Collection Johann Meyer de Dresde.\r
\r
Toile.-Hauteur 46, largeur 63 centimetres.\r
\r
Voir: A. Robaut et E. Chesneau,,L'ceuvre complete de Delacroix no. 1352 ou il decrit ce tableau en ajoutant: ,Appartenait a M. Fanien, en 1872. Non catalogue par Moreau. Puis plus loin:,Pour donner plus de relief et d'expression dans le mouvement a ses animaux, Eug.Delacroix les peint comme s'il les voyait non pas de loin,parce qu'alors ,les profils se confondent pour ainsi dire dans un plan geometral,mais de pres et en ,plongeant le regard d tantot au-dessus, tantot au dessous du modele. Il obtient ainsi ,des lignes qui se penetrent en sens divers et s'enveloppent de maniere a preciser les ,accents de la forme et a augmenter l'ampleur."\r
\r
Voir la reproduction.\r
\r
## P.DELAROCHE""" ;
    crm:P2_has_type aat:300435416 .

zac:65729_lot_11_id a crm:E42_Identifier ;
    rdfs:label "BO0624_65729-11" .

