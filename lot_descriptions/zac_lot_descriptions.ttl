zac:1003_lot_290 a la:Set ;
    rdfs:label "RICHEPIN (Jean). La Chanson des Gueux. Illustrations de A. Morand. S. l. n. d., gr. in-8, mar. violet fonce, le premier plat orne au centre d'une composition en medaillon,incisee et peinte,representant une tete de vieillard miserable;a l'int.,large encadr. de mar. orne d'une bande de mar.mauve et de fil. dor., double et gardes de soie brochee, doubles gardes, tr. dor., couverture, etui (Lanoe)." ;
    crm:P102_has_title zac:1003_lot_290_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/9959c98f-db54-46b0-a497-ec2d60a00ef5/full/full/0/default.jpg> ;
