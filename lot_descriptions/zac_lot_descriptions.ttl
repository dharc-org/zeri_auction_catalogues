zac:44452_lot_298 a la:Set ;
    rdfs:label "Achteckige Dose mit reichen Gravirnngen und vergoldet, darauf sichtbar eine Uhr und daneben die bewegliche Unruh, zwischen beiden oben eine fein geschnittene Elfenbeinplatte mit Einfassung. Auf der Ruckseite werden durch ein Uhrwerk verschiedene Figuren aus Silber, Angler, Holzhacker, Bergmann, Wassermihle etc. in Bewegung gesetzt, als Staffage eine Burg auf Felsen u. Baumen aus Elfenbein auf schwarzem Grund. Franzosische Arbeit. Louis XVI. Grosse 91/2:6 im Etuis." ;
    crm:P102_has_title zac:44452_lot_298_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/9a0f996b-7e4a-44b8-9786-cf5f0ac58b38/full/full/0/default.jpg> ;
