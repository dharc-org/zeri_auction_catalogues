zac:BO0624_4482_lot_21_description a crm:E33_Linguistic_Object ;
    rdfs:label """- 2 1. L'achat des provisions.\r
\r
Une femme vetue du costume des paysannes famandes est debout; un panier au bras; elle tient dans chaque main un couple de poulets. Une seconde femme est assise pres d'une cage a volaille et s'assure de la grosseur de quelques canards places devant elle. Un homme portant sur sa tete un baquet, forme le troisieme personnage de cette composition d'un groupement pittoresque et ou la verite de la nature morte est rendue par excellence. Bois. 1.95X1.02.""" ;
    crm:P2_has_type aat:300435416 .

zac:BO0624_4482_lot_21_id a crm:E42_Identifier ;
    rdfs:label "BO0624_4482-21" .

zac:BO0624_4482_lot_21_title rdfs:label "Snyders Francois—1579-1657. L'achat des provisions. Une femme vetue du costume des paysannes famandes est debout; un panier au bras; elle tient dans chaque main un couple de poulets. Une seconde femme est assise pres d'une cage a volaille et s'assure de la grosseur de quelques canards places devant elle. Un homme portant sur sa tete un baquet, forme le troisieme personnage de cette composition d'un groupement pittoresque et ou la verite de la nature morte est rendue par excellence. Bois. 1.95X1.02." .

zac:BO0624_4482_lot_22 a la:Set ;
    rdfs:label "22 - Snyders Francois—1579-1657.  La Cuisiniere. Une femme famande debout pres d'une haute cheminee en pierre, prepare la broche ou sont enfles plusieurs poulets et un quartier de mouton. Pres d'elle un tabouret, differentes terrines et des ecailles d'huitres jetees sur le carrelage. Bois. 1.60X0.80." ;
    crm:P102_has_title zac:BO0624_4482_lot_22_title ;
    crm:P138i_has_representation <nan> ;
    crm:P1_is_identified_by zac:BO0624_4482_lot_22_id ;
    crm:P67i_is_referred_to_by zac:BO0624_4482_lot_22_description ;
    crm:P94i_was_created_by zac:creation_BO0624_4482_lot_22 .

