    rdfs:label "42 - Pieter de Molyn (geb. zu London um 1600, gest.zu Haarlem 1661). Landschaft." ;
    crm:P102_has_title zac:BO0614_87918_lot_42_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0614_87918!BO0614_87918_000082-p.%209.jpg/full/max/0/default.jpg> ;
