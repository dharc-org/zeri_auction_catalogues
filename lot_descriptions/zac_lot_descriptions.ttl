zac:BO0624_23222_lot_312 a la:Set ;
    rdfs:label "312 - Desgl, eine groBe, goldene Scheibenfibel. Die Scheibe wird durch einen kreisformigen Wulst in ein auBeres und ein Mittelfeld geteilt. Im AuBenfeld erheben sich innerhalb eines von verschlungenem Filigranmuster gebildeten Randes sechs getriebene Buckel mit kreuzformig gelegter Filigranringverzierung. In den Zwischenraumen sind sechs mit der Spitze nach innen gerichtete, von feinem Filigrandraht gebildete und mit kleinen Kreisen gefuilte Dreiecke angeordnet. In dem mit feinem Filigranmuster bedeckten Mittelfeld sitzt in hoher Zwei bronzene Ohrringe. An einem Ende des Drahtes kubische Verdickung aus Gold mit Almandineinlage. Ein Bronzering.Ein verziertes,durchbrochenes Schnallchen. Zwei Sandalenschnallchen.- Zwei Riemenzungen.-— Eine Perlkette.-— Ein Dolch. Abb.Tafel 7. Ochtendung." ;
    crm:P102_has_title zac:BO0624_23222_lot_312_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0624_23222!BO0624_23222_000121-p.%2018.jpg/full/max/0/default.jpg> ;
    crm:P1_is_identified_by zac:BO0624_23222_lot_312_id ;
    crm:P2_has_type <http://w3id.org/zac/type/oggetti_in_ferro> ;
    crm:P67i_is_referred_to_by zac:BO0624_23222_lot_312_description .

