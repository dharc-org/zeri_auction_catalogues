zac:BO0624_4399_lot_307 a la:Set ;
    rdfs:label "307 - ENCRIER de style gothique en faience coloriee de Faenza. Sur une base polygonale sont assises quatre f figures:la Prudence,la Justice,la Temperance et la Force, separees par quatre petits encriers. Piece tres rare a cause surtout de l'epoque reculee de sa fabrication,remontant a la moitie du XVe siecle, epoque primi tive ou predomine la zaffera dans la co loration; par la valeur artistique de son style et enfin par le caractere symbolique des figures correspondant au but moral et philosophique de l'ecrivain." ;
    crm:P102_has_title zac:BO0624_4399_lot_307_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0624_4399!BO0624_4399_000231-p.%2040.jpg/full/max/0/default.jpg> ;
    crm:P1_is_identified_by zac:BO0624_4399_lot_307_id ;
    crm:P67i_is_referred_to_by zac:BO0624_4399_lot_307_description .

zac:BO0624_4399_lot_307_description a crm:E33_Linguistic_Object ;
    rdfs:label """2. 307.ENCRIER de style gothique en faience coloriee de Faenza. Sur une base polygonale sont assises quatre f figures:la Prudence,la Justice,la Temperance et la Force, separees par quatre petits encriers. Piece tres rare a cause surtout de l'epoque reculee de sa fabrication,remontant a la moitie du XVe siecle, epoque primi tive ou predomine la zaffera dans la co loration; par la valeur artistique de son style et enfin par le caractere symbolique des figures correspondant au but moral et philosophique de l'ecrivain.\r
\r
Haut. o.27-Larg.o.29.\r
\r
Voirillustration,planche31.""" ;
    crm:P2_has_type aat:300435416 .

