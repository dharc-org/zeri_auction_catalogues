zac:87918_lot_72 a la:Set ;
    rdfs:label "Esaias van de Velde (geb. zu Amsterdam vor 1590, gest.zu Leiden 1630). Rast im Walde." ;
    crm:P102_has_title zac:87918_lot_72_title ;
    crm:P1_is_identified_by zac:87918_lot_72_id ;
    crm:P67i_is_referred_to_by zac:87918_lot_72_description ;
    crm:P94i_was_created_by zac:creation_87918_lot_72 .

zac:87918_lot_72_description a crm:E33_Linguistic_Object ;
    rdfs:label """## 72 Rast im Walde.\r
\r
Auf Leinwand. Hohe 66 cm,Breite 8o cm.In Goldrahmen.\r
\r
## Esaias van de Velde\r
\r
geb. zu Amsterdam vor 159o, gest.zu Leiden 1630.\r
\r
Drei Reiter stehen im Gesprache beisammen, rechts ist einer der Reiter abgestiegen, links sitzt ein leute aus dem Gefolge,einer derselben ist ihnen, gleichsam Ausschau haltend,vorangeritten.Blauer, leicht bewolkter Himmel.\r
\r
Auf dem einen Baumstamme links bez:E.v.Velde 1619.\r
\r
Abbildung siehe Tafel 24.\r
\r
## Markt am Wall.\r
\r
Vor dem Wallgraben spielt sich ein Handel mit Rindern ab. Viele Bauern stehen zwischen den Tieren; vorne bekraftigen zwei Manner den Kauf mit Handschlag, daneben balgen sich Kinder, ein Burgersmann mit seiner Frau steht zusehend dabei. Links treibt eine Bauerin eine Kuh, die ein Bauer am Strick fihrt. Uber die Fallbricke links treibt ein Mann zwei Schweine; aus dem Stadttore schreiten zwei Ratsherren heraus. An der rechten Seite des Wassers stehen hohe Hauser. Regenwolken bedecken strichweise den Himmel.\r
\r
Abbildung siehe Tafel 24.\r
\r
Auf Holz. Hohe 5o cm,Breite 75 cm. In schwarzem Rahmen.\r
\r
##""" ;
    crm:P2_has_type aat:300435416 .

zac:87918_lot_72_id a crm:E42_Identifier ;
    rdfs:label "BO0614_87918-72" .

zac:87918_lot_72_title rdfs:label "Esaias van de Velde (geb. zu Amsterdam vor 1590, gest.zu Leiden 1630). Rast im Walde." .

