zac:BO0624_50794_lot_69 a la:Set ;
    rdfs:label "69 - GASPARD DUGHET DIT POUSSIN 1613-1675. Paysage d'automne. Une femme a cheval descend de la colline sur une route bordee d'arbres touffus; un homme, a peine vetu d'une blouse, court apres elle et semble vouloir i'arreter. Vers le centre, une autre femme, appuyee sur un baton et suivie d'un enfant et d'un petit chien, gravit la colline et se dirige vers la ville que l'on apercoit dans le fond du tableau sur une hauteur. Une tourelle se dresse a gauche sur un monticule plante d'arbres.  Un ruisseau serpente dans la prairie et se perd dans le lointain.  Le soleii eclaire ce riant paysage." ;
    crm:P102_has_title zac:BO0624_50794_lot_69_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0624_50794!BO0624_50794_000411-p.%2038.jpg/full/max/0/default.jpg> ;
    crm:P1_is_identified_by zac:BO0624_50794_lot_69_id ;
    crm:P67i_is_referred_to_by zac:BO0624_50794_lot_69_description ;
    crm:P94i_was_created_by zac:creation_BO0624_50794_lot_69 .

