zac:BO0624_15351_lot_1552_description a crm:E33_Linguistic_Object ;
    rdfs:label """- 1552 l'epoque (en 9 lignes):\r
\r
## (Harlem,Suite).\r
\r
- Velddaalder. Type au globe imperial; carre, aux angles coupees; contremarque de l'ecusson de Hollande. Au revers, cette inscription gravee a\r
\r
GHECOME ENDEN 13IVLYAN 73 IS DIE STATINHANDEVAN\r
\r
DONFREDRICKOGELEVERT OP HAERLEM SYN GESCHOTEN 10402 SCHOTEN. A.""" ;
    crm:P2_has_type aat:300435416 .

