zac:87918_lot_68 a la:Set ;
    rdfs:label "Unbekannt. Flamische Landschaft mit reicher figirlicher Staffage. 17. Jahrhundert." ;
    crm:P102_has_title zac:87918_lot_68_title ;
    crm:P1_is_identified_by zac:87918_lot_68_id ;
    crm:P67i_is_referred_to_by zac:87918_lot_68_description .

zac:87918_lot_68_description a crm:E33_Linguistic_Object ;
    rdfs:label """## 68 Flamische Landschaft mit reicher figirlicher Staffage. 17. Jahrhundert. Im Vordergrunde zahlreiche Bauersleute, welche ihre Waren zum Markte zu tragen scheinen; die Mehrzahl derselben hat bereits Rast gemacht. Rechts dicht belaubter Wald, aus dem sich soeben ein mit zwei Pferden bespannter und mit Fassern beladener zweiraderiger Karren dem Vordergrunde nahert, wahrend im Mittelgrunde des Waldes Hirten ihre Herden treiben. Vorne rechts Gewasser mit Enten.Links Ausblick auf die von einem Flusse durchzogene weite Ebene mit Stadt. Den Hintergrund schlieBen Hohenzige ab.\r
\r
Abbildung siehe Tafel 22.\r
\r
Auf Leinwand. Hohe 61 cm, Breite 81 cm. In Goldrahmen.""" ;
    crm:P2_has_type aat:300435416 .

