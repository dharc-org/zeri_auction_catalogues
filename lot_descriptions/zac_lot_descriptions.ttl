zac:83734_lot_77 a la:Set ;
    rdfs:label "ECOLE FRANCAISE. Portrait d'un Tabellion." ;
    crm:P102_has_title zac:83734_lot_77_title ;
    crm:P1_is_identified_by zac:83734_lot_77_id ;
    crm:P67i_is_referred_to_by zac:83734_lot_77_description .

zac:83734_lot_77_description a crm:E33_Linguistic_Object ;
    rdfs:label """77\r
\r
## TABLEAUX ANCIENS\r
\r
## ECOLE FRANCAISE\r
\r
(xvle siecle)\r
\r
## —Portrait d'un Tabellion. Il est vu de face, en perruque poudree, vetu d'un habit dont les manches et le col sont ornes de dentelles. Le menton appuye sur la main gauche, installe dans un large fauteuil devant son bureau muni d'un encrier aux godets de porcelaine; il annote un registre.\r
\r
Toile.Haut.,1 m.10 cent.;larg.,80 cent.\r
\r
## ECOLE FRANCAISE\r
\r
(xvr siecle)""" ;
    crm:P2_has_type aat:300435416 .

