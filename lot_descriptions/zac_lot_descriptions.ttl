zac:83754_lot_25 a la:Set ;
    rdfs:label "Decamps, Alexandre-Gabriel.  L'Heure de la soupe." ;
    crm:P102_has_title zac:83754_lot_25_title ;
    crm:P1_is_identified_by zac:83754_lot_25_id ;
    crm:P67i_is_referred_to_by zac:83754_lot_25_description .

zac:83754_lot_25_description a crm:E33_Linguistic_Object ;
    rdfs:label """## 25 — L'Heure de la soupe.\r
\r
Assise, pieds nus sur la pierre de l'atre, une jeune mere tient sur ses genoux son bebe coiffe d'un bonnet a trois pieces. Elle surveille la soupe qui bout dans un rechaud devant le feu roux, au-dessus duquel une marmite est suspendue a une cremaillere. Un chat ronronne aupres. A gauche,un berceau.Au fond,une armoire-buffet, sur laquelle trainent du linge et des ustensiles de menage.\r
\r
Signe en bas, au milieu.\r
\r
Aquarelle. Haut. o,16, Larg.o,21.\r
## DECAMPS\r
\r
(ALEXANDRE-GABRIEL)""" ;
    crm:P2_has_type aat:300435416 .

