zac:BO0614_87918_lot_69_description a crm:E33_Linguistic_Object ;
    rdfs:label """## 69\r
\r
## 73\r
\r
## Gegenstick zum Vorigen.\r
\r
Ahnliche Anordnung wie beim vorigem Bilde, doch liegt hier die Waldpartie links,wahrend die Ebene mit Stadt an einem Flusse rechts liegt. Auch hier Hohenzige als Abschluf des Hintergrundes.\r
\r
Ebenfalls reiche figirliche Staffage.\r
\r
Abbildung siehe Tafel 22.""" ;
    crm:P2_has_type aat:300435416 .

zac:BO0614_87918_lot_69_id a crm:E42_Identifier ;
    rdfs:label "BO0614_87918-69" .

