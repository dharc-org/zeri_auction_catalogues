zac:BO0624_44631_lot_50 a la:Set ;
    rdfs:label "50 - VITRAIL rectangulaire,en couleurs,aux armes de la ville de Brisach.  L'écusson est soutenu par saint Gervais et saint Protais,debout,l'un tenant unmartinet,l'autreune epee.  Sur les nimbes dores, les noms de chaque personnage. Encadrement forme de pilastres canneles surmontes d'une frise cintree,executee en grisaille et representant une scene de peche.  A la partie inferieure l'inscription en lettres gothiques : Stat Brisach nmo 1521.  Travail Balois. Suisse.xvi siecle." ;
    crm:P102_has_title zac:BO0624_44631_lot_50_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0624_44631!BO0624_44631_000211-p.%2026.jpg/full/max/0/default.jpg> ;
