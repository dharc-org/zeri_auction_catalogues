zac:15268_lot_4 a la:Set ;
    rdfs:label "FIGURINE en bronze patine, fondue a cire perdue. Italie, xve siecle." ;
    crm:P102_has_title zac:15268_lot_4_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/1899f17d-37c1-4609-8726-199143200acd/full/full/0/default.jpg> ;
    crm:P1_is_identified_by zac:15268_lot_4_id ;
    crm:P2_has_type <http://w3id.org/zac/type/bronzi> ;
    crm:P67i_is_referred_to_by zac:15268_lot_4_description .

zac:15268_lot_4_description a crm:E33_Linguistic_Object ;
    rdfs:label """- 一 FiGuRINE en bronze patine, fondue a cire perdue. Italie, xve siecle.\r
\r
Un chasseur a demi-nu, assis sur un tertre, appuie sa tete dans la main gauche; il est accoude a un tronc d'arbre et semble dormir.Un chien place sous sa jambe gauche parait surveiller un sanglier mort, etendu aupres de lui, sous le pied droit du chasseur. Base en marbre noir.\r
\r
Haut. du bronze:10 cent.""" ;
    crm:P2_has_type aat:300435416 .

zac:15268_lot_4_id a crm:E42_Identifier ;
    rdfs:label "BO0624_15268-4" .

zac:15268_lot_4_title rdfs:label "FIGURINE en bronze patine, fondue a cire perdue. Italie, xve siecle." .

zac:15268_lot_5 a la:Set ;
    rdfs:label "STATUETTE sur socle adherent moulure;bronze" ;
    crm:P102_has_title zac:15268_lot_5_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/cd5cf505-13b6-4b70-81b8-2d55587f3320/full/full/0/default.jpg> ;
