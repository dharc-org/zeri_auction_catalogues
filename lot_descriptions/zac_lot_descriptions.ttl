    crm:P1_is_identified_by zac:BO0624_4482_lot_2_id ;
    crm:P67i_is_referred_to_by zac:BO0624_4482_lot_2_description ;
    crm:P94i_was_created_by zac:creation_BO0624_4482_lot_2 .

zac:BO0624_4482_lot_20 a la:Set ;
    rdfs:label "20 - Rubens Pierre-Paul - 1577-1640. La Musique. Figure de femme aux formes opulentes, aux chairs rosees et grassouillettes et aux joues vermillonnees. Elle a les yeux leves au ciel, comme en extase. Son costume est fait de brocart rouge et de satin blanc, dont les plis etoffes presentent des tonalites eclatantes. Le bras droit est appuye a une table; dans une main elle tient un cahier de musique; dans l'autre,un luth et l'archet. Pres d'elle on voit un violon et de la musique. Toile. Cadre dore et sculpte. 1.32X1.03." ;
    crm:P102_has_title zac:BO0624_4482_lot_20_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0624_4482!BO0624_4482_000342-p.%205.jpg/full/max/0/default.jpg> ;
    crm:P1_is_identified_by zac:BO0624_4482_lot_20_id ;
    crm:P67i_is_referred_to_by zac:BO0624_4482_lot_20_description ;
    crm:P94i_was_created_by zac:creation_BO0624_4482_lot_20 .

