zac:83846_lot_2 a la:Set ;
    rdfs:label "COMMODE DU TEMPS DE LOUIS XV, ouvrant a trois tiroirs, en bois de placage." ;
    crm:P102_has_title zac:83846_lot_2_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/084e6d7a-8608-42e7-84ee-3c7514466185/full/full/0/default.jpg> ;
