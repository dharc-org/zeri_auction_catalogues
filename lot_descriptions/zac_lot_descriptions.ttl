zac:BO0624_50794_lot_139 a la:Set ;
    rdfs:label "139 - JEAN BAPTISTE PERRONEAU 1715-1783,France Portrait. Portrait d'un gentilhomme coiffe d'une perruque poudree terminee par une natte et noeud de soie noire. L'habit de velours brun legerement entr'ouvert montre le somptuosite du gilet garni d’un riche jabot de dentelles.  La tete aux yeux profonds et expressifs est tournee de trois quarts vers la gauche.  Toile Haut.59 larg. 43." ;
    crm:P102_has_title zac:BO0624_50794_lot_139_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0624_50794!BO0624_50794_000802-p.%2069.jpg/full/max/0/default.jpg> ;
