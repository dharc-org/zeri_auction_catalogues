zac:83745_lot_20 a la:Set ;
    rdfs:label "Huchtenburg. 1646-1773. Portrait presume de l'Artiste." ;
    crm:P102_has_title zac:83745_lot_20_title ;
    crm:P1_is_identified_by zac:83745_lot_20_id ;
    crm:P67i_is_referred_to_by zac:83745_lot_20_description .

zac:83745_lot_20_description a crm:E33_Linguistic_Object ;
    rdfs:label """## 20—Portrait presume de l'Artiste.\r
\r
A mi-corps, de trois quarts a gauche, faisant un geste de la main droite;les cheveux boucles et poudrés tombant sur les epaules. Il porte un habit de soie gris,a revers bleus,ouvert sur un jabot blanc et un manteau develoursrouge drapeautour delui.\r
\r
Toile de forme ovale.\r
\r
Haut., 86 cent.; larg., 6g cent.\r
\r
(Ancienne Collection du prince Demidoff.)\r
\r
(Collection Lanfranconi, Cologne.)\r
## KAGER\r
\r
(MATHIAS) Munich,1566-1634""" ;
    crm:P2_has_type aat:300435416 .

