zac:BO0624_4482_lot_7_description a crm:E33_Linguistic_Object ;
    rdfs:label """7. Ecce Homo.\r
\r
Le Sauveur represente a mi-corps est soutenu par un ange. Composition ayant certainement fait partie d'un tableau de dimensions plus grandes. Bois. Riche cadre bois dore et sculpte. Bonne conservation. 0.51X0.54.""" ;
    crm:P2_has_type aat:300435416 .

zac:BO0624_4482_lot_7_id a crm:E42_Identifier ;
