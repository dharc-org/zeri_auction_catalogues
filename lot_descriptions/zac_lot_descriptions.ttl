zac:BO0624_23222_lot_318 a la:Set ;
    rdfs:label "318 - Desgl.,zwei Verroterie-Scheibenfibeln auf silberner Unterlage, in der Mitte der Oberseite eine runde, weibe Einlage, um die sich zwei konzentrische Kreise mit je sieben Almandinfuillungen legen. D.2.5.-Ein schweres, goldenes Armband. Der ganz mit dinnem Golddraht eng umwickelte Reifen lauff an den offenen Enden in je zwei Voluten aus, deren jede in einer runden, getriebenen, mit einem Almandin geschmickten Scheibe sich fortsetzt. GroBter D. 7.9. Gewicht 37 g.-Ein goldener Fingerring mit zwei Steinen in hoher mit seitlichen Radchen als Anhangsel.Beschadigt.-Eine Bronzeschnalle. Ein bronzenes Loffelchen. Ein Bronzering.—Eine Perlkette. Ochtendung. Abb.Tafel 5." ;
    crm:P102_has_title zac:BO0624_23222_lot_318_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0624_23222!BO0624_23222_000122-p.%2019.jpg/full/max/0/default.jpg> ;
