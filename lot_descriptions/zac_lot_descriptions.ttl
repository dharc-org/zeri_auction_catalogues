zac:BO0624_83731_lot_1 a la:Set ;
    rdfs:label "1 - Objets d'art et d'ameublement. Bronze, sculpture.  PeNduLe, en bronze et marbre blanc,ornee, de part et d'autre du mouvement, d'un groupe:l'oiseau mort;composition d'une fillette drapee a l'antique et d'un amour. Base ornee d'une frise d'amours musiciens. Cadran signe: Guy d Amour, a Paris. Epoque Louis XVI." ;
    crm:P102_has_title zac:BO0624_83731_lot_1_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0624_83731!BO0624_83731_000062-p.%20%5B5%5D.jpg/full/max/0/default.jpg> ;
    crm:P1_is_identified_by zac:BO0624_83731_lot_1_id ;
    crm:P2_has_type <http://w3id.org/zac/type/bronzes_sculpture> ;
    crm:P67i_is_referred_to_by zac:BO0624_83731_lot_1_description .

