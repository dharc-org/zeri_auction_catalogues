zac:1003_lot_217 a la:Set ;
    rdfs:label "HESIODE. Les Travaux et les Jours d'Hesiode. Traduction nouvelle de Paul Mazon. Suivis de La Terre et I'Homme,par Anatole France. Decores de cent quatorze bois originaux de Paul-Emile Colin. Paris, Edouard Pelletan, 19t2, pet. in-4, mar. havane, tres bel encadr. regulier serti de chaines, de filets et points dor., forme de feuilles de vigne, de grappes de raisin et d'epis de ble composant une mosaique aux tons doux et fondus, coupee en son milieu sur chaque face d'un rectangle a fond d'ecailles dor. sur lequel se detachent divers instruments aratoires au sein d'une ellipse de mar. bleu, dos orne et mosaique, double de mar. vieil or dans un cadre de mar. brun, grand losange, fleurons d'angles, gardes de soie brochee couleur bois, doubles gardes, tr. dor. sur temoins, couverture, etui (Kieffer)." ;
    crm:P102_has_title zac:1003_lot_217_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/4748c155-f96f-46bc-ad54-3e796947e98c/full/full/0/default.jpg> ;
    crm:P1_is_identified_by zac:1003_lot_217_id ;
    crm:P2_has_type <http://w3id.org/zac/type/libri> ;
    crm:P67i_is_referred_to_by zac:1003_lot_217_description .

zac:1003_lot_217_description a crm:E33_Linguistic_Object ;
    rdfs:label """217. HESIODE. Les Travaux et les Jours d'Hesiode. Traduction nouvelle de Paul Mazon. Suivis de La Terre et I'Homme,par Anatole France. Decores de cent quatorze bois originaux de Paul-Emile Colin. Paris, Edouard Pelletan, 19t2, pet. in-4, mar. havane, tres bel encadr. regulier serti de chaines, de filets et points dor., forme de feuilles de vigne, de grappes de raisin et d'epis de ble composant une mosaique aux tons doux et fondus, coupee en son milieu sur chaque face d'un rectangle a fond d'ecailles dor. sur lequel se detachent divers instruments aratoires au sein d'une ellipse de mar. bleu, dos orne et mosaique, double de mar. vieil or dans un cadre de mar. brun, grand losange, fleurons d'angles, gardes de soie brochee couleur bois, doubles gardes, tr. dor. sur temoins, couverture, etui (Kieffer).\r
\r
Exemplaire imprime sur papier velin du Marais, auquel on a ajoute une col-\r
\r
BELLE RELiuRe dont la mosaique se repete sur chaque plat et au milieu du dos.\r
\r
lection des gravures en epreuves d'artiste, tirees sur Japon ancien.""" ;
    crm:P2_has_type aat:300435416 .

