zac:83724_lot_61 a la:Set ;
    rdfs:label "VERMEER DE DELFT. Portrait d’une Dame de qualite." ;
    crm:P102_has_title zac:83724_lot_61_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/76dddbf9-d6a0-4af8-aab7-eb09a2d85b98/full/full/0/default.jpg> ;
