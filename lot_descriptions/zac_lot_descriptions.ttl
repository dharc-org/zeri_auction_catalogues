    crm:P102_has_title zac:BO0624_4399_lot_587_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0624_4399!BO0624_4399_000401-p.%2074.jpg/full/max/0/default.jpg> ;
