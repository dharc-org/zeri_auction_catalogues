zac:BO0624_51192_lot_150 a la:Set ;
    rdfs:label "150 - ATTRIBUTED TO VERROCCHIO. Florence: 1435-1488.A very beautiful head of St. John the Baptist, in wood. This work, with the wonderfully expressive face framed in long severe curls,is almost certainly the work of the master to whom it is attributed.  Purchased at the sale of the collection of M.Ravaisson-Mollien (a former director of the Musée du Louore) on the cover of the catalogue of which it is illustrated.  Ht.,12 inches.  (Illustrated.)" ;
    crm:P102_has_title zac:BO0624_51192_lot_150_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0624_51192!BO0624_51192_000671-p.%20[100].jpg/full/max/0/default.jpg> ;
