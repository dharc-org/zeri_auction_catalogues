    rdfs:label "12 - Anthony Jansz van der Croos  (geb. im Haag 1606, gest. nach 1669). Landschaft" ;
    crm:P102_has_title zac:BO0614_87918_lot_12_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0614_87918!BO0614_87918_000052-p.%203.jpg/full/max/0/default.jpg> ;
