zac:BO0624_51192_lot_342 a la:Set ;
    rdfs:label "342 - RICCIO. Padua:1470-1532. Allegory of the culture of trees. A standing child, nude, with a loose short cloak foating from his shoulders, treading with his left foot on a prostrate satyr. He waters a tree with a can, and with the other arm shields its topmost branches from the breath of Boreas.  A perfect specimen.  Diameter,17/8inches.  Molinier, No.244. Migeon, No.329. Bode, No.711.  (Illustrated.)" ;
    crm:P102_has_title zac:BO0624_51192_lot_342_title ;
