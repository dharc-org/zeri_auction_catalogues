zac:83725_lot_98 a la:Set ;
    rdfs:label "DuSART, Corneille. 1665-1704. LA GAITE AU VILLAGE." ;
    crm:P102_has_title zac:83725_lot_98_title ;
    crm:P1_is_identified_by zac:83725_lot_98_id ;
    crm:P67i_is_referred_to_by zac:83725_lot_98_description ;
    crm:P94i_was_created_by zac:creation_83725_lot_98 .

zac:83725_lot_98_description a crm:E33_Linguistic_Object ;
    rdfs:label """98.—LA GAITE AU VILLAGE.\r
\r
Peinture sur bois.\r
\r
Un joueur de biniou fait danser un couple age qui amuse des paysans et paysannes attables et debout, ainsi que des enfants. Jolies chaumieres, feuillages etclocher.\r
\r
Le premier plan un peu frotte.\r
\r
Haut. o4o,larg.o53.\r
\r
## VELDE, Willem van de, le jeune. 1633-1707.""" ;
    crm:P2_has_type aat:300435416 .

zac:83725_lot_98_id a crm:E42_Identifier ;
