    crm:P67i_is_referred_to_by zac:83724_lot_61_description ;
    crm:P94i_was_created_by zac:creation_83724_lot_61 .

zac:83724_lot_61_description a crm:E33_Linguistic_Object ;
    rdfs:label """## 61\r
\r
## VERMEER DE DELFT\r
\r
(Attribue a JEAN)\r
\r
## Portrait d’une Dame de qualite.\r
\r
En buste, richement vetue, un grand col de dentelle couvrant les épaules, les cheveux ornes de rubans, elle tient un eventail de plumes a la main gauche.\r
\r
Ce gracieux portrait est inscrit dans un encadrement ovale imitant la pierre sculptee et peint en trompel'ceil.\r
\r
Euvre d'une tonalite delicate et d’un grand charme d'execution.\r
\r
Toile. Haut., 75 cent.,; larg., 62 cent.\r
\r
## ECOLE FRANCAISE\r
\r
(xv siecle)""" ;
    crm:P2_has_type aat:300435416 .

