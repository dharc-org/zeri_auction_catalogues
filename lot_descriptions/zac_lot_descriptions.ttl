zac:81812_lot_4_description a crm:E33_Linguistic_Object ;
    rdfs:label """- 4.Lorenzetti Ambrogio.1323-1348. San Giovanni e unaltro Santo.Tavola a fondo oro di freschezza introvabile.Capolavoro di pittura senese! Cornice a tabernacolo in legno scolpito e dorato.Alt. cm.90, larg. cm.80. Richiamo lattenzione dei collezionisti e dei critici sopra questo importante dipinto,per lungo tempo attribuito a Beato Angelico del quale ha tutta la vivace,smagliante bellezza delle tinte,la drappeggiatura\r
- delle stoffe.Dalla critica recente e stato attribuito al Lorenzetti.\r
\r
Vedi tavola N. 3.""" ;
    crm:P2_has_type aat:300435416 .

zac:81812_lot_4_id a crm:E42_Identifier ;
    rdfs:label "BO0624_81812-4" .

zac:81812_lot_4_title rdfs:label "Lorenzetti Ambrogio.1323-1348. San Giovanni e un altro Santo.Tavola a fondo oro di freschezza introvabile.Capolavoro di pittura senese! Cornice a tabernacolo in legno scolpito e dorato.Alt. cm.90, larg. cm.80. Richiamo lattenzione dei collezionisti e dei critici sopra questo importante dipinto,per lungo tempo attribuito a Beato Angelico del quale ha tutta la vivace,smagliante bellezza delle tinte,la drappeggiatura  delle stoffe.Dalla critica recente e stato attribuito al Lorenzetti." .

