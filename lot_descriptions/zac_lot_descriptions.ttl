    rdfs:label "CuYP, Aelbert. 1620-1691. PECHEURS." ;
    crm:P102_has_title zac:83725_lot_97_title ;
    crm:P1_is_identified_by zac:83725_lot_97_id ;
    crm:P67i_is_referred_to_by zac:83725_lot_97_description ;
    crm:P94i_was_created_by zac:creation_83725_lot_97 .

zac:83725_lot_97_description a crm:E33_Linguistic_Object ;
    rdfs:label """97. ——PECHEURS.\r
\r
Peinture sur bois.\r
\r
A gauche, la mer avec des barques et plusieurs personnages;a droite,colline sur laquelle cheminent deux pecheurs vers un village dont on voit l'eglise.\r
\r
Haut.om93,larg.127.\r
\r
## DuSART, Corneille. 1665-1704.""" ;
    crm:P2_has_type aat:300435416 .

