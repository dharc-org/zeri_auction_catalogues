zac:50794_lot_109 a la:Set ;
    rdfs:label "SALVATOR ROSA 1615-1673, Naples. Un sinistre.Un incendie jette sa note sinistre dans la nuit.  Bois Haut. 33 larg. 45.  Un chateau est devore par les flammes. Le feu a deja fait son oeuvre et devant les ruines de cette belle construction, on voit de nombreux cavaliers qui cherchent a dompter leur monture." ;
    crm:P102_has_title zac:50794_lot_109_title ;
    crm:P1_is_identified_by zac:50794_lot_109_id ;
    crm:P67i_is_referred_to_by zac:50794_lot_109_description ;
    crm:P94i_was_created_by zac:creation_50794_lot_109 .

