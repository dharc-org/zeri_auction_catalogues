    rdfs:label "Suddeutsch. Anfang 17. Jahrh. Gang nach Emmaus. Im Vordergrund schreitet Christus zwischen den beiden Jungern" ;
    crm:P102_has_title zac:15368_lot_377_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/afd80585-f498-4486-9d36-8624c19815ea/full/full/0/default.jpg> ;
