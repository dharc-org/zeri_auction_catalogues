zac:BO0624_51192_lot_358_description a crm:E33_Linguistic_Object ;
    rdfs:label """358 — SPERANDIO.\r
\r
Virgilio Malvezzi : a nobleman of Bologna. Ambassador in 1451. Died 1481.\r
\r
Bust in profile, facing left.\r
\r
