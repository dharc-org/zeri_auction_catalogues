zac:BO0624_50794_lot_76 a la:Set ;
    rdfs:label "76 - ALEXANDRE LONGHI 1733,Venise. Portrait d'un magistrat venitien. Represente a mi jambes, grandeur naturelle, de trois quarts tourne vers la gauche, debout, la main droite montrant un parchemin timbre pose sur une table, tenant ses gants de la main gauche; il est vetu d''une robe en velours noir, de belles dentelles ornent le bas des manches; coiffe d' une perruque blanche, boucles descendant sur les épaules.  Un riche tapis orne le bas du tableau qui se detache sur un fond de draperie rouge,  Tres beau portrait ayant un grand caractere de distinction.  Toile Haut.235 larg.158." ;
    crm:P102_has_title zac:BO0624_50794_lot_76_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0624_50794!BO0624_50794_000442-p.%2041.jpg/full/max/0/default.jpg> ;
