    rdfs:label "Nurnberg. 2 Halfte 16. Jahrh, Diana und Aktaeon. Im Wald schreitet Aktaeon mit zwei Hunden von rechts einem Brunnen zu, in dem Diana mit zwei Nymphen badet. Rechts oben Aktaeon mit Hirschkopf, zuruckblickend." ;
    crm:P102_has_title zac:15368_lot_301_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/ab0edd95-6e2b-4ca6-b173-6e0b009b7546/full/full/0/default.jpg> ;
