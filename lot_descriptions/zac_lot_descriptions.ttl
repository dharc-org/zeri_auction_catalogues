zac:5830_lot_53_description a crm:E33_Linguistic_Object ;
    rdfs:label """In an excellent state of preservation.\r
\r
Panel.Ht.,7 inches.W.,5 1/2 inches.\r
\r
(Illustrated.)\r
Triptych.\r
\r
Centre, the crucifixion, in an exquisite landscape.\r
\r
Left, Christ bearing the Cross. The towers of a city on a hill, in the background.\r
\r
Right, the descent from the Cross. The Christ is supported by Mary Magdalene and by St. John.The Virgin kneels beneath. Excellently preserved. From the Somzee collection, Brussels.\r
\r
Centre panel.Ht.,75/8 inches. W.,53/4inches. Side panels. Ht.,75/8 inches. W.,2 1/4 inches.\r
\r
(Illustrated.)\r
\r
##""" ;
    crm:P2_has_type aat:300435416 .

