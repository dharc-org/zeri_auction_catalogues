zac:5830_lot_92_description a crm:E33_Linguistic_Object ;
    rdfs:label """92\r
\r
## Jose MARTINEZ\r
\r
Spain:I7th.century\r
\r
Old lady,in white bonnet and fur-lined cloak,warming her hands before a hand-warmer on her lap.\r
\r
Canvas.Ht.,28 inches.W.,23 inches.\r
\r
(Tuwo paintings by the same artist are in the Spanish room of the\r
\r
National Gallery,London.)\r
St. Francis.\r
\r
The saint's left hand rests on a skull ; his eyes are fixed on a crucifix.\r
\r
Canvas.Ht.,35 1/2 inches.W.,32 1/2 inches.\r
\r
Bears (on the back) the mark of the collection of Louis-Philippe,King\r
\r
##""" ;
    crm:P2_has_type aat:300435416 .

