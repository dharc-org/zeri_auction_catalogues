zac:50794_lot_28_description a crm:E33_Linguistic_Object ;
    rdfs:label """## 28. Portrait de jeune femme.\r
\r
Peinte en medaillon, decolletee, vue de face, le corsage garni d'une fine dentelle.\r
\r
Les cheveux vaporeux, d’un blond ardent, sont releves en bouffant au sommet de la tete; de chaque cote deux boucles retombent gracieusement sur les epaules.\r
\r
De grands yeux bruns, pleins de malice, une bouche souriante ajoutent au charme de ce gracieux tableau.\r
\r
\r
Toile Haut. 60 larg. 47. 1734-1802,Dalton.\r
##""" ;
    crm:P2_has_type aat:300435416 .

zac:50794_lot_28_id a crm:E42_Identifier ;
    rdfs:label "BO0624_50794-28" .

zac:50794_lot_28_title rdfs:label "JEAN HOPPNER 1579-1810,Londres. Portrait de jeune femme. 1802,Dalton. Peinte en medaillon, decolletee, vue de face, le corsage garni d'une fine dentelle.  Les cheveux vaporeux, d’un blond ardent, sont releves en bouffant au sommet de la tete; de chaque cote deux boucles retombent gracieusement sur les epaules.  De grands yeux bruns, pleins de malice, une bouche souriante ajoutent au charme de ce gracieux tableau." .

zac:50794_lot_29 a la:Set ;
    rdfs:label "MAITRE FRANCAIS XIXme siecle. Portrait de Pauline Borghese.Somptueusement paree d'une robe Empire en soie blanche, laissant a découvert le haut de la poitrine.  Une fine dentelle borde l'échancrure du vetement;un manteau a franges est jete negligemment sur les épaules.  Les cheveux bruns sont releves sur le somment de la tete; d'épaisses meches s'en échappent et retombent en boucles regulieres sur les joues.  Toile Haut. 69 larg. 55.  Le visage, finement dessine, reflete la grace et la noblesse des patriciennes de l'époque." ;
    crm:P102_has_title zac:50794_lot_29_title ;
    crm:P1_is_identified_by zac:50794_lot_29_id ;
    crm:P67i_is_referred_to_by zac:50794_lot_29_description .

