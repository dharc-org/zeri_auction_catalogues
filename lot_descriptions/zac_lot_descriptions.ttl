zac:BO0624_15271_lot_175 a la:Set ;
    rdfs:label "175 - Jonas Silber,  Nurnberg 1572—1589. Apollo und die Musen.In der Mitte sitzt Apollo die Leier schlagend auf einem Gemauer. Um ihn herum die Musen in drei Gruppen geteilt, verschiedene Instrumente spielend. Unten ein ruhender Flussgott.Uber der Landschaft mit Ruinen und dem Blick auf eine Stadt im Hintergrund erhebt sich links Pegasus; dung S.21 nach dem Exemplare des Histor.Museums,Basel. Rund. 174 mm. Bronze. Sehr schon." ;
    crm:P102_has_title zac:BO0624_15271_lot_175_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0624_15271!BO0624_15271_000151-p.%2024.jpg/full/max/0/default.jpg> ;
