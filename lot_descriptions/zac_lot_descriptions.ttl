zac:83724_lot_56 a la:Set ;
    rdfs:label "PIERRE JEAN-BAPTISTE. 1715-1789. La Peinture, composition decorative." ;
    crm:P102_has_title zac:83724_lot_56_title ;
    crm:P1_is_identified_by zac:83724_lot_56_id ;
    crm:P67i_is_referred_to_by zac:83724_lot_56_description ;
    crm:P94i_was_created_by zac:creation_83724_lot_56 .

zac:83724_lot_56_description a crm:E33_Linguistic_Object ;
    rdfs:label """56 —— La Peinture, composition decorative.\r
\r
Une jeune femme, legerement drapee d'amples etoffes, tenant une palette, personnifie l'Art de la Peinture.\r
\r
Devant elle, une toile ovale sur laquelle est dessine un portrait de femme et que tient un amour. Un second amour dessine sur un album.\r
\r
Beau dessus de porte de forme contournee.\r
\r
Toile. Haut., 55 cent.; larg., 1 m.57 cent.\r
## LOO\r
\r
(Attribue a CARLE VAN)\r
\r
## -Portrait dun Marecbal de France.\r
\r
A mi-jambes, en armure, la main droite appuyee sur la hanche, tenant de 1'autre main le baton de commandement; une ceinture de soie blanche flottant autour de la taille, un ample manteau de velours bieu, double de fourrures, drape sur les épaules. Au second plan, un campement.\r
\r
Fond de ciel.\r
\r
Portrait d'un bel effet decoratif.\r
\r
Toile. Haut., 1 metre; larg., 88 cent.\r
\r
## ECOLE FLAMANDE\r
\r
(xvi siecle)""" ;
    crm:P2_has_type aat:300435416 .

zac:83724_lot_56_id a crm:E42_Identifier ;
    rdfs:label "BO0624_83724-56" .

zac:83724_lot_56_title rdfs:label "PIERRE JEAN-BAPTISTE. 1715-1789. La Peinture, composition decorative." .

