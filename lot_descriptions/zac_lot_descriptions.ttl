zac:4482_lot_1 a la:Set ;
    rdfs:label "ECOLE ALLEMANDE. Dietrich (Chr. Guill. Ernest) - 1712-1774 (attribue a). Avare et la Mort. Il est assis devant une table chargee de vases, d’etoffes rares et d'autres ustensiles precieux, groupes aussi par terre. Les accessoires copies scrupuleusement presentent un grand fini de details. Bois. Cadre dore. 0.49X0.39." ;
    crm:P102_has_title zac:4482_lot_1_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/76882709-1df1-4208-ba26-556bb373ceba/full/full/0/default.jpg> ;
