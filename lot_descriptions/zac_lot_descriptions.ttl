zac:83754_lot_36 a la:Set ;
    rdfs:label "Decamps, Alexandre-Gabriel.  Rue d'un village d'Italie." ;
    crm:P102_has_title zac:83754_lot_36_title ;
    crm:P1_is_identified_by zac:83754_lot_36_id ;
    crm:P67i_is_referred_to_by zac:83754_lot_36_description ;
