    rdfs:label "72 - Esaias van de Velde (geb. zu Amsterdam vor 1590, gest.zu Leiden 1630). Rast im Walde." ;
    crm:P102_has_title zac:BO0614_87918_lot_72_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0614_87918!BO0614_87918_000111-p.%2014.jpg/full/max/0/default.jpg> ;
