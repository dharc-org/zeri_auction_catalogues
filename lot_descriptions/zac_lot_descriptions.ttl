    rdfs:label "LAZERGES. Un Gourbis au soleil couchant." ;
    crm:P102_has_title zac:83733_lot_19_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/54b57189-5409-43a5-83e4-56565a7b6fb8/full/full/0/default.jpg> ;
    crm:P1_is_identified_by zac:83733_lot_19_id ;
    crm:P67i_is_referred_to_by zac:83733_lot_19_description ;
    crm:P94i_was_created_by zac:creation_83733_lot_19 .

zac:83733_lot_19_description a crm:E33_Linguistic_Object ;
    rdfs:label """19 —Un Gourbis au soleil couchant.\r
\r
Sur les rives d'un oued aux eaux transparentes, des Arabes sont assis; a cote d'eux, une femme puise de l'eau dans la riviere.\r
\r
Au second plan sont édifiees des tentes d'ou s'echappent des fumees legeres qui montent lentement dans le ciel. L'horizon est borne par des bouquets de palmiers.\r
\r
Signe a gauche, en bas, et date : 1899.\r
\r
Toile. Haut., 1 m. 15 ; larg., 1 m.45.\r
\r
## LAZERGES (Paul)""" ;
    crm:P2_has_type aat:300435416 .

zac:83733_lot_19_id a crm:E42_Identifier ;
    rdfs:label "BO0624_83733-19" .

zac:83733_lot_19_title rdfs:label "LAZERGES. Un Gourbis au soleil couchant." .

