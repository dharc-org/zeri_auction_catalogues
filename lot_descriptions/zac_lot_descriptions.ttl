zac:51192_lot_432_description a crm:E33_Linguistic_Object ;
    rdfs:label """432 — LARGE ENAMEL RELIQUARY. Limoges, 13th. Century.\r
\r
Decorated on the one side with six medallions containing angels, on the other with standing figures of saints, as also at either end. It has preserved its original wooden carcase. Surmounted by three balls of crystal.\r
\r
Limoges,I3th.century.\r
\r
Ht.,93/4 inches.Length,85/8inches.Width,3 1/4 inches.\r
\r
(Illustratea.)""" ;
    crm:P2_has_type aat:300435416 .

