    rdfs:label "Crome. 1769-1821. La Route, pres Yarmouth." ;
    crm:P102_has_title zac:83758_lot_16_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/d478c8e0-1efc-4118-a036-9e5819688bec/full/full/0/default.jpg> ;
