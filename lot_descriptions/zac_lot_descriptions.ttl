zac:BO0624_15271_lot_98 a la:Set ;
    rdfs:label "98 - Moderno, in Oberitalien Ende des 15.bis Anfang des 16. Jahrh. tatig. Kreuzigung Christi. Zwischen den beiden Schachern hangt Christus am Kreuze, das Magdalena umfasst.Links vor ihr bilden Johannes und die von zwei Frauen gehaltene hinsinkende Muttergottes eine Gruppe. Das Feld rechts und der Hintergrund ist von romischem Kriegsvolk angefullt. Bode 740.Kat. Launa 325. 111x81 mm.Bronze.Schon." ;
    crm:P102_has_title zac:BO0624_15271_lot_98_title ;
