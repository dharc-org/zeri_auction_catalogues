zac:50794_lot_23 a la:Set ;
    rdfs:label "GUILLAUME KALF 1693, Amsterdam. Nature morte. Sur une table recouverte d'un tapis vert, un citron entame, enroule dans sa pelure; un couteau est place a cote.  Au milieu de la table: une aiguiere en argent; a cote et renversee, une coupe finement ciselee; a droite, du pain sur un plateau. Dans le fond, une grappe de raisins noirs et une pomme.  A gauche; un coin de tapis souleve decouvrant la table en bois blanc; une noisette et des coquilles.  Bois Haut.29 larg. 38." ;
    crm:P102_has_title zac:50794_lot_23_title ;
    crm:P1_is_identified_by zac:50794_lot_23_id ;
    crm:P67i_is_referred_to_by zac:50794_lot_23_description ;
    crm:P94i_was_created_by zac:creation_50794_lot_23 .

