zac:4399_lot_140 a la:Set ;
    rdfs:label "J.GOSSAERT  （dit DeMaubeuge,1470). LA VIERGE ET L'ENFANT JESUS. Au dessous d'un baldaquin en etoffe verte foncee, avec lambrequin rouge a galon dore,la Vierge donne le sein au Divin Enfant,qui en meme temps presse de ses petites mains le sein de la Mere et tourne la tete a droite. Dans le lointain,paysage avec maisons et petits personnages. Peinture de tout premier ordre. Cadre a tabernacle en bois dore." ;
    crm:P102_has_title zac:4399_lot_140_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/2be21f2a-bc60-4949-bbc5-04d1279659f8/full/full/0/default.jpg> ;
    crm:P1_is_identified_by zac:4399_lot_140_id ;
    crm:P67i_is_referred_to_by zac:4399_lot_140_description ;
    crm:P94i_was_created_by zac:creation_4399_lot_140 .

zac:4399_lot_140_description a crm:E33_Linguistic_Object ;
    rdfs:label """- 140.LA VIERGE ET L'ENFANT JESUS. Au dessous d'un baldaquin en etoffe verte foncee, avec lambrequin rouge a galon dore,la Vierge donne le sein au Divin Enfant,qui en meme temps presse de ses petites mains le sein de la Mere et tourne la tete a droite. Dans le lointain,paysage avec maisons et petits personnages. Peinture de tout premier ordre. Cadre a tabernacle en bois dore.\r
\r
Bois.Haut.o.30-larg.0.24. Voir illustration,planche11.\r
\r
