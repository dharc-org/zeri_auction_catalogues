zac:44452_lot_115 a la:Set ;
    rdfs:label "Grosse gothische Scheibe. Gegen den blauen Himmel vor einem Zelte ubergiebt Judith das Haupt des Holofernes, im Hintergrunde des Zeltes sieht man den Enthaupteten in liegender Stellung. Rechts ein Theil eines zweiten Zeltes, Kanonen und Landsknechte, im Hintergrunde eine Burg. Die Umrahmung ornamentirte Saulen," ;
    crm:P102_has_title zac:44452_lot_115_title ;
    crm:P1_is_identified_by zac:44452_lot_115_id ;
    crm:P2_has_type <http://w3id.org/zac/type/glasgemalde_kunstgegenstande> ;
    crm:P67i_is_referred_to_by zac:44452_lot_115_description .

zac:44452_lot_115_description a crm:E33_Linguistic_Object ;
    rdfs:label """115. Grosse gothische Scheibe. Gegen den blauen Himmel vor einem Zelte ubergiebt Judith das Haupt des Holofernes, im Hintergrunde des Zeltes sieht man den Enthaupteten in liegender Stellung. Rechts ein Theil eines zweiten Zeltes, Kanonen und Landsknechte, im Hintergrunde eine Burg. Die Umrahmung ornamentirte Saulen,\r
als Basis der Komposition dient ein Fries mit Engeln dazwischen die Jahreszahl 1519, am Fuss desselben die Standesschilder, Ury, Schwyz, Solothurn,Zug, Glarus. Hohe 71, Breite 51 cm., 8 Sprunge und 6 alt. Erg. Schone und farbige Scheibe. Schweiz.""" ;
    crm:P2_has_type aat:300435416 .

zac:44452_lot_115_id a crm:E42_Identifier ;
    rdfs:label "BO0624_44452-115" .

zac:44452_lot_115_title rdfs:label "Grosse gothische Scheibe. Gegen den blauen Himmel vor einem Zelte ubergiebt Judith das Haupt des Holofernes, im Hintergrunde des Zeltes sieht man den Enthaupteten in liegender Stellung. Rechts ein Theil eines zweiten Zeltes, Kanonen und Landsknechte, im Hintergrunde eine Burg. Die Umrahmung ornamentirte Saulen," .

