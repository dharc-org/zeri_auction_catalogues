zac:65735_lot_43 a la:Set ;
    rdfs:label "NICOLAS LANCRET  (Paris16go-1743). Societe dans un parc." ;
    crm:P102_has_title zac:65735_lot_43_title ;
    crm:P1_is_identified_by zac:65735_lot_43_id ;
    crm:P67i_is_referred_to_by zac:65735_lot_43_description ;
