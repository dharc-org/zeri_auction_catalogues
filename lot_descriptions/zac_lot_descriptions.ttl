zac:83757_lot_31 a la:Set ;
    rdfs:label "ECOLE ANGLAISE. Ferme a lentree dun bois." ;
    crm:P102_has_title zac:83757_lot_31_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/d89d9d42-0e1c-4f80-b6e5-89c9eeecf9df/full/full/0/default.jpg> ;
    crm:P1_is_identified_by zac:83757_lot_31_id ;
    crm:P67i_is_referred_to_by zac:83757_lot_31_description .

zac:83757_lot_31_description a crm:E33_Linguistic_Object ;
    rdfs:label """## 31 —Ferme a lentree dun bois.\r
\r
La ferme, coiffee de tuiles rouges, dresse son toit dans lécartement des frondaisons touffues. Au-devant de la ferme, vers la gauche, passe un chemin qui longe un cours d'eau. Sur ce chemin,une paysanne, vetue de rouge, s'eloigne tenant par la main un petit garcon.Au fond, du meme cote,on apercoit une plaine marquee de quelques buissons d’arbres, sous un ciel d'azur lumineux.\r
\r
Toile. Haut., 28 cent.;larg.,36 cent. 1/2.\r
\r
## ECOLE ANGLAISE""" ;
    crm:P2_has_type aat:300435416 .

