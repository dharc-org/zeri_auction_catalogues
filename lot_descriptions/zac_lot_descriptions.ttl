zac:4482_lot_78 a la:Set ;
    rdfs:label "Titien ——1477-1576 (copie ancienne d'apres le). Le martyre de Saint Pierre le Dominicain. Le saint est a terre;il cherche a se defendre des coups que lui porte son bourreau. Dominique, le frere de la victime, s'enfuit la tete ensanglantee. Des anges du haut des nues presentent la palme au martyr. Toile. Cadre dore et sculpte. (L'original de ce tableau, un des meilleurs du Titien, a été malheureusement detruit par un incendie a Venise. Il fut execute par le maitre a 1age de 48 ans en 1528 pour 1'eglise de Saint Jean et Saint Paul). 1.58X0.95." ;
    crm:P102_has_title zac:4482_lot_78_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/4b94b3a3-9ee5-4d8f-b359-2dcd5a4a1c11/full/full/0/default.jpg> ;
    crm:P1_is_identified_by zac:4482_lot_78_id ;
    crm:P67i_is_referred_to_by zac:4482_lot_78_description .

zac:4482_lot_78_description a crm:E33_Linguistic_Object ;
    rdfs:label """78. Le martyre de Saint Pierre le Dominicain.\r
