zac:83758_lot_21 a la:Set ;
    rdfs:label "Drolling. 1752-1817. Le Regret." ;
    crm:P102_has_title zac:83758_lot_21_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/dd272a1a-ac14-4cfd-9c01-bda721b395fd/full/full/0/default.jpg> ;
    crm:P1_is_identified_by zac:83758_lot_21_id ;
