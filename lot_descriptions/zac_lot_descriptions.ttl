zac:BO0624_15271_lot_173 a la:Set ;
    rdfs:label "173 - Siddeutsche Plaketten,2. Halfte des 16. Jahrhunderts. Anbetung der Hirten. In der Mitte sitzt Maria mit gefalteten Handen, das Kind auf dem Schosse.Sie ist von drei Hirten umgeben.Der hinter ihr stehende Josef blickt uiber sie zum Kinde. Von links und rechts treten zwei Frauen mit Gefassen auf den Kopfen hinzu. Kalb,Esel und Hund beleben die Gruppe." ;
    crm:P102_has_title zac:BO0624_15271_lot_173_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0624_15271!BO0624_15271_000142-p.%2023.jpg/full/max/0/default.jpg> ;
