    rdfs:label "142 - F. GUARDI, Capricci,deux visions fantasques avec des ruines et un petit port avec des navires, tous les deux animes par de petits personnages gracieux et vibrants. Peinture sur parchemin, cadres dores de l'époque; m. 0.19X0.13." ;
    crm:P102_has_title zac:BO0624_81813_lot_142_title ;
    crm:P138i_has_representation <nan> ;
