zac:BO0624_1003_lot_130 a la:Set ;
    rdfs:label "130 - NODIER (Charles). Journal de Iexpedition des Portes de Fer. Paris, Imprimerie Royale, 1844, in-8, 4o pl. gr. sur bois, tirees sur chine monte sur papier fort, papier fin avec legende, nombr. vign. dans le texte gr. sur bois, carte. Mar. viol., fil., comp. de fil. avec orn. dor. et en mosaique de mar. brun, rouge et orange, dos or., doub. de mar. brun," ;
    crm:P102_has_title zac:BO0624_1003_lot_130_title ;
    crm:P138i_has_representation <nan> ;
    crm:P1_is_identified_by zac:BO0624_1003_lot_130_id ;
    crm:P2_has_type <http://w3id.org/zac/type/editions_reliures> ;
    crm:P67i_is_referred_to_by zac:BO0624_1003_lot_130_description .

zac:BO0624_1003_lot_130_description a crm:E33_Linguistic_Object ;
    rdfs:label """- 13o. NODIER (Charles). Journal de Iexpedition des Portes de Fer. Paris, Imprimerie Royale, 1844, in-8, 4o pl. gr. sur bois, tirees sur chine monte sur papier fort, papier fin avec legende, nombr. vign. dans le texte gr. sur bois, carte. Mar. viol., fil., comp. de fil. avec orn. dor. et en mosaique de mar. brun, rouge et orange, dos or., doub. de mar. brun,\r
listel de mar. grenat avec guirlande de feuilles de chene dor., motif a repetition fusils, sabre,kepi, cimeterre dor. sur mar.La Valliere serti a froid, gardes de moire, tr. dor. sur bro.,chemise en demi-mar. doublee de mouton,etui (Ch.Meunier,1g1o).\r
\r
Bel exemplaire de ce livre illustre par Decamps,Raffet et Dauzats. Exemplaire imprime pour le General Vicomte de Rumigny, qui a mentionne de sa main sur le faux-titre.a Donne en 1844 par Son Altesse Royale Madame la Duchesse d'Orleans.) Importante reliure de Meunier.""" ;
    crm:P2_has_type aat:300435416 .

