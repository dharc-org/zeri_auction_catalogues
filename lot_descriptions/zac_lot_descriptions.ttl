    crm:P67i_is_referred_to_by zac:87918_lot_27_description .

zac:87918_lot_27_description a crm:E33_Linguistic_Object ;
    rdfs:label """Im Vordergrunde eines von dichten Baumen bestandenen Waldes hat sich die Gottin mit ihren Nymphen\r
\r
niedergelassen. Sie sitzt im Gesprache mit ihrer Umgebung am Boden, wahrend ihr eine Dienerin das Haar kammt. Eine Nymphe sitzt am Bachrande, eine zweite hat sich etwas weiter rickwarts am Waldboden niedergelassen und wendet sich im Gesprache zurick. Mehrere Hunde beleben das Bild. Rechts bez.: G. Hoet. F.\r
\r
Abildung siehe Tafel 10.\r
\r
##.\r
\r
Wildes Kampfgetimmel belebt den Vordergrund; Soldaten zu Pferde sind mit Degen und Pistolen aneinandergeraten.\r
\r
Uber die ansteigende linke Landschaftspartie im Hintergrunde, die von einer Ruine iberragt wird, sprengt ein Trupp Soldaten； Pulverwolken verdunkeln das Firmament.\r
\r
Auf Leinwand. Hohe 5I cm,Breite 8o cm. In Goldrahmen.\r
\r
## \r
\r
Auf Leinwand.Hohe 1o7 cm,Breite 78 cm.In Goldrahmen\r
\r
## \r
\r
##  29\r
\r
Den Vordergrund des Bildes nimmt ein dichter Wald ein.Links bewirtet Abraham die beiden Engel, wahrend aus dem etwas weiter rickwarts gelegenen Hause sein Weib Sarah neugierig herausblickt. Durch die mittlere Waldlichtung erblickt man eine an einem Flusse gelegene Dorfpartie mit Kirche.\r
\r
Abbildung siehe Tafel 11.\r
\r
Auf Holz. Hohe 40 cm, Breite 64 cm.In Goldrahmen.\r
\r
##""" ;
    crm:P2_has_type aat:300435416 .

zac:87918_lot_27_id a crm:E42_Identifier ;
    rdfs:label "BO0614_87918-27" .

zac:87918_lot_27_title rdfs:label "Schlachtenszene" .

