zac:50794_lot_17 a la:Set ;
    rdfs:label "JUSTE SUSTERMANS 1597-1681,Anvers. Portait d'un cardinal de Medicis. Debout, revetu de la robe de cardinal bleue doublee de rouge et recouverte d'une riche aube en dentelles. La main gauche souleve et tient les plis du vetement; la main droite est posee sur le tricorne.  Dans le fond, une lourde draperie bleue, relevee d'un cote, decouvre la coupole de l'eglise Saint Pierre a Rome.  Toile Haut. 44 larg. 30." ;
    crm:P102_has_title zac:50794_lot_17_title ;
    crm:P1_is_identified_by zac:50794_lot_17_id ;
    crm:P67i_is_referred_to_by zac:50794_lot_17_description ;
    crm:P94i_was_created_by zac:creation_50794_lot_17 .

