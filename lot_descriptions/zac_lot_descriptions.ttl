zac:BO0624_44452_lot_117 a la:Set ;
    rdfs:label "117 - Grosse Portrat-Scheibe, eine Pfeilerarcade mit Saulen, darin in knieender Stellung und gefaltenen Handen der Vater mit seinen 7 Sohnen. Der Vater im gemusterten Brokatgewande mit Handschuh und Schwert,vor ihm der Helm mit Helmzierden, die Sohne im rothen Atlasgewande. Als Basis das Wappen der Familie Hormann von Guttenberg, das zum Theil noch in den braunen Fliessenboden hineingeht. Hochinteressante und seltene Scheibe. Hohe 88, Breite 67 cm., 3 Spruinge und einige Nothverbleiungen." ;
    crm:P102_has_title zac:BO0624_44452_lot_117_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0624_44452!BO0624_44452_000111-p.%2014.jpg/full/max/0/default.jpg> ;
