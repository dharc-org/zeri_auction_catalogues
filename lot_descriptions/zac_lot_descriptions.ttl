zac:83758_lot_10 a la:Set ;
    rdfs:label "BERGHEM. 1620-1685. La Sortie des troupeaux." ;
    crm:P102_has_title zac:83758_lot_10_title ;
    crm:P1_is_identified_by zac:83758_lot_10_id ;
