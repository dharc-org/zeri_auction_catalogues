zac:83754_lot_26 a la:Set ;
    rdfs:label "Decamps, Alexandre-Gabriel. Le Marchand de porcs. Scene d'Auvergne." ;
    crm:P102_has_title zac:83754_lot_26_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/cc91047f-1fbe-45c3-ba6c-e75ce57a5488/full/full/0/default.jpg> ;
