    crm:P102_has_title zac:BO0624_15368_lot_192_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0624_15368!BO0624_15368_000162-p.%2019.jpg/full/max/0/default.jpg> ;
