zac:BO0624_4399_lot_233 a la:Set ;
    rdfs:label "233 - JUSTE SUTTERMANS.  (1597-1681). PoRTRAIT (buste) du Cardinal Giancarlo de Medici,fls de Cosimo II Duc de Flo- bis. PANNEAU central de triptyque a fond dore. La Vierge, assise sur un trone go thique a haut dossier,vetue d'une robe rouge et d'un long manteau bleu, donne le sein au divin Enfant.Elle est entouree de plusieurs Saints, Saintes et Anges. Cadre en ogive sculpte et dore." ;
    crm:P102_has_title zac:BO0624_4399_lot_233_title ;
    crm:P138i_has_representation <nan> ;
    crm:P1_is_identified_by zac:BO0624_4399_lot_233_id ;
    crm:P67i_is_referred_to_by zac:BO0624_4399_lot_233_description .

