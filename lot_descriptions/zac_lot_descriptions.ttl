zac:BO0624_44631_lot_32 a la:Set ;
    rdfs:label "32 - — ViTRAIL rond,en grisaille,avec rehauts de jaune d'or, representant differentes scenes de supplice. Au premier plan,un bourreau arme d'un glaive decapite un condamne agenouille sur l'échafaud. A droite, un homme est maintenu dans une gangue et, a l'arriere-plan, un homme est pendu a un gibet.  A gauche, aux fenetres d'un batiment, des personnages assistent aux executions.  Travail allemand. xvi siecle." ;
    crm:P102_has_title zac:BO0624_44631_lot_32_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0624_44631!BO0624_44631_000111-p.%2014.jpg/full/max/0/default.jpg> ;
