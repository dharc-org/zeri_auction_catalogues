zac:15368_lot_219-232 a la:Set ;
    rdfs:label "Monogrammist H L (Hans Leitmaier? Nurnberg um 1540). Vierzehn runde Plaketten mit profiliertem Rand nach Duirers Marienleben und kleiner Passion. Die Serie ist ruckseitig vertieft nummeriert, in nachfolgender Ordnung:1.Verkindigung Mariae. 2. Geburt Christi. 3. Darstellung im Tempel. 4. Anbetung der Konige. 5. Flucht nach Agypten. 6. Der Knabe Christus im Tempel. 7. Christus erscheint seiner Mutter. 8. Kreuztragung. 9. Christus am Kreuz. 10. Grablegung. 11. Beweinung Christi. 12. Himmelfahrt Christi. 13. Sendung des hl. Geistes." ;
    crm:P102_has_title zac:15368_lot_219-232_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/936dcfb1-3b63-4824-a740-ccbd701c3599/full/full/0/default.jpg> ;
