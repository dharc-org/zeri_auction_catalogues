zac:50794_lot_59 a la:Set ;
    rdfs:label "HENRI VAN BALEN 1632,Anvers. Madone. Dans un oratoire, assise contre une porte surmontee d'une fenetre a croisillons, la Vierge Mere, en robe bleue drapee d'un manteau rouge, la tete nimbee d'une aureole, tenant en main le sein qui allaite son Divin Enfant place sur ses genoux, recouverts de langes. Un globe surmonte d'une croix est dans les mains de l'Enfant Jesus, qui a les bras tendus vers Saint Dominique, agenouille devant lui. A terre: un livre ouvert et a gauche du tableau, une table couverte d'un tapis a franges. Cuivre Haut. 30 larg.24." ;
    crm:P102_has_title zac:50794_lot_59_title ;
    crm:P1_is_identified_by zac:50794_lot_59_id ;
    crm:P67i_is_referred_to_by zac:50794_lot_59_description ;
