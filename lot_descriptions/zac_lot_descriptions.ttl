zac:50794_lot_27 a la:Set ;
    rdfs:label "GEORGES ROMNEY 1734-1802, Dalton. Bulles de Savon. Joli petit tableau representant une jeune femme decolletee, s'amusant a faire des bulles de savon.  Vetue d'une jupe rouge et d'un corsage bleu, le cou et les bras ornes de bijoux.  Les bras gauche est accoude sur une table ou l'on voit une assiette et un chalumeau; la main droite est gracieusement relevee,a la poursuite d'une bulle qui voltige dans lair.  Signe sur le rebord de la table.   Toile Haut. 24 larg. 21." ;
    crm:P102_has_title zac:50794_lot_27_title ;
    crm:P1_is_identified_by zac:50794_lot_27_id ;
    crm:P67i_is_referred_to_by zac:50794_lot_27_description ;
    crm:P94i_was_created_by zac:creation_50794_lot_27 .

