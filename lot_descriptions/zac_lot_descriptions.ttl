    rdfs:label "Francois Millet  geb. zu Antwerpen 1642, gest. zu Paris 1679. Landschaft." ;
    crm:P102_has_title zac:87918_lot_38_title ;
    crm:P1_is_identified_by zac:87918_lot_38_id ;
