zac:4670_lot_25_description a crm:E33_Linguistic_Object ;
    rdfs:label """25. BEAU MOBILIER DE CHAMBRE A COUCHER en noyer des Indes, intarsie de bois de rose,compose de:\r
\r
UN GRAND LIT DOUBLE, SOmmier, deux matelas, quatre coussins, couverture et rouleau en etoffe jaune;\r
\r
Deux coMMoDEs, avec petites galeries, dessus marbre rouge:\r
\r
DEUx TABLEs DE NUIT, dessus de marbre rouge;\r
\r
LAvABo a coulisse et armoire;\r
\r
SECRETAIRE a coulisse et tiroirs;\r
\r
TABLE-ToILETTE, avec miroir, dessus contourne, marbre blanc;\r
\r
EcRAN garni d’une broderie sur velours;\r
\r
GRAND FAUTEUIL garni de broderies;\r
\r
DEUX CHAISES idem;\r
\r
UNE TABLE A OUVRAGE;\r
\r
UN TRUMEAu a colonnes, avec deux candelabres a deux bougies.""" ;
    crm:P2_has_type aat:300435416 .

zac:4670_lot_25_id a crm:E42_Identifier ;
    rdfs:label "BO0624_4670-25" .

zac:4670_lot_25_title rdfs:label "BEAU MOBILIER DE CHAMBRE A COUCHER en noyer des Indes, intarsie de bois de rose,compose de: UN GRAND LIT DOUBLE, SOmmier, deux matelas, quatre coussins, couverture et rouleau en etoffe jaune;  Deux coMMoDEs, avec petites galeries, dessus marbre rouge:  DEUx TABLEs DE NUIT, dessus de marbre rouge;  LAvABo a coulisse et armoire;  SECRETAIRE a coulisse et tiroirs;  TABLE-ToILETTE, avec miroir, dessus contourne, marbre blanc;  EcRAN garni d’une broderie sur velours;  GRAND FAUTEUIL garni de broderies;  DEUX CHAISES idem;  UNE TABLE A OUVRAGE;  UN TRUMEAu a colonnes, avec deux candelabres a deux bougies." .

