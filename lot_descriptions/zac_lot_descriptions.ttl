zac:15350_lot_93 a la:Set ;
    rdfs:label "Charles VI. Chaise ou double d'or. KARoLvs DEI GRACIA. FRANcoRuM. REx. Le roi assis de face sur un siege dont les montants sont ornes de tetes de lions entre deux écus de France;il tient l'epee et le sceptre, deux lions sont couches a ses pieds. Le sujet est entoure d'une rOSaCe. R.XPC.VINCIT. XPC. REGNAT. XPC.IMPERAT. Croix feurdelisee cantonnee de quatre lis dans une rosace cantonnee de huit lis." ;
    crm:P102_has_title zac:15350_lot_93_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/8508d3df-9a3f-4cfa-ba1e-92e8801594c5/full/full/0/default.jpg> ;
    crm:P1_is_identified_by zac:15350_lot_93_id ;
    crm:P2_has_type <http://w3id.org/zac/type/monete> ;
    crm:P67i_is_referred_to_by zac:15350_lot_93_description .

zac:15350_lot_93_description a crm:E33_Linguistic_Object ;
    rdfs:label """- 93-Charles VI. Chaise ou double d'or. KARoLvs DEI GRACIA. FRANcoRuM. REx. Le roi assis de face sur un siege dont les montants sont ornes de tetes de lions entre deux écus de France;il tient l'epee et le sceptre, deux lions sont couches a ses pieds. Le sujet est entoure d'une rOSaCe. R.XPC.VINCIT. XPC. REGNAT. XPC.IMPERAT. Croix feurdelisee cantonnee de quatre lis dans une rosace cantonnee de huit lis.\r
\r
Les mots sont separes par deux croisettes; le point, place sous la neuvieme lettre, signifie que cette piece fut frappee a La Rochelle (H., 9). —Poids, 6 gr. 10.\r
\r
Monnaie excessivement rare, en tres bel etat de con- servation.\r
\r
Planche V.""" ;
    crm:P2_has_type aat:300435416 .

