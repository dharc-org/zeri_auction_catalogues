zac:BO0624_23222_lot_322 a la:Set ;
    rdfs:label "322 - Desgl.,ein goldener Ring, der Reif an den Enden in zwei gewundene Drahte ibergehend, die,in Voluten ausgehend, den in ovaler, hoher Fassung sitzenden Stein tragen. D.2,1. Gewicht.5 g.-Eine kleine, getriebene, silberne Scheibenfibel, die Oberseite kreuzformig geteilt,in den vier Feldern ein sich wiederholendes Beschlagstickchen, alle Teile versilbert und mit punzierten Kreis- und Strichreihen verziert.- Zwei silberne Ohrringe.-Ein verzierter Bronze-Stilus.-Ein Kamm,zweizeilig mit doppelter Verstarkung, mit Strichverzierung.-Eine Perlkette.-—Ein Hackmesser.——Ein Messer. Mulhofen. Abb. Tafel 5." ;
    crm:P102_has_title zac:BO0624_23222_lot_322_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0624_23222!BO0624_23222_000131-p.%2020.jpg/full/max/0/default.jpg> ;
