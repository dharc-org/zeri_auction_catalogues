zac:83733_lot_44 a la:Set ;
    rdfs:label "ZIEM. La Gondole." ;
    crm:P102_has_title zac:83733_lot_44_title ;
    crm:P1_is_identified_by zac:83733_lot_44_id ;
    crm:P67i_is_referred_to_by zac:83733_lot_44_description ;
    crm:P94i_was_created_by zac:creation_83733_lot_44 .

zac:83733_lot_44_description a crm:E33_Linguistic_Object ;
    rdfs:label """44\r
\r
Elegante et rapide, elle passe sur les eaux bleutees du canal, portant des personnages qu'abrite une tente d'etoffe rouge.\r
\r
Signe a gauche, en bas.\r
\r
Panneau. Haut., 27 cent.; larg, 5o cent.\r
\r
## ZIEM\r
\r
Le Bateau d'Ulysse.\r
\r
Des rochers de la cote,les sirenes appellent de leur voix enchanteresse le bateau d'Ulysse, qui vogue vers elles toutes voiles dehors.\r
\r
Signe a droite, en bas.\r
\r
Toile. Haut., 56 cent.; larg., 85 cent.\r
\r
<!-- image -->\r
\r
## STEVENS\r
\r
A maree haute.\r
\r
Signe a gauche, en bas, et date : 82.\r
\r
Panneau. Haut., 26 cent.; larg., 40 cent.\r
\r
## THORNLEY\r
\r
Un Village dans le brouillard, le matin. Signe a droite, en bas.\r
\r
Toile. Haut., 58 cent.; larg, 72 cert.\r
\r
## ZIEM\r
## BRACQUEMOND""" ;
    crm:P2_has_type aat:300435416 .

