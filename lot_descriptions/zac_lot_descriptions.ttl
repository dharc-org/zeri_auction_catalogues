zac:BO0624_4399_lot_443 a la:Set ;
    rdfs:label "443 - BocAL en argent dore. Ce bocal,en forme de cone renverse,repose sur une tige qui nait d'une base circulaire ornee de gros godrons spheriques. L'extremite superieure de la base et la partie inferieure du vase sont garnies d'une collerette de feuillages frisees sur le borde du couvercle, godronne, se redresse un rang de fleurs frises,sortant d'un petit vase a deux anses. Travail allemand. XVIe siecle." ;
    crm:P102_has_title zac:BO0624_4399_lot_443_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0624_4399!BO0624_4399_000321-p.%2058.jpg/full/max/0/default.jpg> ;
