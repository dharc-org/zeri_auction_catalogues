    rdfs:label "TITO CONTI - LA VISITE CHEZ LE CARDINAL" ;
    crm:P102_has_title zac:65729_lot_4_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/98553f4a-6301-4344-8edd-5d654b09feac/full/full/0/default.jpg> ;
