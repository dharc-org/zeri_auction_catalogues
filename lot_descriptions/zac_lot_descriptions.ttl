zac:15368_lot_192 a la:Set ;
    rdfs:label "Suddeutsch.Ende 15. Jahrh. KuBtafel. Hl. Veronika. Die Heilige in faltigem Untergewand, Kopftuch und Mantel steht" ;
    crm:P102_has_title zac:15368_lot_192_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/51d09aea-569a-4335-bd48-89a170b36d6b/full/full/0/default.jpg> ;
    crm:P1_is_identified_by zac:15368_lot_192_id ;
    crm:P67i_is_referred_to_by zac:15368_lot_192_description .

zac:15368_lot_192_description a crm:E33_Linguistic_Object ;
    rdfs:label """- 192 KuBtafel. Hl. Veronika. Die Heilige in faltigem Untergewand, Kopftuch und Mantel steht\r
- auf Grasboden. Mit den ausgebreiteten Armen halt sie das Tuch mit dem Antlitz Christi. Die Figur ist auf eine rechteckige Platte aufgelegt, die einen Rundbogen mit doppelter Saulenstellung zeigt. In den Zwickeln die Brustbilder zweier Engel. Oben glatter Fries mit der Inschrift: (SANTA MA)RIA GRATIA PLENA Ein ahnlicher Fries bildet den unteren Abschluf der Plakette.Inschrift:PAX TIBI SEMPER SIT\r
\r
Die Figur der Heiligen ist Schongauers Stich B. 66 entnommen. Bronze. Original. Figur H.76.—Tafel H.104—B.85. Braun 1.""" ;
    crm:P2_has_type aat:300435416 .

