zac:50794_lot_6_description a crm:E33_Linguistic_Object ;
    rdfs:label """## 6.Madone.\r
\r
Sur fond or, entouree d’une nuee d’anges, la Vierge, vue de face, est assise tenant I' Enfant- Jesus.\r
\r
Elle porte une robe rose recouverte d'un manteau cou- stelle d'or dont les plis entourent le Divin Enfant.\r
\r
Un des meilleurs tableaux des temps primitifs.\r
\r
Bois Haut. 68 larg. 61.\r
##""" ;
    crm:P2_has_type aat:300435416 .

zac:50794_lot_6_id a crm:E42_Identifier ;
    rdfs:label "BO0624_50794-6" .

zac:50794_lot_6_title rdfs:label "AMBROISE LORENZETTI  XIVme siecle, Sienne. Madone.  Sur fond or, entouree d’une nuee d’anges, la Vierge, vue de face, est assise tenant I' Enfant- Jesus.  Elle porte une robe rose recouverte d'un manteau cou- stelle d'or dont les plis entourent le Divin Enfant.  Un des meilleurs tableaux des temps primitifs.  Bois Haut. 68 larg. 61." .

zac:50794_lot_7 a la:Set ;
    rdfs:label "PHILIPPE MEMMI 1332,Sienne. Saint Paul et Saint Jean Baptiste. Sur fond or, Saint Jean, vu de profil, est debout, vetu d'une peau de mouton sur laquelle est drape un manteau rose de deux tons, borde dans le bas d'un galon or; les cheveux epars sont recouverts d'un fichu. ll tient dans la main droite, une bande avec l'inscription: \" Voix du desert,; la main gauche indique l' inscription.  Debout, a cote de lui, Saint Paul en tunique bleue ornee dans le bas d'un galon argent et recouverte d'une draperie. La tete est entouree d'une aureole. La main droite soutient une epee; un livre rouge est dans la main gauche.  Bois Haut. 112 larg. 73." ;
    crm:P102_has_title zac:50794_lot_7_title ;
    crm:P1_is_identified_by zac:50794_lot_7_id ;
    crm:P67i_is_referred_to_by zac:50794_lot_7_description ;
    crm:P94i_was_created_by zac:creation_50794_lot_7 .

