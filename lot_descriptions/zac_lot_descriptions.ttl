    rdfs:label "TASSAERT. Sarah la Baigneuse." ;
    crm:P102_has_title zac:83742_lot_17_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/3512264c-3093-4397-a043-266368ec7a35/full/full/0/default.jpg> ;
    crm:P1_is_identified_by zac:83742_lot_17_id ;
