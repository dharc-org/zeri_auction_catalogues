zac:BO0624_4482_lot_67 a la:Set ;
    rdfs:label "67 - Raibolini Francois, dit《le Francia》—1460-1535. La Vierge au Chardonneret. la main il tient un chardonneret. A sa gauche, Saint Benoit. Fond de paysage. Cette magnifique peinture, malgre ses quelques parties restaurees, merite d'attirer l'attention des amateurs.  Ce tableau a ete documente par Achille Fulli, peintre figuriste Bolonais et sanctionne par l'Academie Royale des Beaux Arts de Bologne(28 aout 1872 et 14 dec.1874）. Bois.Riche encadrement a tabernacle en bois dore et sculpte. 0.60 X0.48." ;
    crm:P102_has_title zac:BO0624_4482_lot_67_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0624_4482!BO0624_4482_000391-p.%2014.jpg/full/max/0/default.jpg> ;
