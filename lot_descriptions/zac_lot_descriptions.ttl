    crm:P67i_is_referred_to_by zac:15271_lot_121_description ;
    crm:P94i_was_created_by zac:creation_15271_lot_121 .

zac:15271_lot_121_description a crm:E33_Linguistic_Object ;
    rdfs:label """- 121 Der heil. Antonius von Padua ? Der vor einer Halle von vorne stehende Heilige im Monchsgewande tragt in der Rechten das Kreuz Christi. Mit der Linken rafft er sein Gewand,in dem er Blumen tragt.Neben ihm steht ein Putto,der mit beiden Handchen einen Kranz emporhalt. Im Grunde Kirchengebaude. B.—. Mol.. 103x72 mm.Bronze.Altvergoldetes,vorzugliches Exemplar.\r
\r
Die drei vorstehenden Plaketten gleichen Formats stammen von der Hand desselben Meisters aus dem Beginn der Barockzeit.""" ;
    crm:P2_has_type aat:300435416 .

