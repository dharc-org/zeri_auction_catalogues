zac:23222_lot_326 a la:Set ;
    rdfs:label "Desgl., eine goldene Scheibenfibel,reich mit Steinen besetzt. Am Rand acht kleine Almandine in dreieckiger Fassung, zwischen denselben abwechselnd ein runder, weifer und ein viereckiger, gruiner Stein. Nach der Mitte hin folgt ein weiterer Kreis von unregelmaBig verteilten roten, weiBen und blauen Steinen in viereckiger Fassung, sodann die mittlere, groBe,blaue Perle in hoher,ovaler Fassung,umgeben von einem Kranz lage zeigt sich als punzierte Bronzeplatte mit Nadelhalter und eiserner Nadel. D. 5.-Ein Bronzearmband mit Querriemen und Kerbschnitt verziert.—Eine bronzene, durchbrochene Zierscheibe.—Eine Gurtelschnalle.—Eine Riemenzunge.—Ein Kamm, zweizeilig.-Eine Perlkette. Ein mit Eindricken verzierter Spinnwirtel. Mulhofen. Abb.Tafel 8." ;
    crm:P102_has_title zac:23222_lot_326_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/d7b5f013-71ee-4f53-8aeb-08bab98b44e1/full/full/0/default.jpg> ;
    crm:P1_is_identified_by zac:23222_lot_326_id ;
    crm:P2_has_type <http://w3id.org/zac/type/oggetti_in_ferro> ;
    crm:P67i_is_referred_to_by zac:23222_lot_326_description .

