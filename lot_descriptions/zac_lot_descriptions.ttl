zac:BO0624_4671_lot_44 a la:Set ;
    rdfs:label "44 - ANTOINE VAN DYCK.  (1599-1641). PORTRAITDU MARQUIS AMBROISE SPINOLA. Le patricien genois,debout, regardant presque de face, habille en armure, une fraise a quatre rangees de dentelle au col,la Toison d'or sur la poitrine la main gauche appuyee sur l'epee et de la droiteil tient lebaton de commandement.D'apresla biographie deVan Dyck, ce tableau lui fut commande par le Marquis Spinola avant son depart pour Madrid. Il resta toujours dans la famille Spinola et ce ne fut que par heritage que le Prince Centurione en devint possesseur. Tous les guides de Genes signalent tout particulierement ce tableau a l'attention du public. Nous avons bien des raisons pour croire que le carton de ce portrait soit dans la collection du duc de Buceleugh a Londres." ;
    crm:P102_has_title zac:BO0624_4671_lot_44_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0624_4671!BO0624_4671_000061-p.%208.jpg/full/max/0/default.jpg> ;
    crm:P1_is_identified_by zac:BO0624_4671_lot_44_id ;
    crm:P67i_is_referred_to_by zac:BO0624_4671_lot_44_description ;
    crm:P94i_was_created_by zac:creation_BO0624_4671_lot_44 .

