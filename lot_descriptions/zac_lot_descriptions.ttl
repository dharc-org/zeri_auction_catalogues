zac:BO0624_15368_lot_375_description a crm:E33_Linguistic_Object ;
    rdfs:label """- 375 Kronung Mariae. Auf einer von Engeln getragenen Wolke sitzen Gott Vater und Gott\r
- Sohn, sie halten die Krone iber die knieende, nach links gewendete Maria, dariber die Taube. Unten weite Fluflandschaft mit Bergen, Bricke und Siedelungen.\r
\r
Aus Sammlung Parpart (Auktionskat. Berlin 1912, Nr. 1169). Kupfer. Alte Treibarbeit. Oben abgerundet. Braun 196.\r
\r
##""" ;
    crm:P2_has_type aat:300435416 .

