zac:BO0624_15351_lot_1813 a la:Set ;
    rdfs:label "1813 - Vers1625.Quatre petites medailles anglaises,d'un travail tres fin,ressemblant a des pieces gravees, representant des bustes de Charles I'd'Angleterre et de sa famille en riches costumes.Par Simon de Pas.- 4 pieces." ;
    crm:P102_has_title zac:BO0624_15351_lot_1813_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0624_15351!BO0624_15351_000172-p.%2031.jpg/full/max/0/default.jpg> ;
    crm:P1_is_identified_by zac:BO0624_15351_lot_1813_id ;
    crm:P67i_is_referred_to_by zac:BO0624_15351_lot_1813_description .

zac:BO0624_15351_lot_1813_description a crm:E33_Linguistic_Object ;
    rdfs:label """- 1813 Vers1625.Quatre petites medailles anglaises,d'un travail tres fin,ressemblant a des pieces gravees, representant des bustes de Charles I'd'Angleterre et de sa famille en riches costumes.Par Simon de Pas.- 4 pieces.\r
\r
(8.75 grammes).A.\r
\r
Tres jolies pieces en superbe condition.- Rares surtout en cet etat.\r
\r
- a.\r
\r
yoici les details:\r
\r
- b.\r
- Jacques I, avec chapeau; au revers: Charles I, a tete nue.\r
- c. Charles I et Henriette-Marie, bustes accoles;au revers,les armes d'Angleterre et de France reunies.\r
- Charles I, avec chapeau; an revers:Henriette-Marie de France, son epouse.\r
- d.Charles I et Henriette-Marie,bustes accoles; au revers, trois couronnes reunies par deux sceptres.\r
\r
ouvrage: Ungedruckte Stiche. Materialien und Anregungen aus Grenzgebieten der Kupferstichkunde.Wien,191l, p.323 a 325.1l en dit e.a.:Alle die angefihrten Denkmaler sind Beispiele einer.... Gruppe merkwirdiger gestochener Arbeiten. Die eigentliche Sticherarbeit ist eine muhsame Gravierung in besonders hartem Material, ein Stahlstich,kann man sagen.... Gerade diese Technik scheint eine England eigentimliche zu sein.... Unter den Kinstlern, die diese Arbeiten geschaffen haben, spielt Simon de Passe die Hauptrolle Voir planehe IV.\r
\r
-""" ;
    crm:P2_has_type aat:300435416 .

