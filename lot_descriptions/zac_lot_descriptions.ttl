zac:81812_lot_4 a la:Set ;
    rdfs:label "Lorenzetti Ambrogio.1323-1348. San Giovanni e un altro Santo.Tavola a fondo oro di freschezza introvabile.Capolavoro di pittura senese! Cornice a tabernacolo in legno scolpito e dorato.Alt. cm.90, larg. cm.80. Richiamo lattenzione dei collezionisti e dei critici sopra questo importante dipinto,per lungo tempo attribuito a Beato Angelico del quale ha tutta la vivace,smagliante bellezza delle tinte,la drappeggiatura  delle stoffe.Dalla critica recente e stato attribuito al Lorenzetti." ;
    crm:P102_has_title zac:81812_lot_4_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/e5ace432-40e6-4ba0-845e-e879f99fa14b/full/full/0/default.jpg> ;
    crm:P1_is_identified_by zac:81812_lot_4_id ;
    crm:P2_has_type <http://w3id.org/zac/type/cornici> ;
