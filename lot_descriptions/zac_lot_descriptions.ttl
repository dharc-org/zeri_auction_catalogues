    rdfs:label "ELSHEIMER, Adam. 1578-1620. CAMPEMENT ATTAQUE PAR UN LION." ;
    crm:P102_has_title zac:83725_lot_71_title ;
    crm:P1_is_identified_by zac:83725_lot_71_id ;
    crm:P67i_is_referred_to_by zac:83725_lot_71_description ;
    crm:P94i_was_created_by zac:creation_83725_lot_71 .

zac:83725_lot_71_description a crm:E33_Linguistic_Object ;
    rdfs:label """71. CAMPEMENT ATTAQUE PAR UN LION.\r
\r
Peinture sur cuivre, signee et datee 1614.\r
\r
Un homme est renverse par un lion qu'on voit de face; sur un tronc d'arbre, un autre penche derriere et vers la bete;un cavalier a droite va la frapper; a gauche, un homme et un cheval s'enfuient. Paysage pittoresque avec les feux du campement.\r
\r
Haut.o4o,larg.o54.\r
## PEINTURE FLAMANDE\r
\r
