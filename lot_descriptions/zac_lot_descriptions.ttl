zac:23222_lot_315 a la:Set ;
    rdfs:label "Desgl., eine goldene Scheibenfibel, die Oberseite in AuBenzone und Mittelfeld geteilt.Das Mittelfeld stellt sich als ein groBer, getriebener Buckel dar,umrahmt von einem goldenen Perlband,an dem nach dem Buckel Die AuBenzone zieren vier vierteilige Almandinauflagen, abwechselnd mit zwei Almandinen und zwei grunen Steinen in viereckiger Fassung. Das Feld ist ganz mit verschlungenen Filigranmustern bedeckt. Die Unterhalbkugelig und gerippt, die Oberseite flach, in der Mitte blauer Stein in runder Fassung, darum vier kleine ebenso gefaBte Perlen,getrennt jedesmal durch kleine Goldkorner.Eine bronzene Schnalle ohne Dorn. Zwei Bronzeringe mit je vier bronzenen Plattchen mit Niete.-- Zwei Bronzeringe.Kleine Bronzefibel Minden b.Trier. Abb.Tafel 5." ;
    crm:P102_has_title zac:23222_lot_315_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/de64dc67-1b66-4643-8662-b7c76adf33de/full/full/0/default.jpg> ;
    crm:P1_is_identified_by zac:23222_lot_315_id ;
    crm:P2_has_type <http://w3id.org/zac/type/oggetti_in_ferro> ;
    crm:P67i_is_referred_to_by zac:23222_lot_315_description .

