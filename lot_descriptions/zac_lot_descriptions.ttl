zac:BO0624_44452_lot_126 a la:Set ;
    rdfs:label "126 - Grosse gothische Scheibe gegen die Luft Crucifixus zwischen Maria und Johannes, vor ihnen in kniender Stellung und gefaltenen Handen eine Figur in ganzer gothischer Rustung mit dem goldenen Vlies, vor ihm liegt der gefingerte Kampfhandschuh und Eisenhut. Etwas seitwarts der heilige Franciscus. Als Basis dient eine stufenartige Abtheilung. Die Umrahmuug bilden wulstartige Saulen, dazwischen Engel und Capitaler mit Blattwerk. Hohe 70, Breite 57 cm., 7 Springe und 8 alte Erg. Schone und seltene Scheibe aus dem Anfang des 16. Jahrh. Siehe Abbildung II." ;
    crm:P102_has_title zac:BO0624_44452_lot_126_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0624_44452!BO0624_44452_000112-p.%2015.jpg/full/max/0/default.jpg> ;
