zac:15268_lot_13_description a crm:E33_Linguistic_Object ;
    rdfs:label """- 13-Deux sTATuETTEs en bronze patine. Venise,\r
- xvr siecle.\r
\r
Elles representent Bacchus et Ceres nus, debout,le dieu remplissant une coupe,la deesse tenant une gerbe de ble. Bases en marbre.\r
\r
Haut. des bronzes : 31 cent.""" ;
    crm:P2_has_type aat:300435416 .

zac:15268_lot_13_id a crm:E42_Identifier ;
    rdfs:label "BO0624_15268-13" .

zac:15268_lot_13_title rdfs:label "DEUX STATUETTES en bronze patine. Venise, xvi siecle.." .

zac:15268_lot_14 a la:Set ;
    rdfs:label "STATUETTE en bronze. Venise, xvi siecle." ;
    crm:P102_has_title zac:15268_lot_14_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/e9034181-bf06-4c21-9127-c053c33f5e0a/full/full/0/default.jpg> ;
    crm:P1_is_identified_by zac:15268_lot_14_id ;
    crm:P2_has_type <http://w3id.org/zac/type/bronzi> ;
    crm:P67i_is_referred_to_by zac:15268_lot_14_description .

zac:15268_lot_14_description a crm:E33_Linguistic_Object ;
    rdfs:label """- 14—— SrATuETTE en bronze. Venise, xvie siecle.\r
\r
Venus nue debout, le corps reposant sur la jambe gauche; le pied droit est pose sur une sphere,la jambe etant repliee. Elle leve le bras gauche, et retient sur le bras droit une draperie qui tombe jusqu'a terre. La statuette est placee sur un chapiteau a oves. Base cylindrique en marbre rouge.\r
\r
Haut. du bronze: 24 cent.""" ;
    crm:P2_has_type aat:300435416 .

zac:15268_lot_14_id a crm:E42_Identifier ;
    rdfs:label "BO0624_15268-14" .

zac:15268_lot_14_title rdfs:label "STATUETTE en bronze. Venise, xvi siecle." .

