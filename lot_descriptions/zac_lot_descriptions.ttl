zac:BO0624_4399_lot_65 a la:Set ;
    rdfs:label "65 - BENEDETTO DA ROVEZZANO. BENITIER quadrilobe,en marbe blanc,forme par quatre coquilles a striures menues et separees par quatre anges les ailes deployees,le ecorps termine en feuilled'acanthe. A l'interieur, les quatre coquilles sont ouvertes et sculptees artistiquement et completent la belle decoration de cemarbre. L'admirable modele des anges,l'elegante simplicite de forme de la coupe et la finesse d'execution la font attribuer au celebre maitre." ;
    crm:P102_has_title zac:BO0624_4399_lot_65_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0624_4399!BO0624_4399_000101-p.%2014.jpg/full/max/0/default.jpg> ;
