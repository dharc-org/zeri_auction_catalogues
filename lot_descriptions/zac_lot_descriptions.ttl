zac:50014_lot_19_description a crm:E33_Linguistic_Object ;
    rdfs:label """- 19 Cabinet a garder le linge et les papiers de famille en noyer\r
- sculpte, le corps superieur a deux battants, fronton saillant et ondule a crete sculpte a contours. Le corps inferieur a quatre tiroirs bombes munis de cuivres ciseles de l'epoque,le devant a deux, pattes d'aigle. Superbe meuble du commencement du XVI1Ime siecle. Haut. 2.47, larg. 2.02, prof. 0.66 M.""" ;
    crm:P2_has_type aat:300435416 .

zac:50014_lot_19_id a crm:E42_Identifier ;
