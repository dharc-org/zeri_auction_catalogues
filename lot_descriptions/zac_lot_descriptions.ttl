zac:83725_lot_96_description a crm:E33_Linguistic_Object ;
    rdfs:label """96.——RUINES D'UNE VILLE ANTIQUE.\r
\r
Peinture sur bois, signee Joh. Beer et datee 1671.\r
\r
Au premier plan, bouvier avec trois vaches et un chien;plusieurs autres personnages.\r
\r
Haut.om41,larg.om83.\r
\r
## CuYP, Aelbert. 1620-1691.""" ;
    crm:P2_has_type aat:300435416 .

