zac:BO0624_4399_lot_220 a la:Set ;
    rdfs:label "220 - PETIT PLAT creux sur piedouche bas, dit 《fruttiera》.Au pourtour une decoration de poires et cerises en relief et a refets de rubis et de feuilles a reflets d'or.Au centre, circonscrit d'un listel, deux genies ailes tenant un écusson avec la croix latine,armoiries du peuple de Bologne et dans lexergue l'inscription:OPUS SPERANDEI.Reproduction du revers d'une medaille,executee du fameux medailleur Sperandio pour Giovanni II Bentivoglio. C'est sans aucun doute un des premiers travaux de Mastro Giorgio.Piece tres interessante." ;
    crm:P102_has_title zac:BO0624_4399_lot_220_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0624_4399!BO0624_4399_000181-p.%2030.jpg/full/max/0/default.jpg> ;
    crm:P1_is_identified_by zac:BO0624_4399_lot_220_id ;
    crm:P67i_is_referred_to_by zac:BO0624_4399_lot_220_description .

