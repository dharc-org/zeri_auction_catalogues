zac:BO0624_50794_lot_43 a la:Set ;
    rdfs:label "43 - MEINDERT HOBBEMA 1638-1709,Amsterdam. La Sieste. Il est midi: c'est l'heure de la sieste. Assis sur un tertre, au bord de la route, a l'ombre de grands arbres deux villageois, vus de dos, devisent gaiment apres avoir pris le frugal repas que leur a apporte une jeune femme placee devant eux. Debout, celle-ci s'apprete a rentrer au village que l'on apercoit au loin dans le fond du tableau, mais amusee par leurs joyeux propos, elle s'attarde sans prendre garde aux nuages qui couvrent le ciel.  On voit, sur le chemin, l'empreinte de profonds sillons laissee par une charrette de foin disparue au tournant de la route.  Bois Haut. 40 larg. 50." ;
    crm:P102_has_title zac:BO0624_50794_lot_43_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0624_50794!BO0624_50794_000292-p.%2027.jpg/full/max/0/default.jpg> ;
    crm:P1_is_identified_by zac:BO0624_50794_lot_43_id ;
    crm:P67i_is_referred_to_by zac:BO0624_50794_lot_43_description ;
    crm:P94i_was_created_by zac:creation_BO0624_50794_lot_43 .

