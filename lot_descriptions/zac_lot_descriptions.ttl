    crm:P102_has_title zac:BO0614_87918_lot_52_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0614_87918!BO0614_87918_000092-p.%2011.jpg/full/max/0/default.jpg> ;
