zac:87918_lot_60_description a crm:E33_Linguistic_Object ;
    rdfs:label "## 60 Dorflandschaft. Im reich bewaldeten Vordergrunde treibt ein Bauernpaar eine kleine Rinderherde dem Wassertimpel Zu. Dieser wird von einem rechts aus einem Parke kommenden Bachlein gespeist. Ein Landhaus und ein paar kleinere Hauser bilden hier einen Gutsbesitz. Auf der Strafe promeniert die Gutsherrschaft mit Kindern. Mit Ausblick auf die bewasserte und mit Baumen reich bestandene Landschaft im Hintergrunde." ;
    crm:P2_has_type aat:300435416 .

zac:87918_lot_60_id a crm:E42_Identifier ;
