    crm:P67i_is_referred_to_by zac:15368_lot_345_description .

zac:15368_lot_345_description a crm:E33_Linguistic_Object ;
    rdfs:label """- 345 Pieta. Unter dem Kreuzstamm sitzt auf einer Rasenbank Maria, in ihrem Schof ruht halb aufgerichtet der Leichnam Christi, das Haupt nach rechts geneigt. Am Boden Totenkopf, Dornenkrone und Zange. Im Hintergrund die Stadt Jerusalem.\r
\r
Die Plakette geht auf ein italienisches Vorbild zurick.\r
\r
Bronze. Alter GuB. Ose.H.180.-B.124.\r
\r
Braun 194.—Vgl. Bange 5771 und 5772.\r
\r
Tafel 31\r
\r
Kreuzstamm fehit. Hintergrund stilisierte Berge, links die drei Kreuze. Himmel und Wolken.\r
\r
Vgl.Braun.194. Bronze.Original.\r
\r
H.139.—B.96.\r
\r
Braun 195.\r
\r
Tafel 31""" ;
    crm:P2_has_type aat:300435416 .

