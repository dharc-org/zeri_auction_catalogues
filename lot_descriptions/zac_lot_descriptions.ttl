zac:23222_lot_317 a la:Set ;
    rdfs:label "Desgl,eine goldene Scheibenfibel, die Oberseite wird durch schmale, getriebene,von Filigran umrahmte Buckel in einen Kreis von acht Feldern geteilt, deren jedes auf niedrigem Buckel eine viereckige Fassung mit roter, gruiner oder weiBer Fillung tragt. Das etwas herausgetriebene Mittelfeld schmickt eine runde Perle in hoher Fassung, umgeben von einem Kranz kleiner Filigranringe. Die Unterseite ebenfalls Gold mit goldener Nadel und Nadelhalter. D. 48. Gewicht 42 g.-Ein bronzener Ohrring mit konischer Verdickung Ein Spinnwirtel aus grunem Glas mit weiBem" ;
    crm:P102_has_title zac:23222_lot_317_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/de64dc67-1b66-4643-8662-b7c76adf33de/full/full/0/default.jpg> ;
    crm:P1_is_identified_by zac:23222_lot_317_id ;
    crm:P2_has_type <http://w3id.org/zac/type/oggetti_in_ferro> ;
    crm:P67i_is_referred_to_by zac:23222_lot_317_description .

