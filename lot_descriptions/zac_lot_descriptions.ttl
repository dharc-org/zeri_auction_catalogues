zac:15271_lot_93 a la:Set ;
    rdfs:label "Lautizio de Perugia (?)  tatig in Perugia u. Rom. Reiterschlaeht. Vor einer turmreichen Stadt eine in heftigem Handgemenge befindliche Reiterschlacht.Die aus einem Stadttore ausgebrochenen Belagerten werden von den von links ansturmenden Feinden bedrangt. B. 703 var. Mol. 236. 131x96 mm. Bronze. Helle Patina. Vorziglich." ;
    crm:P102_has_title zac:15271_lot_93_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/efd46ecd-e3d2-4cdd-8f4b-ab1cf83956f9/full/full/0/default.jpg> ;
