zac:BO0624_4482_lot_13 a la:Set ;
    rdfs:label "13 - ECOLES FLAMANDE ET HOLLANDAISE.  Van Dyck Antoine—1599-1641 (ecole de). Portrait de jeune femme. Assise dans un fauteuil; le bras gauche pose sur l'accotoir, la main droite sur une table. Les cheveux coupes courts sont boucles et d'un blond roux. Elle porte une magnifique robe en brocart blanc et or; au cou une collerette tuyautee; en sautoir, une grosse chaine d'orfevrerie. Le fond est forme par 1.23X0.85. une draperie rouge. Toile. Cadre dore." ;
    crm:P102_has_title zac:BO0624_4482_lot_13_title ;
    crm:P138i_has_representation <nan> ;
    crm:P1_is_identified_by zac:BO0624_4482_lot_13_id ;
