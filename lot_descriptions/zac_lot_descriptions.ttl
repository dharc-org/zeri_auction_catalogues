    rdfs:label "1636 - (15)76. Piece de 40 sols.ESSAI EN ARGENT. Type: lecusson de la ville accoste du chiffre de la valeur:40, et surmonte de la date: 76.Inscrip-" ;
    crm:P102_has_title zac:BO0624_15351_lot_1636_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0624_15351!BO0624_15351_000092-p.%2015.jpg/full/max/0/default.jpg> ;
    crm:P1_is_identified_by zac:BO0624_15351_lot_1636_id ;
    crm:P67i_is_referred_to_by zac:BO0624_15351_lot_1636_description .

zac:BO0624_15351_lot_1636_description a crm:E33_Linguistic_Object ;
    rdfs:label """1636 (15)76. Piece de 40 sols.ESSAI EN ARGENT. Type: lecusson de la ville accoste du chiffre de la valeur:40, et surmonte de la date: 76.Inscrip-\r
\r
(Piece carree,uniface.——17.5 grammes).A.\r
\r
tion:"Pro aris et focis”.—Trouee.\r
\r
Cet essai en argent de la piece de 40 sols est de teute rarete.\r
\r
Au revers, quelque habitant a fait graver pendant le siege un voeu pour la delivrance de la ville:\r
\r
## MISEREBITVR X DNS\r
\r
## WOERDEN\r
\r
XIXFX\r
\r
De telles inscriptions faites sur une monnaie obsidionale pendant le siege de la ville, sont tres rares.\r
\r
Voir planche II.""" ;
    crm:P2_has_type aat:300435416 .

