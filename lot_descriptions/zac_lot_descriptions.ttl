zac:BO0624_15271_lot_174 a la:Set ;
    rdfs:label "174 - Art des Monogrammisten H.G. Suddeutsch.  Um 1570. Die Sehmiede des Vulkan. In einer baumereichen Landschaft mit Ausblick auf eine dem Kopfe.Links neben Vulkan schirt ein dritter Knecht die Esse. Rechts" ;
    crm:P102_has_title zac:BO0624_15271_lot_174_title ;
    crm:P138i_has_representation <nan> ;
    crm:P1_is_identified_by zac:BO0624_15271_lot_174_id ;
    crm:P67i_is_referred_to_by zac:BO0624_15271_lot_174_description ;
    crm:P94i_was_created_by zac:creation_BO0624_15271_lot_174 .

zac:BO0624_15271_lot_174_description a crm:E33_Linguistic_Object ;
    rdfs:label """- 174 Die Sehmiede des Vulkan. In einer baumereichen Landschaft mit Ausblick auf eine dem Kopfe.Links neben Vulkan schirt ein dritter Knecht die Esse. Rechts\r
- Stadt im Hintergrund sitzt Vulkan, cinen grade fuir Amor gegossenen Pfeil behammernd.Ein hinter ihm stehender Knecht hat den Hammer gesenkt;ein rechts vor ihm stehender,von hinten gesehener, schwingt seinen Hammer iber steht Venus mit Amor.Vor ihnen am Boden Kocher und Bogen.173 mm. Eisen. Treffliche Komposition. Sehr schon.\r
\r
(Siehe die stilistisch gleichen Arbeiten bei Braun-Walcher,Tafel XxVI-XxIX.)\r
##""" ;
    crm:P2_has_type aat:300435416 .

