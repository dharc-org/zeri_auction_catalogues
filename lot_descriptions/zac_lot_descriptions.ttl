zac:44631_lot_32 a la:Set ;
    rdfs:label "— ViTRAIL rond,en grisaille,avec rehauts de jaune d'or, representant differentes scenes de supplice. Au premier plan,un bourreau arme d'un glaive decapite un condamne agenouille sur l'échafaud. A droite, un homme est maintenu dans une gangue et, a l'arriere-plan, un homme est pendu a un gibet.  A gauche, aux fenetres d'un batiment, des personnages assistent aux executions.  Travail allemand. xvi siecle." ;
    crm:P102_has_title zac:44631_lot_32_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/f4398748-0d89-4af3-9b19-e5c6273bf0d4/full/full/0/default.jpg> ;
