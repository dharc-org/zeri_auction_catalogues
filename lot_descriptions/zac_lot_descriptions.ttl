zac:BO0614_87918_lot_68 a la:Set ;
    rdfs:label "68 - Unbekannt. Flamische Landschaft mit reicher figirlicher Staffage. 17. Jahrhundert." ;
    crm:P102_has_title zac:BO0614_87918_lot_68_title ;
