    rdfs:label "377 - Suddeutsch. Anfang 17. Jahrh. Gang nach Emmaus. Im Vordergrund schreitet Christus zwischen den beiden Jungern" ;
    crm:P102_has_title zac:BO0624_15368_lot_377_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0624_15368!BO0624_15368_000241-p.%2034.jpg/full/max/0/default.jpg> ;
