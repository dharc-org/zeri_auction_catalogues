zac:15268_lot_3 a la:Set ;
    rdfs:label "STATUETTE d'enfant sur un cheval en bronze a patine brune. Italie, xv siecle." ;
    crm:P102_has_title zac:15268_lot_3_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/1899f17d-37c1-4609-8726-199143200acd/full/full/0/default.jpg> ;
