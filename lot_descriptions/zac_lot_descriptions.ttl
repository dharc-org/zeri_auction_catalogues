zac:BO0624_23222_lot_287 a la:Set ;
    rdfs:label "287 - Desgl,eine Gurtelschnalle, der Bugel reich tauschiert mit Bronzestreifen und engem, silbernem Rautenmuster. Auf der kurzen, rechteckigen Ansatzplatte eine getriebene Silberplatte. In der Mitte ein GefaB, zu dessen Seiten je ein Pfau. Um dieses Mittelfeld ein breiter Streifen Ranken mit naturalistischen Blattern und Frichten.L. der Silberplatte 4,2,B.2,6.—Gurteltasche mit groBem Bronzebeschlag.Der Beschlag besteht aus vier Reihen Schuppen mit abwechselnd rundem und ausgezacktem AbschluB. Zu unterst drei hohe, ge triebene Buckel, darunter drei flache, gelochte Nieten. Das Ganze mit gepreBtem Leder eingefaBt. L.10, B.10,5.-Ein eisernes,viereckiges Beschlagstick mit vier verzierten Bronzenieten, in der Mitte ein runder Ausschnitt, darin ein in Bronzeblech getriebenes Brustbild. L. 5,5.-Ein zweites viereckiges Beschlagstick mit vier verzierten Bronzenieten. In der Mitte kreuzformiger Ausschnitt, darin ein in verschiedenen Mustern getriebenes Bronzeblech.L.6,5.Eine Perlkette.-Ein Messer.-Ein Spinnwirtel. Abb.Tafel4. Mulhofen." ;
    crm:P102_has_title zac:BO0624_23222_lot_287_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0624_23222!BO0624_23222_000102-p.%2015.jpg/full/max/0/default.jpg> ;
    crm:P1_is_identified_by zac:BO0624_23222_lot_287_id ;
    crm:P2_has_type <http://w3id.org/zac/type/oggetti_in_ferro> ;
    crm:P67i_is_referred_to_by zac:BO0624_23222_lot_287_description .

