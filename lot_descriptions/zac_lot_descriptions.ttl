zac:83725_lot_33_description a crm:E33_Linguistic_Object ;
    rdfs:label """33. ——LE CHRIST AU ROSEAU.\r
\r
Peinture sur toile.\r
\r
Le Christ a mi-corps, les poignets lies, avec un manteau et un roseau.\r
\r
a Madridet de celui du Louvre(no 1582)danslagrande galerie;etude pour le tableau de Chantilly(n32).\r
\r
Replique,avec differences,du tableau(no467)du Prado\r
\r
Haut. om73, larg. om64.\r
\r
## CAMPI, Giulio. 1502-1572.""" ;
    crm:P2_has_type aat:300435416 .

