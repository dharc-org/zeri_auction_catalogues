zac:50794_lot_93 a la:Set ;
    rdfs:label "JEAN-ANTOINE LICINIO  DIT  LE PORDENONE 1483-1539,Pordenone. Portrait de dame. Representee de face,a mi-corps, en robe noire avec guimpe en tulle blanc autour du decollete. Une grande chaine en forme un noeud a la naissance de la gorge et retombe sur le corsage en se dissimulant sous la main gauche posee sur la taille. De la main droite elle caresse un petit chien.  Toile Haut. 93 larg. 85." ;
    crm:P102_has_title zac:50794_lot_93_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/0cbda54f-fa83-4278-aba1-5b89f532f129/full/full/0/default.jpg> ;
