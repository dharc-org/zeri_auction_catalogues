    crm:P94i_was_created_by zac:creation_83742_lot_17 .

zac:83742_lot_17_description a crm:E33_Linguistic_Object ;
    rdfs:label """## 17—Sarah la Baigneuse.\r
\r
Dans son hamac elle se balance, laissant son pied droit effleurer la surface de l'eau.Sonbras droit est releve au-dessus de sa tete souriante et soutient l'écharpe de gaze bleue qui recouvrait son corps. A travers les grands arbres, le soleil pose sur l'eau des taches lumineuses.\r
\r
Signe a droite, en bas, du monogramme :""" ;
    crm:P2_has_type aat:300435416 .

zac:83742_lot_17_id a crm:E42_Identifier ;
    rdfs:label "BO0624_83742-17" .

zac:83742_lot_17_title rdfs:label "TASSAERT. Sarah la Baigneuse." .

zac:83742_lot_18 a la:Set ;
    rdfs:label "TASSAERT. L'Enfant endormi." ;
    crm:P102_has_title zac:83742_lot_18_title ;
    crm:P1_is_identified_by zac:83742_lot_18_id ;
    crm:P67i_is_referred_to_by zac:83742_lot_18_description ;
    crm:P94i_was_created_by zac:creation_83742_lot_18 .

zac:83742_lot_18_description a crm:E33_Linguistic_Object ;
    rdfs:label """18—LEnfant endormi.\r
\r
Etude.\r
\r
Toile.Haut.,17 cent.;larg.,21 cent.\r
\r
Vente Alexandre Dumas.\r
## 19 —— Une Ferme.\r
\r
A droite, de l'autre cote d'une montagne legerement en pente, quelques eglantiers et le mur d'une ferme dont les toitures dessinent leurs aretes sur le ciel bleu; a gauche la campagne jusqu'a la mer, dont la ligne bleue semble supporter le ciel voile de nuages gris.\r
\r
Signe a droite, en bas.\r
\r
Toile.Haut.,55cent.;larg.,91 cent.\r
\r
Vente Alerandre Dumas.\r
\r
<!-- image -->\r
\r
## VOLLON\r
\r
(ANTOINE)\r
<!-- image -->\r
\r
## AQUARELLES&amp;SEPIAS\r
\r
## FRAGONARD""" ;
    crm:P2_has_type aat:300435416 .

