zac:83758_lot_15 a la:Set ;
    rdfs:label "CRANACH, LUCAS SUNDER,DIT. 1472-1553. La Vierge a la grappe de raisin." ;
    crm:P102_has_title zac:83758_lot_15_title ;
    crm:P1_is_identified_by zac:83758_lot_15_id ;
