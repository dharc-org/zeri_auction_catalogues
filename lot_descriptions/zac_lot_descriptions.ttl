zac:BO0624_15351_lot_1881 a la:Set ;
    rdfs:label "1881 - MIDDELBOURG. COLLECTION IMPORTANTE DE BEAUX MEREAUX des gildes de Middelbourg, datant du XVIIe siecle.13 pieces (dont 12 en cuivre et 1 en plomb).-Voir Dirks, pl. LXI-LXXIII. d.1653.Dirks, page 371." ;
    crm:P102_has_title zac:BO0624_15351_lot_1881_title ;
    crm:P138i_has_representation <nan> ;
    crm:P1_is_identified_by zac:BO0624_15351_lot_1881_id ;
    crm:P2_has_type <http://w3id.org/zac/type/merletti> ;
    crm:P67i_is_referred_to_by zac:BO0624_15351_lot_1881_description .

zac:BO0624_15351_lot_1881_description a crm:E33_Linguistic_Object ;
    rdfs:label """- 1881 MIDDELBOURG. COLLECTION IMPORTANTE DE BEAUX MEREAUX des gildes de Middelbourg, datant du XVIIe siecle.13 pieces (dont 12 en cuivre et 1 en plomb).-Voir Dirks, pl. LXI-LXXIII.\r
\r
relative au metier.\r
\r
COLLECTION INTERESSANTE,LES PIECES ETANTD'UNE CONSERVATION EXCELLENTE. Cette collection constitue un beau document sur les metiers au XVIIe siecle. Les pieces portent les noms des doyens de chaque gilde et une représentation\r
\r
On y remarque les metiers suivants:\r
\r
Fruiteniers.1691.——Dirks,12.\r
\r
Bakkers.1656.—Dirks,6.\r
\r
Houtzagers.1621.-Dirks,14.\r
\r
Oudekleerkoopers. Sans date.—Dirks,32.\r
\r
Kuipers.1640.—Dirks,24.\r
\r
Schoenmakers.1662.—Dirks,35.\r
\r
St. Lucasgilde. 1618. —Dirks,41 (Dirks donne la date erronnee de 1678).\r
\r
Schoolmeesters.1628.—Dirks,37. Id.1653.Dirks, page 371.\r
\r
Timmerlieden.1671.—Dirks,45.\r
\r
Smeden.1690.-Dirks,42.\r
\r
Vettewariers. Sans date.—Dirks,59.\r
\r
Nous les vendrons par piece.\r
\r
Lakenkoopers.1689.-Dirks,62.""" ;
    crm:P2_has_type aat:300435416 .

