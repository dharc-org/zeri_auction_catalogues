zac:4399_lot_233 a la:Set ;
    rdfs:label "JUSTE SUTTERMANS.  (1597-1681). PoRTRAIT (buste) du Cardinal Giancarlo de Medici,fls de Cosimo II Duc de Flo- bis. PANNEAU central de triptyque a fond dore. La Vierge, assise sur un trone go thique a haut dossier,vetue d'une robe rouge et d'un long manteau bleu, donne le sein au divin Enfant.Elle est entouree de plusieurs Saints, Saintes et Anges. Cadre en ogive sculpte et dore." ;
    crm:P102_has_title zac:4399_lot_233_title ;
    crm:P1_is_identified_by zac:4399_lot_233_id ;
    crm:P67i_is_referred_to_by zac:4399_lot_233_description .

zac:4399_lot_233_description a crm:E33_Linguistic_Object ;
    rdfs:label """- 233.PoRTRAIT (buste) du Cardinal Giancarlo de Medici,fls de Cosimo II Duc de Flo-\r
- rence.Peinture sur toile.\r
\r
Haut.o.68X0.56.\r
\r
Voir illustration,planche18.\r
\r
## GERARD STARNINA.\r
\r
(1354-1403). - 233bis. PANNEAU central de triptyque a fond dore. La Vierge, assise sur un trone go thique a haut dossier,vetue d'une robe rouge et d'un long manteau bleu, donne le sein au divin Enfant.Elle est entouree de plusieurs Saints, Saintes et Anges. Cadre en ogive sculpte et dore.\r
\r
Haut. o.82 —Larg. o.49.\r
\r
##""" ;
    crm:P2_has_type aat:300435416 .

zac:4399_lot_233_id a crm:E42_Identifier ;
    rdfs:label "BO0624_4399-233" .

zac:4399_lot_233_title rdfs:label "JUSTE SUTTERMANS.  (1597-1681). PoRTRAIT (buste) du Cardinal Giancarlo de Medici,fls de Cosimo II Duc de Flo- bis. PANNEAU central de triptyque a fond dore. La Vierge, assise sur un trone go thique a haut dossier,vetue d'une robe rouge et d'un long manteau bleu, donne le sein au divin Enfant.Elle est entouree de plusieurs Saints, Saintes et Anges. Cadre en ogive sculpte et dore." .

zac:4399_lot_234 a la:Set ;
    rdfs:label "F. BOUCHER.  (1703-1770). TRIOMPHE DE VENUs. La belle et blonde deesse,nue, tournant a demi le dos au spectateur,et la tete tourneedetrois quarts a gauche, est a demi couchee sur une coquille recouverte d'une draperie couleur d'or. Elle tient de la main gauche une colombe qu'elle approche de sa bouche.Des petits Amours voltigent autour, et d'autres, ensemble a des Naiades et des Tritons,entourent la coquille portee par des dauphins voguant sur les fots. Charmant sujet traite avec une grace et un coloris incomparables,par le brillant maitre. On admire dans la collection de Mr.le baron Alfred de Rothscild un autre tableau du meme maitre representant le Triomphe de Venus et qui ne differe du tableau en vente que par quelques details et par la disposition inverse de groupe. Cadre en bois dore et richement sculpte." ;
    crm:P102_has_title zac:4399_lot_234_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/ed8e027a-bfb4-4c58-846d-095a50e0c2d6/full/full/0/default.jpg> ;
    crm:P1_is_identified_by zac:4399_lot_234_id ;
    crm:P67i_is_referred_to_by zac:4399_lot_234_description .

