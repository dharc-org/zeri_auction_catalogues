zac:83725_lot_25 a la:Set ;
    rdfs:label "ANT ALLEGRI dit LE CORREGE. 1494-1534. LA MADELEINE DEBOUT." ;
    crm:P102_has_title zac:83725_lot_25_title ;
    crm:P1_is_identified_by zac:83725_lot_25_id ;
    crm:P67i_is_referred_to_by zac:83725_lot_25_description ;
    crm:P94i_was_created_by zac:creation_83725_lot_25 .

zac:83725_lot_25_description a crm:E33_Linguistic_Object ;
    rdfs:label """25.——LA MADELEINE DEBOUT.\r
\r
Peinture sur toile.\r
\r
La Madeleine,debout presd'unrocher,estaccoudee sur un livre dans le feuillage;elle soutient de la main gauche une cassolette sur laquelle la main droite se pose; vetue dun manteau releve sur la tete, elle a la poitrine,les bras et lesjambesnus,lajambe droite croisee sur la jambe gauche, et semble etre a l'entree d'une grotte;derriere,un paysage.\r
\r
Variante de la Madeleine couchee du musee de Dresde (n 154）. Aux Offices de Florence, il ya une etude pour ce precieux tableau, attribuee a I'Ecole.\r
\r
Haut.om4o,larg.om32.\r
\r
## ANT. ALLEGRI dit LE CORREGE 1494-1534.""" ;
    crm:P2_has_type aat:300435416 .

zac:83725_lot_25_id a crm:E42_Identifier ;
    rdfs:label "BO0624_83725-25" .

