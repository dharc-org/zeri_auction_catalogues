    crm:P94i_was_created_by zac:creation_BO0614_87918_lot_49 .

zac:BO0614_87918_lot_49_description a crm:E33_Linguistic_Object ;
    rdfs:label """## 49\r
\r
## Der barmherzige Samariter.\r
\r
Vor dem an der Landstrafe stehenden Wirtshaus hebt ein Diener den Verwundeten vom Pferde, das ein Knabe am Zuigel festhalt.Unter der Tuir verhandelt der Samariter mit dem Wirte betreffs Auf brunnen. Rechts Ausblick in die Landschaft mit einem von einer Mauer umzogenen Park.Vorne\r
\r
Auf Holz. Hohe 78 cm, Breite 68 cm. In schwarzem Rahmen.\r
\r
nahme des Mannes, ein Bauer horcht von einem Fenster aus zu. Im Mittelgrunde ein Mann am Ziehrechts ein Hund.\r
\r
##""" ;
    crm:P2_has_type aat:300435416 .

zac:BO0614_87918_lot_49_id a crm:E42_Identifier ;
    rdfs:label "BO0614_87918-49" .

zac:BO0614_87918_lot_49_title rdfs:label "Schule des Rembrandt. Der barmherzige Samariter." .

zac:BO0614_87918_lot_4_description a crm:E33_Linguistic_Object ;
    rdfs:label """Im Mittelgrunde liegt zwischen den bewaldeten Ufern eine kleine Mihle. Vor dieser stehen Bauern an einem schmalen Bache. Vorne links sitzt ein Hirte bei seiner Herde, welche sich aus Rindern, Schafen und Ziegen zusammensetzt, weiter zurick steht eine Frau vor einem halb sichtbaren Haus. Den Hintergrund bildet eine von Huigeln begrenzte Wiesenlandschaft, auf der ein Hirte seine Schafe weidet.Weife Wolken bedecken strichformig den Himmel.\r
\r
Unten in der Mitte bez.:Bf.\r
\r
Auf Holz. Hohe 28 cm, Breite 38 cm. In Goldrahmen.""" ;
    crm:P2_has_type aat:300435416 .

