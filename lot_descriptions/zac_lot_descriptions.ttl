zac:BO0624_44631_lot_40 a la:Set ;
    rdfs:label "40 - IMPoRTANT VITRAIL, attribue a Hans Funk le Vieux, de Berne, d'apres un dessin de Niklaus Manuel (1470153g). Suisse. Commencement du xvi siecle." ;
    crm:P102_has_title zac:BO0624_44631_lot_40_title ;
    crm:P138i_has_representation <http://137.204.64.39/image/iiif/3/BO0624_44631!BO0624_44631_000141-p.%2018.jpg/full/max/0/default.jpg> ;
    crm:P1_is_identified_by zac:BO0624_44631_lot_40_id ;
