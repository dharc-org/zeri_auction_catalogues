zac:65735_lot_92 a la:Set ;
    rdfs:label "MAiTRE ANONYME IRE MOITIE DU xVI# SIECLE.-Enee et Didon. Enee fugitif aborde a Carthage oi ilest recu par la reine Didon." ;
    crm:P102_has_title zac:65735_lot_92_title ;
    crm:P138i_has_representation <https://historica.unibo.it/iiif-server/4eb1f63a-01fd-4e2e-8dd9-0b0e032cd11a/full/full/0/default.jpg> ;
