zac:83730_lot_49_description a crm:E33_Linguistic_Object ;
    rdfs:label """- 49 — Suite de huit compositions pour illustrer les ( Contes de La Fontaine (1762) ）:\r
\r
Les Oies du Frere Philippe,\r
\r
A Femme avare, Galant escroc,\r
\r
Le Calendrier des Vieillards,\r
\r
On ne s'avise jamais du tout,\r
\r
Le Contrat,\r
\r
Le Faucon,\r
\r
Le Berceau (inedit),\r
\r
Le Tableau.\r
\r
Dessins a la mine de plomb.\r
\r
## LE PRINCE, J.-B.""" ;
